@page "/cash-register"
@using AppleShopikCRM.Client.Helpers
@using AppleShopikCRM.Client.Models
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Web
@rendermode InteractiveWebAssembly
@inject HttpClient Http
@rendermode InteractiveWebAssembly

<PageTitle>Каса та Фінанси</PageTitle>

<div class="container-fluid">
    @* ШАПКА *@
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div class="d-flex align-items-center gap-3">
            <h2 class="fw-bold m-0"><i class="bi bi-wallet2 me-2"></i>Каса</h2>
            <select class="form-select fw-bold border-primary" style="width: 200px;" @bind="currentStoreId" @after="LoadData">
                        @foreach (var s in stores)
                        {
                    <option value="@s.Id">📍 @s.Name</option>
                        }
                    </select>
                    <i class="bi bi-chevron-down" style="font-size:10px;"></i>
                </div>
        <button class="btn btn-danger shadow-sm" @onclick="() => showWithdrawModal = true">
            <i class="bi bi-dash-circle me-2"></i>Витрата / Інкасація
        </button>
                </div>

    @* КАРТКИ БАЛАНСУ *@
    <div class="row g-4 mb-5">
        @* 1. Готівка UAH *@
        <div class="col-md-3">
            <div class="card shadow-sm border-0 bg-success text-white h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between">
                        <span>🇺🇦 Готівка UAH</span>
                        <i class="bi bi-cash-stack fs-4"></i>
        </div>
                    <h2 class="fw-bold mt-2">@storeBalance.BalanceUAH.ToString("N0") ₴</h2>
                    <small class="opacity-75">За сьогодні: +@currentShift.IncomeUAH / -@currentShift.ExpenseUAH</small>
                </div>
            </div>
        </div>

        @* 2. Валюта USD *@
        <div class="col-md-3">
            <div class="card shadow-sm border-0 bg-dark text-white h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between">
                        <span>🇺🇸 Готівка USD</span>
                        <i class="bi bi-currency-dollar fs-4"></i>
    </div>
                    <h2 class="fw-bold mt-2">$@storeBalance.BalanceUSD.ToString("N0")</h2>
                    <small class="opacity-75">За сьогодні: +@currentShift.IncomeUSD / -@currentShift.ExpenseUSD</small>
                </div>
            </div>
        </div>

        @* 3. Валюта EUR *@
        <div class="col-md-3">
            <div class="card shadow-sm border-0 bg-primary text-white h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between">
                        <span>🇪🇺 Готівка EUR</span>
                        <i class="bi bi-currency-euro fs-4"></i>
        </div>
                    <h2 class="fw-bold mt-2">€@storeBalance.BalanceEUR.ToString("N0")</h2>
                    <small class="opacity-75">За сьогодні: +@currentShift.IncomeEUR / -@currentShift.ExpenseEUR</small>
                </div>
            </div>
        </div>

        @* 4. Термінал (Card) *@
        <div class="col-md-3">
            <div class="card shadow-sm border-0 bg-light text-dark h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between">
                        <span class="text-muted">💳 Термінал / Карта</span>
                        <i class="bi bi-credit-card fs-4"></i>
        </div>
                    <h2 class="fw-bold mt-2">@storeBalance.BalanceCard.ToString("N0") ₴</h2>
                    <small class="text-muted">За сьогодні: +@currentShift.IncomeCard</small>
        </div>
        <div class="fin-card bank">
            <div class="fin-header"><span>💳 Термінал / Карта</span><i class="bi bi-credit-card fs-5"></i></div>
            <div class="fin-amount">@storeBalance.BalanceCard.ToString("N0") ₴</div>
            <div class="fin-subtext">Сьогодні: +@currentShift.IncomeCard.ToString("N0")</div>
        </div>
    </div>

    @* ФІЛЬТР *@
    <div class="filter-bar">
        <span style="font-size: 13px; font-weight: 600; color: var(--apple-sub);">Період історії:</span>
        <input type="date" class="date-input" @bind="fromDate" />
        <span class="text-muted">—</span>
        <input type="date" class="date-input" @bind="toDate" />

        <button class="btn-apple primary" @onclick="LoadData">Пошук</button>
        <button class="btn-apple outline" @onclick="ResetFilter">Сьогодні</button>
    </div>

    @* ІСТОРІЯ ТРАНЗАКЦІЙ *@
    <div class="card shadow-sm border-0">
        <div class="card-header bg-white fw-bold py-3">🕒 Останні операції</div>
        <div class="table-responsive">
            <table class="table table-hover mb-0 align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Час</th>
                        <th>Тип</th>
                        <th>Сума</th>
                        <th>Категорія</th>
                        <th>Коментар</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var t in history)
                    {
                        <tr>
                            <td>@t.Date.ToString("HH:mm") <small class="text-muted">@t.Date.ToString("dd.MM")</small></td>
                            <td>
                                @if (t.Type == "Income")
                                {
                                    <span class="badge bg-success-subtle text-success"><i class="bi bi-arrow-down"></i> Прихід</span>
                                }
                                else
                                {

                                    <span class="badge bg-danger-subtle text-danger"><i class="bi bi-arrow-up"></i> Витрата</span>
                                }
                            </td>
                            <td class="fw-bold">
                                @if (t.Currency == "USD")
                                {
                                    <span>$@t.Amount</span>
                                }
                                else if (t.Currency == "EUR")
                    {

                                    <span>€@t.Amount</span>
                    }
                    else
                    {

                                    <span>@t.Amount грн</span>
                                }
                            </td>
                            <td>
                                @if (t.Category == "Sale")
                                {
                                    <span>Продаж товару</span>
                                }
                                else if (t.Category == "Withdrawal")
                        {

                                    <span>Інкасація / Витрата</span>
                                }
                                </td>
                            <td class="text-muted small">@t.Comment</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@* МОДАЛКА ВИТРАТИ *@
@if (showWithdrawModal)
{
    <div class="modal fade show d-block" style="background: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header bg-danger text-white">
                    <h5 class="modal-title">💸 Видача грошей</h5>
                    <button class="btn-close btn-close-white" @onclick="() => showWithdrawModal = false"></button>
                        </div>
                <div class="modal-body">
                    <label>Валюта</label>
                    <select @bind="withdrawCurrency" class="form-select mb-3">
                                    <option value="UAH">Гривня (UAH)</option>
                                    <option value="USD">Долар (USD)</option>
                                    <option value="EUR">Євро (EUR)</option>
                                </select>
                                <input type="number" @bind="exchFromAmt" class="apple-input" placeholder="Скільки взяли?" style="color:var(--apple-red); font-weight:700;" />
                            </div>

                            <div style="background: #fff; padding: 10px; border-radius: 8px; border: 1px solid var(--apple-border);">
                                <label class="apple-label text-success" style="margin-top:0;">Отримуємо в касу</label>
                                <select @bind="exchToCur" class="apple-input mb-2" style="border: none; padding: 4px; font-weight: 600;">
                                    <option value="USD">Долар (USD)</option>
                                    <option value="UAH">Гривня (UAH)</option>
                                    <option value="EUR">Євро (EUR)</option>
                                </select>
                                <input type="number" @bind="exchToAmt" class="apple-input" placeholder="Скільки отримали?" style="color:var(--apple-green); font-weight:700;" />
                            </div>
                        </div>

                        <input type="text" @bind="exchComment" class="apple-input mb-3" placeholder="Коментар (напр. Курс 42.1)" />

                        <button class="btn-apple primary w-100" @onclick="SubmitExchange" disabled="@(exchFromAmt <= 0 || exchToAmt <= 0)" style="justify-content: center;">
                            <i class="bi bi-arrow-left-right"></i> Провести обмін
                        </button>
                    </div>
                }
                @if (opTab == "transfer")
                {
                    @* 🔥 СПИСОК ВХІДНИХ ПЕРЕМІЩЕНЬ (ЧЕКАЮТЬ НА ПРИЙОМ) *@
                    @if (incomingTransfers.Any())
                    {
                        <h6 style="font-weight: 700; margin-bottom: 12px; display: flex; align-items: center; gap: 8px;">
                            <i class="bi bi-box-arrow-in-down-right text-success"></i> Вхідні переміщення (до вас):
                        </h6>
                        <div style="display: flex; flex-direction: column; gap: 10px; margin-bottom: 20px;">
                            @foreach (var inc in incomingTransfers)
                            {
                                <div style="border: 1.5px solid rgba(52,199,89,.3); background: rgba(52,199,89,.05); border-radius: 12px; padding: 14px;">
                                    <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 6px;">
                                        <div>
                                            <div style="font-size: 1.2rem; font-weight: 700; color: var(--apple-text);">+@inc.Amount.ToString("N0") @inc.Currency</div>
                                            <div style="font-size: 13px; color: var(--apple-sub);">Від: <strong>@inc.SourceStoreName</strong> (@inc.CreatedBy)</div>
                                            <div style="font-size: 12px; color: var(--apple-sub); margin-top: 4px;">@inc.Comment</div>
                                        </div>
                                    </div>
                                    <div style="display: flex; gap: 8px; margin-top: 12px;">
                                        <button class="btn-apple success" style="flex: 1; justify-content: center;" @onclick="() => ConfirmIncomingTransfer(inc.Id)">
                                            <i class="bi bi-check-lg"></i> Підтвердити (Сума вірна)
                                        </button>
                                        <button class="btn-apple danger" style="padding: 8px 12px;" @onclick="() => RejectIncomingTransfer(inc.Id)" title="Відхилити (Не сходиться)">
                                            <i class="bi bi-x-lg"></i>
                                        </button>
                                    </div>
                                </div>
                            }
                        </div>
                    }

                    <label>Сума</label>
                    <input type="number" @bind="withdrawAmount" class="form-control mb-3" />

                    <label>Коментар (на що?)</label>
                    <input type="text" @bind="withdrawComment" class="form-control mb-3" placeholder="Інкасація, кава, оренда..." />
                        </div>
                <div class="modal-footer">
                    <button class="btn btn-light" @onclick="() => showWithdrawModal = false">Скасувати</button>
                    <button class="btn btn-danger" @onclick="SubmitWithdraw">Підтвердити</button>
                    </div>
                }

                @if (!string.IsNullOrEmpty(withdrawError))
                {
                    <div style="color: var(--apple-red); font-size: 13px; font-weight: 600; text-align: center; margin-top: 12px;"><i class="bi bi-exclamation-triangle-fill me-1"></i> @withdrawError</div>
                }
                @if (!string.IsNullOrEmpty(withdrawSuccess))
                {
                    <div style="color: var(--apple-green); font-size: 13px; font-weight: 600; text-align: center; margin-top: 12px;"><i class="bi bi-check-circle-fill me-1"></i> @withdrawSuccess</div>
                }
            </div>
        </div>
    </div>
}

@code {
    private int currentStoreId = 1;
    private List<Store> stores = new();

    // Дані
    private Store storeBalance = new();
    private CashShift currentShift = new();
    private List<CashTransaction> history = new();
    private List<IncomingTransferDto> incomingTransfers = new();
    private DateTime fromDate = DateTime.Today;
    private DateTime toDate = DateTime.Today;

    // Модалка
    private bool showWithdrawModal = false;
    private string currentUserName = "Невідомий";

    // Змінні для вкладок
    private string opTab = "withdraw"; // withdraw, exchange, transfer

    // Змінні для Видачі
    private string withdrawCurrency = "UAH";
    private decimal withdrawAmount = 0;
    private string withdrawComment = "";

    // Клас для відповіді API
    class CashStatusResponse
    {
        public Store Store { get; set; }
        public CashShift Shift { get; set; }
        public List<CashTransaction> History { get; set; }
    }

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        isAdmin = user.IsInRole("Admin");
        currentUserName = user.FindFirst(ClaimTypes.UserData)?.Value ?? user.Identity?.Name ?? "Менеджер";
        var storeClaim = user.FindFirst("StoreId");
        if (storeClaim != null && int.TryParse(storeClaim.Value, out int sId)) currentStoreId = sId;

        stores = await Http.GetFromJsonAsync<List<Store>>("api/transfers/stores") ?? new();
        if (isAdmin && currentStoreId == 0 && stores.Any()) currentStoreId = stores.First().Id;

        await LoadData();
    }

    private async Task OnStoreChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int id))
        {
            currentStoreId = id;
            await LoadData();
        }
    }

    private async Task LoadData()
    {
        var result = await Http.GetFromJsonAsync<CashStatusResponse>($"api/cash/status/{currentStoreId}");
            if (result != null)
            {
                storeBalance = result.Store;
                currentShift = result.Shift;
                history = result.History;
            }
        }
        catch { }
    }

    private async Task ResetFilter()
    {
        fromDate = DateTime.Today; toDate = DateTime.Today; await LoadData();
    }

    private async Task OpenWithdrawModal()
    {
        withdrawError = withdrawSuccess = "";
        opTab = "withdraw";
        withdrawAmount = exchFromAmt = exchToAmt = transAmt = 0;
        await LoadPendingRequests();
        await LoadIncomingTransfers();
        showWithdrawModal = true;
    }
    private async Task LoadIncomingTransfers()
    {
        try { incomingTransfers = await Http.GetFromJsonAsync<List<IncomingTransferDto>>($"api/cash/pending-transfers/{currentStoreId}") ?? new(); } catch { }
    }

    private async Task SubmitTransfer()
    {
        withdrawError = withdrawSuccess = "";
        string finalComment = string.IsNullOrWhiteSpace(transComment) ? $"({currentUserName})" : $"{transComment} ({currentUserName})";
        var request = new { SourceStoreId = currentStoreId, TargetStoreId = transTargetStore, Amount = transAmt, Currency = transCur, Comment = finalComment };
        var res = await Http.PostAsJsonAsync("api/cash/transfer", request);

        if (res.IsSuccessStatusCode) { withdrawSuccess = "Гроші успішно відправлено! Очікуйте підтвердження іншим магазином."; transAmt = 0; await LoadData(); }
        else { withdrawError = await res.Content.ReadAsStringAsync(); }
    }

    private async Task ConfirmIncomingTransfer(int id)
    {
        withdrawError = withdrawSuccess = "";
        var res = await Http.PostAsync($"api/cash/confirm-transfer/{id}", null);
        if (res.IsSuccessStatusCode) { withdrawSuccess = "Гроші успішно зараховано в касу!"; await LoadIncomingTransfers(); await LoadData(); MenuNotifier.Trigger(); }
        else { withdrawError = await res.Content.ReadAsStringAsync(); }
    }

    private async Task RejectIncomingTransfer(int id)
    {
        bool confirm = await JS.InvokeAsync<bool>("confirm", "Ви впевнені, що хочете відхилити це переміщення? Сума повернеться відправнику.");
        if (!confirm) return;

        withdrawError = withdrawSuccess = "";
        var res = await Http.PostAsync($"api/cash/reject-transfer/{id}", null);
        if (res.IsSuccessStatusCode) { withdrawSuccess = "Переміщення відхилено. Гроші повернуто."; await LoadIncomingTransfers(); await LoadData(); MenuNotifier.Trigger(); }
        else { withdrawError = await res.Content.ReadAsStringAsync(); }
    }

    private void CloseWithdrawModal() => showWithdrawModal = false;

    private async Task LoadPendingRequests()
    {
        try { pendingRequests = await Http.GetFromJsonAsync<List<PendingWithdrawalDto>>($"api/cash/pending/{currentStoreId}") ?? new(); } catch { }
    }

    // --- ЛОГІКА ВИДАЧІ ---
    private async Task SubmitWithdraw()
    {
        var transaction = new CashTransaction
        {
            StoreId = currentStoreId,
            Amount = withdrawAmount,
            Currency = withdrawCurrency,
            Comment = withdrawComment,
            Type = "Expense"
        };

        var res = await Http.PostAsJsonAsync("api/cash/withdraw", transaction);
        if (res.IsSuccessStatusCode)
        {
            await LoadData();
            showWithdrawModal = false;
            withdrawAmount = 0;
            withdrawComment = "";
    }

    class CashStatusResponse
    {
        public Store Store { get; set; } = new();
        public CashShift Shift { get; set; } = new();
        public List<CashTransaction> History { get; set; } = new();
    }
}