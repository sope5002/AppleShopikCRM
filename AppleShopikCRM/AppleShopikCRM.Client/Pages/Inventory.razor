            <div class="ms-footer">
                <button class="btn-apple outline" @onclick="() => showMiniSupplierModal = false">Скасування</button>
                <button class="btn-apple primary" @onclick="SaveMiniSupplier" disabled="@string.IsNullOrWhiteSpace(miniSupName)">
                    <i class="bi bi-check-lg me-1"></i>Зберегти
                </button>
            </div>
        </div>
