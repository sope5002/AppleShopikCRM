@page "/inventory"
@using AppleShopikCRM.Client.Models
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@inject HttpClient Http
@inject AuthenticationStateProvider AuthStateProvider
@rendermode InteractiveWebAssembly

<PageTitle>Склад AppleShopik</PageTitle>

<div class="container-fluid p-0">
    @* --- ШАПКА: ВИБІР МАГАЗИНУ І РОЛІ --- *@
    <div class="d-flex justify-content-between align-items-center mb-4 bg-light p-3 rounded shadow-sm">
        <div class="d-flex align-items-center gap-3">
            <h2 class="fw-bold m-0"><i class="bi bi-shop me-2"></i>Склад</h2>

            @* ЛОГІКА ВІДОБРАЖЕННЯ МАГАЗИНУ *@
            @if (isAdmin)
            {
                @* АДМІН: Може перемикати магазини *@
                <select class="form-select form-select-sm fw-bold border-primary shadow-sm"
                        style="width: 200px;"
                        @bind="currentStoreId"
                        @after="LoadTabData">
                        @foreach (var s in stores)
                        {
                        <option value="@s.Id">📍 @s.Name</option>
                        }
                    </select>
                    <i class="bi bi-chevron-down" style="font-size:10px;"></i>
                </div>
                <span class="tag" style="background:#1d1d1f;color:#fff;border:none;">Адмін</span>
            }
            else
            {
                @* ПРОДАВЕЦЬ: Бачить тільки свій магазин *@
                <div class="badge bg-white text-dark border fs-6 px-3 py-2">
                    📍 @(stores.FirstOrDefault(s => s.Id == currentStoreId)?.Name ?? "Мій магазин")
                </div>
            }
        </div>
    </div>

        @* ІНФОРМАЦІЯ ПРО КОРИСТУВАЧА *@
        <div class="d-flex align-items-center gap-2">
            <span class="badge @(isAdmin ? "bg-dark" : "bg-success")">
                @(isAdmin ? "Admin View" : "Manager View")
            </span>
    </div>
    </div>

    @* --- ВКЛАДКИ --- *@
    <ul class="nav nav-tabs nav-fill mb-4 fw-bold">
        <li class="nav-item"><a class="nav-link @(activeTab == "devices" ? "active text-primary" : "text-muted")" style="cursor: pointer" @onclick='() => SetTab("devices")'>📱 Пристрої</a></li>
        <li class="nav-item"><a class="nav-link @(activeTab == "accessories" ? "active text-success" : "text-muted")" style="cursor: pointer" @onclick='() => SetTab("accessories")'>🎧 Аксесуари</a></li>
        <li class="nav-item">
            <a class="nav-link @(activeTab == "transfers" ? "active text-warning" : "text-muted")" style="cursor: pointer" @onclick='() => SetTab("transfers")'>
                🚚 Переміщення
                @if (IncomingCount > 0)
                {
                    <span class="badge bg-danger rounded-pill ms-1">@IncomingCount</span>
                }
            </a>
        </li>
    </ul>

    @* ============================================== *@
    @* ВМІСТ: ПРИСТРОЇ (Devices)                      *@
    @* ============================================== *@
            @if (activeTab == "devices")
            {
        // Фільтруємо пристрої тільки поточного магазину
        var myDevices = devices?.Where(d => d.StoreId == currentStoreId).ToList() ?? new();

        @* 1. ФІНАНСИ (Тільки Адмін) *@
    @if (isAdmin)
    {
            var invested = myDevices.Sum(d => d.PurchasePrice);
            var expected = myDevices.Sum(d => d.SellingPrice);

            <div class="row mb-4">
                <div class="col-md-6">
                    <div class="card bg-primary text-white shadow-sm border-0">
                        <div class="card-body">
                            <small class="opacity-75">Вкладено (Цей магазин)</small>
                            <h3 class="fw-bold">@invested.ToString("N0") грн</h3>
                    </div>
                </div>
            </div>
                <div class="col-md-6">
                    <div class="card bg-success text-white shadow-sm border-0">
                        <div class="card-body">
                            <small class="opacity-75">Потенційний прибуток</small>
                            <h3 class="fw-bold">@((expected - invested).ToString("N0")) грн</h3>
                </div>
                <div class="fin-box-mini green">
                    <div class="fin-label">Потенційний прибуток</div>
                    <div class="fin-val">@potentialProfitAccUAH.ToString("N0") <small>грн</small></div>
                </div>
            </div>
            </div>
        }
    }

        @* 2. ТАБЛИЦЯ *@
        <div class="d-flex justify-content-end mb-3">
            <button class="btn btn-primary shadow-sm" @onclick="OpenDeviceModal"><i class="bi bi-plus-lg me-2"></i>Додати пристрій</button>
        </div>

        if (devices == null)
    {

            <div class="text-center py-5"><div class="spinner-border text-primary"></div></div>
            }
        else if (!myDevices.Any())
            {

            <div class="alert alert-info text-center">Склад порожній у цьому магазині.</div>
            }
            else
            {
            <div class="card shadow-sm border-0">
                <table class="table table-hover mb-0 align-middle">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">Модель</th>
                            <th>IMEI / SN</th>
                            <th>Стан / АКБ</th>
                            <th>Ціна продажу</th>
                                @if (isAdmin)
                                {
                                <th>Закупка</th>
                                        }
                            <th class="text-end pe-4">Дії</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var dev in myDevices)
                    {
                            <tr>
                                <td class="ps-4 fw-bold">@dev.ModelName <div class="small text-muted">@dev.Color, @dev.Capacity</div></td>
                                <td><span class="font-monospace bg-light px-2 rounded border">@dev.Identifier</span></td>
                                <td>
                                    <span class="badge @(dev.ConditionStatus == "New" ? "bg-success" : "bg-warning text-dark")">@dev.ConditionStatus</span>
                                    <small class="ms-1 text-muted">🔋 @dev.BatteryHealth%</small>
                                </td>
                                <td class="text-success fw-bold">$@dev.SellingPrice</td>
                                    @if (isAdmin)
                                    {
                                    <td class="text-muted">$@dev.PurchasePrice</td>
                                            }
                                <td class="text-end pe-4">
                                    <button class="btn btn-sm btn-outline-warning" title="Перемістити на інший магазин"
                                            @onclick="() => OpenTransferModal(dev)">
                                        <i class="bi bi-arrow-right-circle-fill me-1"></i>Move
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
                </div>
            }
        }

    @* ============================================== *@
    @* ВМІСТ: АКСЕСУАРИ (Accessories)                 *@
    @* ============================================== *@
        @if (activeTab == "accessories")
        {
        var myAccs = accessoriesList?.Where(a => a.StoreId == currentStoreId).ToList() ?? new();

        @* 1. ФІНАНСИ (Тільки Адмін) *@
                                    @if (isAdmin)
                                    {
            var invested = myAccs.Sum(a => a.Quantity * a.PurchasePrice);
            var expected = myAccs.Sum(a => a.Quantity * a.SellingPrice);

            <div class="row mb-4">
                <div class="col-md-6">
                    <div class="card bg-dark text-white shadow-sm border-0">
                        <div class="card-body">
                            <small class="opacity-75">Вкладено (Аксесуари)</small>
                            <h3 class="fw-bold">@invested.ToString("N0") грн</h3>
                                </div>
                            </div>
                            <div class="prod-action">
                                <div class="prod-price">@item.SellingPrice.ToString("N0") <span style="font-size:11px;font-weight:400;">грн</span></div>
                                @if (isAdmin)
                                {
                                    <div class="prod-cost">закуп @item.PurchasePrice.ToString("N0") грн</div>
                                }
                            </div>
                <div class="col-md-6">
                    <div class="card bg-info text-white shadow-sm border-0">
                        <div class="card-body">
                            <small class="opacity-75">Потенційний прибуток</small>
                            <h3 class="fw-bold">@((expected - invested).ToString("N0")) грн</h3>
                            </div>
                        </div>
                    </Virtualize>
                </div>
            }
        }

        @if (activeTab == "transfers")
        {
            <div style="display:grid; grid-template-columns: 1fr 1fr; gap: 20px;">
                @* ⬇️ ВХІДНІ *@
                <div class="apple-card" style="border-top: 4px solid var(--apple-orange); padding: 20px;">
                    <h4 style="font-size:16px;font-weight:700;margin-top:0;display:flex;justify-content:space-between;">
                        <span>⬇️ Очікують підтвердження</span>
                        <span class="tag yellow">@incomingTransfers.Count()</span>
                    </h4>
                    <hr style="border-color:var(--apple-border);margin:12px -20px 16px;" />

                    @if (!incomingTransfers.Any())
                    {
                        <div class="text-muted text-center py-4" style="font-size: 13px;">Немає нових надходжень.</div>
                    }
                    else
                    {
                        <div style="display:flex; flex-direction:column; gap:12px;">
                            @foreach (var t in incomingTransfers)
                            {
                                <div style="padding:14px; background:var(--apple-gray); border-radius:12px; border:1px solid var(--apple-border);">
                                    <div style="display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:6px;">
                                        <div style="font-weight:700;font-size:15px;color:var(--apple-text);">
                                            @($"{t.ModelName} {t.Capacity} {t.Color}".Trim())
                                        </div>
                                        <div style="font-size:11px;color:var(--apple-sub); text-align:right;">
                                            Від: <br /><strong>@t.FromStoreName</strong>
                                        </div>
                                    </div>

                                    <div style="display:flex; flex-wrap:wrap; gap:6px; margin-bottom:12px;">
                                        @if (!string.IsNullOrEmpty(t.Identifier))
                                        {
                                            <span class="tag" style="font-family:monospace;"><i class="bi bi-upc-scan"></i> @t.Identifier</span>
                                        }
                                        @if (!string.IsNullOrEmpty(t.ConditionStatus))
                                        {
                                            <span class="tag @(t.ConditionStatus == "New" ? "green" : "yellow")">@t.ConditionStatus</span>
                                        }
                                        @if (t.BatteryHealth > 0)
                                        {
                                            <span class="tag @(t.BatteryHealth < 80 ? "red" : "green")">🔋 @t.BatteryHealth%</span>
                                        }
                                        <span class="tag blue">К-сть: @t.Quantity шт.</span>
                                    </div>

        @* 2. ТАБЛИЦЯ *@
        <div class="d-flex justify-content-end mb-3 gap-2">
            @* Нова кнопка *@
            <button class="btn btn-outline-success shadow-sm" @onclick="() => showNewProductModal = true">
                <i class="bi bi-plus-circle me-2"></i>Створити товар
                                        </button>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>

            @* Стара кнопка *@
            <button class="btn btn-success shadow-sm" @onclick="OpenRestockModal">
                <i class="bi bi-box-seam-fill me-2"></i>Поповнити склад
                                        </button>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        }

        if (accessoriesList == null)
        {
            <div class="apple-card p-0">
                @if (restockHistory == null || !restockHistory.Any())
                {
                    <div class="text-center py-5 text-muted">Історія поповнень порожня</div>
                }
                else
                {
                    <table class="apple-table">
                        <thead>
                            <tr>
                                <th>Дата</th>
                                <th>Товар</th>
                                <th>Кількість</th>
                                <th>Менеджер</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var h in restockHistory)
                            {
                                <tr>
                                    <td style="color:var(--apple-sub);">@h.Date.ToString("dd.MM.yyyy HH:mm")</td>
                                    <td style="font-weight:600;">@h.ProductName</td>
                                    <td><span class="tag green">+@h.AddedQuantity шт.</span></td>
                                    <td>@h.ManagerName</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        }
    }
</div>

            <div class="text-center py-5"><div class="spinner-border text-success"></div></div>
                }
        else if (!myAccs.Any())
                {
                    <div style="background: rgba(255,59,48,.1); border-radius: 12px; padding: 16px; color: var(--apple-red); font-weight: 600;">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i> @syncError
                    </div>
                }
                else if (syncResult != null)
                {
                    @if (syncResult.IsPerfectMatch)
                    {
                        <div class="text-center py-4">
                            <i class="bi bi-check-circle-fill" style="font-size: 4rem; color: var(--apple-green);"></i>
                            <h4 class="mt-3" style="font-weight: 700;">Ідеально!</h4>
                            <p class="text-muted">База CRM повністю співпадає з Google Таблицею.</p>
                        </div>
                    }
                    else
                    {
                        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px;">
                            <div style="background: rgba(255,59,48,.05); border: 1px solid rgba(255,59,48,.2); border-radius: 12px; padding: 16px;">
                                <h6 style="color: var(--apple-red); font-weight: 700; margin-bottom: 12px;"><i class="bi bi-x-circle-fill me-1"></i> Є в CRM, але немає в Таблиці (@syncResult.MissingInSheet.Count)</h6>
                                <div style="max-height: 400px; overflow-y: auto; padding-right: 5px;">
                                    @foreach (var item in syncResult.MissingInSheet)
                                    {
                                        <div style="background: #fff; padding: 10px; border-radius: 8px; margin-bottom: 8px; border: 1px solid var(--apple-border);">
                                            <div style="font-weight: 600; font-size: 13px;">@item.ModelName</div>
                                            <div style="font-family: monospace; color: var(--apple-sub); font-size: 12px; margin-top: 4px;">@item.Imei</div>
                                            @if (item.IsInRepair)
                                            {
                                                <span class="tag" style="background: rgba(255,149,0,.1); color: #ff9500; font-size: 10px; padding: 2px 6px; margin-top: 4px;">На ремонті</span>
                                            }
                                        </div>
                                    }
                                </div>
                            </div>
                            <div style="background: rgba(255,149,0,.05); border: 1px solid rgba(255,149,0,.2); border-radius: 12px; padding: 16px;">
                                <h6 style="color: #d97706; font-weight: 700; margin-bottom: 12px;"><i class="bi bi-exclamation-circle-fill me-1"></i> Є в Таблиці, але немає в CRM (@syncResult.ExtraInSheet.Count)</h6>
                                <div style="max-height: 400px; overflow-y: auto; padding-right: 5px;">
                                    @foreach (var item in syncResult.ExtraInSheet)
                                    {
                                        <div style="background: #fff; padding: 10px; border-radius: 8px; margin-bottom: 8px; border: 1px solid var(--apple-border);">
                                            <div style="font-weight: 600; font-size: 13px;">@item.ModelName</div>
                                            <div style="font-family: monospace; color: var(--apple-sub); font-size: 12px; margin-top: 4px;">@item.Imei</div>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                }
            </div>
            <div class="ms-footer">
                <button class="btn-apple outline" @onclick="() => showSyncModal = false">Закрити</button>
            </div>
        </div>
    </div>
}

            <div class="alert alert-info text-center">Аксесуарів немає в цьому магазині.</div>
                }
                else if (!googleSheetRows.Any())
                {
                    <div class="alert alert-warning">
                        Не вдалося завантажити дані з таблиці. Перевірте налаштування посилання (CSV).
                    </div>
                }
                else
                {
            <div class="card shadow-sm border-0">
                <table class="table table-hover mb-0 align-middle">
                    <thead class="table-light">
                                    <tr>
                            <th class="ps-4">Назва товару</th>
                            <th>Ціна</th>
                            <th>Наявність</th>
                                        @if (isAdmin)
                                        {
                                <th>Закупка (шт)</th>
                                        }
                            <th class="text-end pe-4">Дії</th>
                                    </tr>
                                </thead>
                                <tbody>
                        @foreach (var item in myAccs)
                                    {
                                        <tr>
                                <td class="ps-4 fw-bold">@item.ModelName</td>
                                <td class="text-success fw-bold">@item.SellingPrice.ToString("N0") грн</td>
                                            <td>
                                    @if (item.Quantity > 0)
                                                    {
                                        <span class="badge bg-dark rounded-pill">@item.Quantity шт.</span>
                                                    }
                                    else
                                            {
                                                <td><input type="number" class="apple-input" style="padding: 4px 8px; font-weight: 700;" @bind="item.PurchasePrice" /></td>
                                            }
                                            <td><input type="number" class="apple-input" style="padding: 4px 8px; font-weight: 700; border-color: var(--apple-green);" @bind="item.SellingPrice" /></td>
                                            <td><button class="btn-remove-img" style="position: static;" @onclick="() => parsedItems.Remove(item)">✕</button></td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }

                                        <span class="badge bg-danger">Немає</span>
                                            }
                                        </td>
                                @if (isAdmin)
                                            {
                                    <td class="text-muted">@item.PurchasePrice.ToString("N0") грн</td>
                                            }
                                <td class="text-end pe-4">
                                    <button class="btn btn-sm btn-outline-warning"
                                            disabled="@(item.Quantity <= 0)"
                                            @onclick="() => OpenTransferAccModal(item)">
                                        <i class="bi bi-arrow-right-circle-fill me-1"></i>Move
                                    </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
            <div class="ms-footer">
                @if (parsedItems.Any())
                {
                    <button class="btn-apple success" @onclick="SaveParsedItems" disabled="@isSavingSmart">
                        @if (isSavingSmart)
                        {
                            <span class="spinner-border spinner-border-sm me-1"></span>
                        }
                        <i class="bi bi-cloud-arrow-up-fill me-1"></i> Зберегти @parsedItems.Count пристроїв в базу
                    </button>
                }
                <button class="btn-apple outline" @onclick='() => { showSmartPasteModal = false; targetRowNumber = null; parsedItems.Clear(); }'>Закрити</button>
            </div>
        </div>
    </div>
}

    @* ============================================== *@
    @* ВМІСТ: ПЕРЕМІЩЕННЯ (Transfers)                 *@
    @* ============================================== *@
    @if (activeTab == "transfers")
{
        <div class="row g-4">
            @* БЛОК 1: ВХІДНІ (Те, що їде ДО МЕНЕ) - Тут ми ПІДТВЕРДЖУЄМО *@
            <div class="col-md-6">
                <div class="card shadow border-warning h-100">
                    <div class="card-header bg-warning text-dark fw-bold d-flex justify-content-between align-items-center">
                        <span>⬇️ Вхідні (Потрібно підтвердити)</span>
                        <span class="badge bg-dark">@IncomingCount</span>
            </div>
                    <div class="card-body bg-light">
                        @if (!incomingTransfers.Any())
                {
                            <div class="text-muted text-center py-4">Немає нових надходжень.</div>
                }
                else
                {
                            <div class="list-group">
                                @foreach (var t in incomingTransfers)
                        {
                                    <div class="list-group-item border-0 shadow-sm mb-2 rounded">
                                        <div class="d-flex justify-content-between align-items-center mb-2">
                                            <h6 class="fw-bold m-0">@t.ModelName</h6>
                                            <small class="text-muted">Від: @t.FromStoreName</small>
                    </div>
                                        <div class="d-flex justify-content-between align-items-center">
                    <div>
                                                @if (!string.IsNullOrEmpty(t.Identifier))
                            {
                                                    <span class="badge bg-light text-dark border me-1">@t.Identifier</span>
                        }
                                                <span class="badge bg-info text-dark">Кількість: @t.Quantity</span>
                                            </div>
                                            <button class="btn btn-success btn-sm fw-bold" @onclick="() => ConfirmTransfer(t.Id)">
                                                <i class="bi bi-check-lg me-1"></i>Прийняти
                                            </button>
                                        </div>
                                    </div>
                        }
                    </div>
                        }
                    </div>
                    <div>
                        <label class="apple-label">АКБ %</label>
                        <input type="number" class="apple-input" @bind="newDevice.BatteryHealth" min="0" max="100" />
                    </div>
                </div>

            @* БЛОК 2: ВИХІДНІ (Те, що Я відправив) *@
            <div class="col-md-6">
                <div class="card shadow-sm h-100">
                    <div class="card-header bg-white fw-bold">⬆️ Мої відправлення (В дорозі)</div>
                    <div class="card-body">
                        @if (!outgoingTransfers.Any())
                    {
                            <div class="text-muted text-center py-4">Немає активних відправлень.</div>
                    }
                        else
                                {
                            <div class="list-group list-group-flush">
                                @foreach (var t in outgoingTransfers)
                            {
                                    <div class="list-group-item">
                                        <div class="d-flex justify-content-between align-items-center">
                                            <div>
                                                <strong>@t.ModelName</strong> <i class="bi bi-arrow-right mx-1 text-muted"></i> @t.ToStoreName
            </div>
                                            <span class="badge bg-warning text-dark">Очікує</span>
        </div>
    </div>
}

@* 1.1. РЕДАГУВАННЯ ПРИСТРОЮ *@
@if (showEditDeviceModal)
{
    <div class="modal-backdrop-apple" @onclick="() => showEditDeviceModal = false">
        <div class="modal-sheet" @onclick:stopPropagation>
            <div class="ms-header">
                <h3 class="ms-title"><i class="bi bi-pencil-square me-2" style="color:var(--apple-blue);"></i>Редагування</h3>
                <button class="ms-close" @onclick="() => showEditDeviceModal = false"><i class="bi bi-x"></i></button>
            </div>
            <div class="ms-body">
                <div style="padding: 12px; background: var(--apple-gray); border-radius: 8px; margin-bottom: 16px; font-weight: 600;">
                    @editDevice.ModelName @editDevice.Capacity @editDevice.Color
                </div>
                        }
                        </div>
                        <div>
                            <label class="apple-label">Пам'ять</label>
                            <input class="apple-input" @bind="editDevice.Capacity" />
                        </div>
                        <div>
                            <label class="apple-label">Стан корпусу</label>
                            <input class="apple-input" @bind="editDevice.ConditionStatus" />
                        </div>
