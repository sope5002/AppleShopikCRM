                        <div class="col">
                            <label>Колір</label>
                            <input @bind="newDevice.Color" class="form-control mb-2" />
                    </div>
                        <div class="col">
                            <label>Пам'ять</label>
                            <input @bind="newDevice.Capacity" class="form-control mb-2" />
                </div>
            </div>
                    <div class="row">
                        <div class="col">
                            <label>Стан</label>
                            <input @bind="newDevice.ConditionStatus" class="form-control mb-2" />
            </div>
                        <div class="col">
                            <label>Акумулятор</label>
                            <input @bind="newDevice.BatteryHealth" class="form-control mb-2" />
        </div>
    </div>

                    <label>Продаж ($)</label>
                    <input type="number" @bind="newDevice.SellingPrice" class="form-control mb-2" />

                    @if (isAdmin)
{
                        <label>Закупка ($)</label>
                        <input type="number" @bind="newDevice.PurchasePrice" class="form-control" />
                    }
            </div>
                <div class="modal-footer">
                    <button class="btn btn-primary" @onclick="SaveDevice">Зберегти</button>
