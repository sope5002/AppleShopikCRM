@page "/sales"
@using AppleShopikCRM.Client.Components
@using AppleShopikCRM.Client.Models
@using Microsoft.AspNetCore.Components.Authorization
@using System.Text.RegularExpressions
@rendermode InteractiveWebAssembly
@inject HttpClient Http
@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthStateProvider
@inject IJSRuntime JS

<PageTitle>Продаж</PageTitle>

<div class="container-fluid h-100 p-0">
    <div class="row h-100 g-0">

        @* --- ЛІВА ЧАСТИНА: КАТАЛОГ (СПИСОК) --- *@
        <div class="col-md-7 d-flex flex-column bg-light border-end">

            @* Шапка каталогу *@
            <div class="p-3 bg-white border-bottom shadow-sm z-1">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h4 class="fw-bold m-0"><i class="bi bi-grid-fill me-2 text-primary"></i>Каталог товарів</h4>

                    @* Вибір магазину *@
                    <select class="form-select form-select-sm w-auto fw-bold border-primary shadow-sm"
                            @bind="currentStoreId"
                            @after="LoadStock">
                            @foreach (var s in stores)
                            {
                            <option value="@s.Id">📍 @s.Name</option>
                            }
                        </select>
                    </div>
                }
                else
                {
                    <div class="store-badge">
                        <i class="bi bi-geo-alt-fill"></i> @(stores.FirstOrDefault(s => s.Id == currentStoreId)?.Name ?? "Мій магазин")
                    </div>
                }
            </div>

                @* Пошук *@
                <div class="input-group">
                    <span class="input-group-text bg-light border-end-0"><i class="bi bi-search text-muted"></i></span>
                    <input type="text" class="form-control border-start-0 ps-0"
                           placeholder="Пошук за назвою або IMEI..."
                           @bind="searchTerm"
                           @bind:event="oninput" />
            </div>

            <div class="seg-tabs">
                <button class='seg-tab @(activeTab == "devices" ? "active" : "")' @onclick='() => activeTab = "devices"'>
                    <i class="bi bi-phone me-1"></i>Пристрої <span class="seg-count">@filteredDevices.Count</span>
                </button>
                <button class='seg-tab @(activeTab == "accessories" ? "active" : "")' @onclick='() => activeTab = "accessories"'>
                    <i class="bi bi-bag me-1"></i>Аксесуари <span class="seg-count">@filteredAccessories.Count</span>
                </button>
                <button class='seg-tab @(activeTab == "services" ? "active" : "")' @onclick='() => activeTab = "services"'>
                    <i class="bi bi-stars me-1"></i>Послуги <span class="seg-count">@filteredServices.Count()</span>
                </button>
            </div>
        </div>

            @* Тіло каталогу (Таблиця) *@
            <div class="flex-grow-1 overflow-auto p-0">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light sticky-top">
                        <tr>
                            <th style="width: 60px;">Фото</th>
                            <th>Назва / Характеристики</th>
                            <th class="text-center">Ціна</th>
                            <th class="text-end pe-4">Дія</th>
                        </tr>
                    </thead>
                    <tbody>
                        @* 1. ПРИСТРОЇ *@
                        @foreach (var dev in availableDevices
                                                .Where(d => d.ModelName.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) || d.Identifier.Contains(searchTerm))
                                                .Take(20))
        {
                            <tr>
                                <td class="ps-3">
                                    @* Місце для ФОТО *@
                                    <div class="bg-white border rounded d-flex align-items-center justify-content-center text-muted" style="width: 45px; height: 45px;">
                                        <i class="bi bi-phone fs-4"></i>
                                </div>
                                </td>
                                <td>
                                    <div class="fw-bold text-dark">@dev.ModelName</div>
                                    <div class="small text-muted d-flex gap-2">
                                        <span class="badge bg-light text-dark border">@dev.Identifier</span>
                                        <span>@dev.Color</span>
                                        <span>@dev.Capacity</span>
                                        <span class="@(dev.BatteryHealth < 80 ? "text-danger" : "text-success")">🔋 @dev.BatteryHealth%</span>
                            </div>
                                </td>
                                <td class="text-center fw-bold text-primary fs-5">
                                    $@dev.SellingPrice
                                </td>
                                <td class="text-end pe-3">
                                    <button class="btn btn-sm btn-outline-primary rounded-pill px-3 fw-bold"
                                            @onclick="() => AddDeviceToCart(dev)">
                                        <i class="bi bi-plus-lg me-1"></i> Додати
                                </button>
                                </td>
                            </tr>
                }

                        @* 2. АКСЕСУАРИ *@
                        @foreach (var acc in availableAccessories
                                                .Where(a => a.ModelName.Contains(searchTerm, StringComparison.OrdinalIgnoreCase))
                                                .Take(20))
                {
                            <tr>
                                <td class="ps-3">
                                    @* Місце для ФОТО *@
                                    <div class="bg-white border rounded d-flex align-items-center justify-content-center text-muted" style="width: 45px; height: 45px;">
                                        <i class="bi bi-headphones fs-4"></i>
                            </div>
                                </td>
                                <td>
                                    <div class="fw-bold text-dark">@acc.ModelName</div>
                                    <div class="small text-muted">
                                        Аксесуар
                                    @if (isAdmin)
                                    {
                                            <span class="ms-2 text-danger fw-bold">(Зал: @acc.Quantity)</span>
                                    }
                                    else
                                    {
                                        <span class='stock-pill @(acc.Quantity > 0 ? "stock-ok" : "stock-out")'>@(acc.Quantity > 0 ? "В наявності" : "Немає")</span>
                                    }
                                </div>
                                </td>
                                <td class="text-center fw-bold text-dark fs-5">
                                    @acc.SellingPrice <small class="fs-6 text-muted fw-normal">грн</small>
                                </td>
                                <td class="text-end pe-3">
                                    <button class="btn btn-sm btn-outline-success rounded-pill px-3 fw-bold"
                                            @onclick="() => AddAccessoryToCart(acc)">
                                        <i class="bi bi-plus-lg me-1"></i> Додати
                                    </button>
                                </td>
                            </tr>
                                }
                    </tbody>
                </table>

                @if (!availableDevices.Any() && !availableAccessories.Any())
                                {
                    <div class="text-center py-5 text-muted">
                        <i class="bi bi-box-seam display-4"></i>
                        <p class="mt-2">Товарів не знайдено</p>
                            </div>
                        </div>
                    </Virtualize>
                }
                else if (activeTab == "services")
                {
                    <Virtualize TItem="Product" Items="filteredServices" Context="srv">
                        @{
                            int inCartQty = cart.FirstOrDefault(x => x.ProductId == srv.Id && x.Category == "PosService")?.Quantity ?? 0;
                        }
                        <div class="prod-card">
                            <div class="prod-thumb">
                                <i class="bi bi-stars prod-thumb-icon" style="color: var(--apple-blue);"></i>
                            </div>
                            <div class="prod-info">
                                <div class="prod-name">@srv.Name</div>
                                <div class="prod-tags">
                                    <span class="tag" style="color: var(--apple-blue); border-color: rgba(0,113,227,.2); background: rgba(0,113,227,.05);">Швидка послуга</span>
                                </div>
                            </div>
                            <div class="prod-action">
                                <div class="prod-price">@srv.SellingPrice.ToString("N0") <span style="font-size:11px;font-weight:400;">грн</span></div>
                                @if (inCartQty > 0)
                                {
                                    <div class="qty-stepper">
                                        <button class="qty-btn" @onclick="() => ChangeServiceQtyFromCatalog(srv, -1)">−</button>
                                        <span class="qty-val">@inCartQty</span>
                                        <button class="qty-btn" @onclick="() => ChangeServiceQtyFromCatalog(srv, 1)">+</button>
                                    </div>
                                }
                                else
                                {
                                    <button class="btn-add" @onclick="() => AddPosServiceToCart(srv)" style="background: #34c759;">Додати</button>
                                }
                            </div>
                        </div>
                    </Virtualize>
                }
            </div>
        }
    </div>

        @* --- ПРАВА ЧАСТИНА: КОШИК (Без змін логіки, тільки дрібні правки стилю) --- *@
        <div class="col-md-5 d-flex flex-column bg-white shadow-lg" style="height: 100vh;">
            <div class="p-3 bg-primary text-white shadow-sm">
                <h4 class="fw-bold m-0"><i class="bi bi-cart3 me-2"></i>Кошик</h4>
        </div>

            <div class="flex-grow-1 overflow-auto bg-light">
                @if (!cart.Any())
                {
                    <div class="d-flex flex-column align-items-center justify-content-center h-100 text-muted opacity-50">
                        <i class="bi bi-basket display-1 mb-3"></i>
                        <p class="fs-5">Кошик порожній</p>
                    </div>
                }
                else
                {
                    <ul class="list-group list-group-flush">
                    @foreach (var item in cart)
                    {
                            <li class="list-group-item p-3 border-bottom">
                                <div class="d-flex justify-content-between align-items-start">
                                    @* Назва і опис *@
                                    <div style="flex: 1;">
                                        <div class="fw-bold text-dark">@item.ModelName</div>
                                        <div class="small text-muted">
                                    @if (!string.IsNullOrEmpty(item.Identifier))
                                    {
                                                <span class="me-2 bg-light border px-1 rounded">@item.Identifier</span>
                                    }
                                    @item.Color @item.Capacity
                                </div>
                                @if (item.WarrantyPrice > 0)
                                {
                                            <div class="badge bg-info text-dark mt-1">
                                                <i class="bi bi-shield-check me-1"></i>@item.WarrantyInfo (+@item.WarrantyPrice)
                                            </div>
                                }
                            </div>
                            <div class="ci-right">
                                <div style="display:flex; align-items:center; justify-content:flex-end; gap:2px;">
                                    <input type="number" class="cart-price-input" @bind="item.Price" @bind:event="oninput" min="0" />
                                    <span style="font-size:12px; font-weight:600;">грн</span>
                                </div>

                                    @* Кількість і Ціна *@
                                    <div class="text-end ms-3">
                                        <div class="fs-5 fw-bold text-dark">@((item.Price * item.Quantity).ToString("N0")) <small>грн</small></div>

                                        <div class="d-flex align-items-center justify-content-end mt-2 gap-2">
                                            @if (item.Category == "Accessory")
                                {
                                                <div class="btn-group btn-group-sm">
                                                    <button class="btn btn-outline-secondary" @onclick="() => ChangeQty(item, -1)">-</button>
                                                    <button class="btn btn-light border px-2" disabled>@item.Quantity</button>
                                                    <button class="btn btn-outline-secondary" @onclick="() => ChangeQty(item, 1)">+</button>
                                    </div>
                                }
                                            <button class="btn btn-sm btn-link text-danger p-0 ms-2" @onclick="() => cart.Remove(item)">
                                                <i class="bi bi-trash"></i>
                                    </button>
                                }
                            </div>
                        </div>
                                </div>
                            </li>
                    }
                    </ul>
                }
            </div>

            @* НИЖНІЙ БЛОК: ПІДСУМОК *@
            <div class="p-3 bg-white border-top shadow-lg z-2">

                @* Trade-In *@
                <div class="mb-3">
                    @if (hasTradeIn)
                {
                        <div class="alert alert-primary d-flex justify-content-between align-items-center py-2 mb-0">
                        <div>
                                <strong><i class="bi bi-arrow-repeat me-1"></i>Trade-In:</strong> @activeTradeIn.Model
                                <div class="small">@activeTradeIn.Imei</div>
                            </div>
                            <div class="text-end">
                                <div class="fw-bold text-danger">-@activeTradeIn.Price.ToString("N0")</div>
                                <a href="#" class="small text-decoration-none" @onclick="RemoveTradeIn" @onclick:preventDefault>Скасувати</a>
                        </div>
                        <div style="text-align:right;">
                            <div style="font-size:14px;font-weight:700;color:var(--apple-red);">−@ti.Price.ToString("N0") грн</div>
                            <button @onclick="() => tradeIns.Remove(ti)" style="background:none;border:none;font-size:11px;color:var(--apple-sub);cursor:pointer;padding:0;">скасувати</button>
                        </div>
                    </div>
                }
                    else
                {
                        <button class="btn btn-outline-primary w-100 border-dashed py-2" @onclick="() => showTradeInModal = true">
                            <i class="bi bi-phone me-2"></i>Додати Trade-In
                    </button>
                }
            </div>

                @* Суми *@
                <div class="d-flex justify-content-between align-items-end mb-3">
                    <div class="text-muted small">
                        Сума товарів: @TotalCartAmount.ToString("N0") <br />
                        Знижка: @(hasTradeIn? activeTradeIn.Price: 0)
                </div>
                    <div class="text-end">
                        <div class="text-muted small">До сплати:</div>
                        <div class="fs-1 fw-bold text-success lh-1">@TotalToPay.ToString("N0") <span class="fs-5 text-muted">грн</span></div>
            </div>

            <div class="customer-section" style="padding-bottom: 5px; border-bottom: none; border-top:none;">
                <label class="apple-label" style="margin-top:0;">Звідки клієнт?</label>
                <div class="segment-control" style="margin-bottom: 10px;">
                    <button class="segment-btn @(checkoutSource == "Offline" ? "active" : "")" @onclick='() => checkoutSource = "Offline"'>🚶 Офлайн</button>
                    <button class="segment-btn @(checkoutSource == "Instagram" ? "active" : "")" @onclick='() => checkoutSource = "Instagram"' style="color: #E1306C;"><i class="bi bi-instagram"></i> Insta</button>
                    <button class="segment-btn @(checkoutSource == "Telegram" ? "active" : "")" @onclick='() => checkoutSource = "Telegram"' style="color: #0088cc;"><i class="bi bi-telegram"></i> Telegram</button>
                </div>
            </div>

                @* Кнопка оплати *@
                <button class="btn btn-success w-100 py-3 fw-bold fs-5 shadow-sm"
                        @onclick="OpenPaymentModal"
                        disabled="@(!cart.Any())">
                    <i class="bi bi-wallet2 me-2"></i> ПЕРЕЙТИ ДО ОПЛАТИ
                </button>
        </div>

        <div class="cart-footer">
            <div class="summary-row">
                <span>Товари (@cart.Sum(x => x.Quantity))</span>
                <span style="font-weight: 600; color: var(--apple-text);">@TotalCartAmount.ToString("N0") грн</span>
            </div>

            @if (tradeIns.Any())
            {
                <div class="summary-row" style="color:var(--apple-red);">
                    <span>Trade-In (x@(tradeIns.Count))</span>
                    <span style="font-weight: 600;">−@TotalTradeInAmount.ToString("N0") грн</span>
                </div>
            }

            <div class="summary-row" style="align-items:center; margin-top:4px;">
                <span style="font-weight:600; color:var(--apple-blue);">Знижка на чек:</span>
                <div style="display:flex; align-items:center;">
                    <span style="color:var(--apple-sub); margin-right:4px;">−</span>
                    <input type="number" class="apple-input" style="width:70px; padding:4px 6px; text-align:right; font-size:13px; height:26px; border-color:var(--apple-blue);" @bind="globalDiscount" @bind:event="oninput" min="0" />
                    <span style="margin-left:4px;">грн</span>
                </div>
            </div>

@* ========================================== *@
@* ВСІ МОДАЛКИ (БЕЗ ЗМІН ЛОГІКИ)         *@
@* ========================================== *@

            <button class="btn-checkout" @onclick="OpenPaymentModal" disabled="@(!cart.Any())">
                <i class="bi bi-wallet2 me-2"></i>Перейти до оплати
            </button>
        </div>
    </div>
</div>

@* ════════════════════════════════════════════════
   MODAL: PAYMENT 
════════════════════════════════════════════════ *@
@if (showPaymentModal)
{
    <div class="modal fade show d-block" style="background: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content shadow-lg">
                <div class="modal-header bg-success text-white">
                    <h5 class="modal-title"><i class="bi bi-wallet2 me-2"></i>Розрахунок</h5>
                    <button class="btn-close btn-close-white" @onclick="() => showPaymentModal = false"></button>
                    </div>
                <div class="modal-body bg-light">
                    <div class="text-center mb-4">
                        <small class="text-muted">Сума до сплати</small>
                        <h2 class="fw-bold text-dark">@TotalToPay.ToString("N0") грн</h2>
                </div>

                    <div class="card border-0 shadow-sm mb-3">
                        <div class="card-body p-3">
                @foreach (var part in paymentParts)
                {
                                <div class="row g-2 mb-3 align-items-end border-bottom pb-3">
                                    <div class="col-md-3">
                                        <label class="small text-muted">Валюта</label>
                                        <select class="form-select fw-bold" value="@part.Method" @onchange="(e) => OnCurrencyChange(part, e)">
                                @foreach (var m in paymentMethods)
                                {
                                    <option value="@m">@m</option>
                                }
                            </select>
                                    </div>
                                    <div class="col-md-3">
                                        <label class="small text-muted">Сума (@part.Method)</label>
                                        <input type="number" class="form-control fw-bold" @bind="part.Amount" @bind:event="oninput" />
                                    </div>
                            @if (part.Method == "USD" || part.Method == "EUR")
                            {
                                        <div class="col-md-2">
                                            <label class="small text-muted">Курс</label>
                                            <input type="number" class="form-control border-warning fw-bold" @bind="part.ExchangeRate" @bind:event="oninput" placeholder="0.00" />
                                        </div>
                                        <div class="col-md-3 d-flex align-items-center">
                                            <span class="text-muted small me-2">=</span>
                                            <span class="fw-bold text-success">@((part.Amount * part.ExchangeRate).ToString("N0")) грн</span>
                                        </div>
                            }
                            else
                            {
                                        <div class="col-md-5 d-flex align-items-center text-muted small">Курс 1.0</div>
                                    }
                                    <div class="col-md-1 text-end">
                                    @if (paymentParts.Count > 1)
                                    {
                                            <button class="btn btn-outline-danger btn-sm" @onclick="() => RemovePaymentLine(part)"><i class="bi bi-x-lg"></i></button>
                            }
                        </div>

                        @if (part.Method == "Оплата частинами")
                        {
                            <div style="display: flex; gap: 8px; background: rgba(0,113,227,0.05); padding: 10px; border-radius: 8px; align-items: center;">
                                <i class="bi bi-bank" style="color:var(--apple-blue); font-size: 16px;"></i>
                                <select class="apple-input" @bind="part.Bank" style="flex: 1; padding: 6px 10px;">
                                    <option value="">-- Оберіть Банк --</option>
                                    <option value="Monobank">Монобанк</option>
                                    <option value="PrivatBank">ПриватБанк</option>
                                    <option value="Pumb">ПУМБ</option>
                                </select>

                                <div style="display: flex; gap: 4px; align-items: center;">
                                    <button class="btn-apple @(part.Months == 3 ? "primary" : "outline")"
                                            style="padding: 4px 10px; font-size: 13px; height: 32px;"
                                            @onclick="() => part.Months = 3">
                                        3
                                    </button>

                                    <button class="btn-apple @(part.Months == 6 ? "primary" : "outline")"
                                            style="padding: 4px 10px; font-size: 13px; height: 32px;"
                                            @onclick="() => part.Months = 6">
                                        6
                                    </button>

                                    <input type="number" class="apple-input"
                                           @bind="part.Months" @bind:event="oninput"
                                           placeholder="Інше"
                                           style="width: 70px; padding: 4px 8px; text-align: center; height: 32px;"
                                           min="1" max="36" />
                                </div>

                                @if (isAdmin)
                                {
                                    <div style="min-width: 110px; text-align: right;">
                                        <div style="font-size:10px; color:var(--apple-sub); text-transform:uppercase; font-weight:700;">Комісія банку</div>
                                        <div style="font-size:14px; font-weight:700; color:var(--apple-red);">−@GetCommission(part).ToString("N0") грн</div>
                                    </div>
                                }
                            <button class="btn btn-link text-decoration-none btn-sm fw-bold" @onclick="AddPaymentLine">
                                <i class="bi bi-plus-circle me-1"></i> Додати інший спосіб
                            </button>
                            </div>
                        }
                    </div>
                }

                <button @onclick="AddPaymentLine" style="background:none;border:none;color:var(--apple-blue);font-size:13px;font-weight:600;cursor:pointer;padding:4px 0;"><i class="bi bi-plus-circle me-1"></i>Додати спосіб оплати</button>

                    <div class="d-flex justify-content-between px-3 py-2 bg-white rounded border">
                        <div class="fs-5">Внесено (грн): <strong>@TotalPaidInUAH.ToString("N0")</strong></div>
                        @if (Remaining > 0)
                        {
                            <div class="fs-5 text-danger fw-bold">Доплатити: @Remaining.ToString("N0") грн</div>
                        }
                        else if (Remaining < 0)
                        {
                            <div class="fs-4 text-primary fw-bold"><i class="bi bi-arrow-return-left me-2"></i>Решта: @Math.Abs(Remaining).ToString("N0") грн</div>
                            <small class="text-muted d-block text-end">(Спишеться з каси)</small>
                        }
                        else
                        {
                            <div class="fs-5 text-success fw-bold"><i class="bi bi-check-circle-fill"></i> Без решти</div>
                    }
                </div>

                @if (!string.IsNullOrEmpty(errorMessage))
                {
                        <div class="alert alert-danger mt-3">@errorMessage</div>
                }

            </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="() => showPaymentModal = false">Відміна</button>
                    <button class="btn btn-success px-5 py-2 fw-bold" @onclick="ConfirmCheckout" disabled="@(Remaining > 0 || isSubmitting)">
                    @if (isSubmitting)
                    {
                        <span class="spinner-border spinner-border-sm me-2"></span>
                    }
                        <i class="bi bi-printer me-2"></i>Провести продаж
                                </button>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
            <div class="ms-footer">
                <button class="btn-apple secondary w-100" @onclick="CloseSuccessModal">Почати новий продаж</button>
            </div>
        </div>
    </div>
}


@* ════════════════════════════════════════════════
   MODAL: WARRANTY
════════════════════════════════════════════════ *@
@if (showWarrantyModal && pendingDevice != null)
{
    <div class="modal fade show d-block" style="background: rgba(0,0,0,0.6);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content shadow-lg border-0">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title">🛡️ Гарантія для @pendingDevice.ModelName</h5>
                    <button class="btn-close btn-close-white" @onclick="() => showWarrantyModal = false"></button>
            </div>
                <div class="modal-body text-center p-4">
                    <i class="bi bi-shield-check display-1 text-primary mb-3"></i>
                    <h4 class="mb-3">Бажаєте додати захист?</h4>
                    <p class="text-muted">Оберіть варіант гарантії:</p>
                    <div class="list-group text-start mt-3">
                @foreach (var rate in availableWarranties)
                {
                            var isActive = selectedWarrantyRate?.Id == rate.Id;
                            <button type="button" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center @(isActive ? "active bg-primary text-white" : "")"
                                    @onclick="() => SelectWarranty(rate)">
                                <div><span class="fw-bold">@rate.Type</span><span class="d-block small opacity-75">Термін: @rate.TermMonths міс.</span></div>
                                <span class="fw-bold fs-5">@rate.Price.ToString("N0") грн</span>
                                @if (isActive)
                            {
                                    <i class="bi bi-check-circle-fill ms-2"></i>
                            }
                            </button>
                            }
                        </div>
                    </div>
                }
            </div>
                <div class="modal-footer justify-content-between">
                    <button class="btn btn-outline-secondary" @onclick="() => ConfirmAddDevice(null)">Ні, дякую (Без гарантії)</button>
                    <button class="btn btn-success px-4 fw-bold" disabled="@(selectedWarrantyRate == null)" @onclick="() => ConfirmAddDevice(selectedWarrantyRate)">
                        <i class="bi bi-plus-lg me-2"></i>Додати гарантію
                </button>
            </div>
        </div>
    </div>
    </div>
}

@* ════════════════════════════════════════════════
   MODAL: TRADE-IN 
════════════════════════════════════════════════ *@
@if (showTradeInModal)
{
    <div class="modal fade show d-block" style="background: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title">🔄 Trade-In (Прийом пристрою)</h5>
                    <button class="btn-close btn-close-white" @onclick="() => showTradeInModal = false"></button>
            </div>
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label">Модель пристрою</label>
                            <input class="form-control" list="tradeInModels"
                                   @bind="activeTradeIn.Model"
                                   @bind:event="oninput"
                                   placeholder="Почніть вводити..." />

                            <datalist id="tradeInModels">
                                @foreach (var prod in productsList.Where(p => p.CategoryId == 1))
                            {
                                    <option value="@prod.Name"></option>
                            }
                        </datalist>
                    </div>
                        <div class="col-md-6">
                            <label class="form-label">IMEI / Серійний</label>
                            <input class="form-control" @bind="activeTradeIn.Imei" />
                </div>
                        <div class="col-md-4">
                            <label class="form-label">Колір</label>
                            <input class="form-control" @bind="activeTradeIn.Color" placeholder="Black" />
            </div>
                        <div class="col-md-4">
                            <label class="form-label">Пам'ять</label>
                            <input class="form-control" @bind="activeTradeIn.Capacity" placeholder="128GB" />
            </div>
                        <div class="col-md-4">
                            <label class="form-label">Батарея (%)</label>
                            <input type="number" class="form-control" @bind="activeTradeIn.BatteryHealth" />
        </div>
                        <div class="col-12">
                            <label class="form-label">Опис стану</label>
                            <textarea class="form-control" rows="2" @bind="activeTradeIn.Condition" placeholder="Стан екрану, корпусу тощо..."></textarea>
    </div>
                        <div class="col-12">
                            <label class="fw-bold text-success">Оціночна вартість (Знижка)</label>
                            <input type="number" class="form-control border-success fw-bold" @bind="activeTradeIn.Price" />
            </div>

            <div class="ms-body" style="background:#fafafa; max-height: 60vh; overflow-y: auto; padding: 16px;">
                <p style="font-size:13px; color:var(--apple-sub); margin-bottom:16px; text-align: center; font-weight: 600;">
                    Не забудьте запропонувати клієнту захист та аксесуари!
                </p>

                @foreach (var acc in recommendedAccessories)
                {
                    bool inCart = cart.Any(x => x.ProductId == acc.ProductId && x.Category == "Accessory");

                    <div class="w-card" style="padding: 12px; margin-bottom: 8px; border-color: @(inCart ? "var(--apple-green)" : "var(--apple-border)");">
                        <div class="w-left" style="flex: 1; min-width: 0;">
                            <div class="w-title" style="font-size: 14px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;" title="@acc.ModelName">
                                @acc.ModelName
                            </div>
                            <div class="w-sub" style="font-size: 11px;">На залишку: <b style="color: var(--apple-text);">@acc.Quantity шт.</b></div>
                        </div>
                <div class="modal-footer">
                    <button class="btn btn-light" @onclick="() => showTradeInModal = false">Скасувати</button>
                    <button class="btn btn-primary" @onclick="SaveTradeIn"
                            disabled="@(activeTradeIn.Price <= 0 || string.IsNullOrEmpty(activeTradeIn.Model))">
                        Зберегти
                                </button>
                            }
                        </div>
                    </div>
                }
            </div>

            <div class="ms-footer">
                <button class="btn-apple primary w-100" style="justify-content: center;" @onclick="() => showRecommendationsModal = false">
                    Продовжити продаж
                </button>
            </div>
        </div>
    </div>
}

@code {
    private int currentStoreId = 1;
    private string searchTerm = "";
    private string errorMessage = "";
    private List<Store> stores = new();
    private bool isAdmin = false;
    private bool isLoadingStock = false;
    private string checkoutSource = "Offline";
    private List<Store> stores = new();

    // Trade-In & Payment
    private bool showPaymentModal = false;
    private bool isSubmitting = false;
    private List<SalePayment> paymentParts = new();
    private bool showTradeInModal = false;
    private TradeInDto activeTradeIn = new();
    private bool hasTradeIn => activeTradeIn.Price > 0;

    // Warranty
    private bool showWarrantyModal = false;
    private DeviceView? pendingDevice;
    private List<WarrantyRate> availableWarranties = new();
    private WarrantyRate? selectedWarrantyRate;

    // Lists
    private List<DeviceView> availableDevices = new();
    private List<AccessoryDto> availableAccessories = new();
    private List<Product> productsList = new();
    private List<string> paymentMethods = new() { "Готівка", "USD", "EUR", "Картковий переказ", "Термінал" };
    private List<CartItemDto> cart = new();

    // DTOs for View
    class DeviceView { public int Id { get; set; } public int StoreId { get; set; } public string Identifier { get; set; } = ""; public string ModelName { get; set; } = ""; public string Color { get; set; } = ""; public string Capacity { get; set; } = ""; public decimal SellingPrice { get; set; } public decimal PurchasePrice { get; set; } public int BatteryHealth { get; set; } }
    class AccessoryDto { public int ProductId { get; set; } public int StoreId { get; set; } public string ModelName { get; set; } = ""; public int Quantity { get; set; } public decimal SellingPrice { get; set; } public decimal PurchasePrice { get; set; } }

    private decimal TotalCartAmount => cart.Sum(x => (x.Price * x.Quantity) + x.WarrantyPrice);
    private decimal TotalToPay => TotalCartAmount - (hasTradeIn ? activeTradeIn.Price : 0);
    private decimal TotalPaidInUAH => paymentParts.Sum(x => x.Amount * x.ExchangeRate);
    private decimal Remaining => TotalToPay - TotalPaidInUAH;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        isAdmin = user.IsInRole("Admin");

        // Спроба отримати магазин з токена
        var storeClaim = user.FindFirst("StoreId");
        if (storeClaim != null && int.TryParse(storeClaim.Value, out int sId))
        {
            currentStoreId = sId;
        }

        stores = await Http.GetFromJsonAsync<List<Store>>("api/transfers/stores") ?? new();
        productsList = await Http.GetFromJsonAsync<List<Product>>("api/inventory/products") ?? new();
        await LoadStock();
        if (RepairId.HasValue)
        {
            await LoadRepairToCart(RepairId.Value);
        }

        if (DeviceId.HasValue)
        {
            var dev = availableDevices.FirstOrDefault(d => d.Id == DeviceId.Value);
            if (dev != null)
            {
                await AddDeviceToCart(dev, suppressAlert: true);
            }
        }
    }
    private async Task LoadRepairToCart(int id)
    {
        try
        {
            var allRepairs = await Http.GetFromJsonAsync<List<RepairTicket>>("api/repairs");
            var repair = allRepairs?.FirstOrDefault(r => r.Id == id);

            if (repair != null && repair.Status == RepairStatus.Ready && !cart.Any(c => c.Category == "Service" && c.RepairTicketId == id))
            {
                if (repair.Items != null && repair.Items.Any())
                {
                    foreach (var item in repair.Items)
                    {
                        cart.Add(new CartItemDto
                        {
                            RepairTicketId = repair.Id,
                            ProductId = item.Id,
                            ModelName = $"Ремонт: {item.Name}",
                            Identifier = $"Квитанція #{repair.TicketNumber}",
                            Category = "Service",
                            Price = item.Price,
                            Cost = item.Cost,
                            Quantity = 1,
                            MaxQuantity = 1
                        });
                    }
                }
                else
                {
                    cart.Add(new CartItemDto
                    {
                        RepairTicketId = repair.Id,
                        ProductId = repair.Id,
                        ModelName = string.IsNullOrWhiteSpace(repair.ResolutionReport) ? $"Ремонт: {repair.DeviceModel}" : $"Ремонт: {repair.ResolutionReport}",
                        Identifier = $"Квитанція #{repair.TicketNumber}",
                        Category = "Service",
                        Price = repair.Price,
                        Cost = repair.CostPart,
                        Quantity = 1,
                        MaxQuantity = 1
                    });
                }

                StateHasChanged();

                if (!string.IsNullOrWhiteSpace(repair.ClientPhone))
                {
                    string cName = !string.IsNullOrWhiteSpace(repair.ClientName) ? repair.ClientName : "Клієнт з ремонту";

                    selectedCustomer = new CustomerDto
                    {
                        Name = cName,
                        Phone = repair.ClientPhone
                    };

                    if (customerSelector != null)
                    {
                        await customerSelector.PreFillManualAsync(cName, repair.ClientPhone);
                    }
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Помилка додавання ремонту в кошик: {ex.Message}");
        }
    }

    private async Task OnStoreChanged(ChangeEventArgs e)
    {
        if (!isAdmin) return;
        if (int.TryParse(e.Value?.ToString(), out int id))
        {
            currentStoreId = id;
            ClearCartData();
            await LoadStock();
        }
    }

    private void ClearCartData()
    {
        cart.Clear();
        tradeIns.Clear();
        tiedBookingIds.Clear();
        globalDiscount = 0;
        reservationDepositAmount = 0;
        selectedCustomer = null;
        checkoutSource = "Offline";

        if (customerSelector != null)
        {
            customerSelector.ClearCustomer();
        }
    }

    private async Task LoadStock()
    {
        var allDevs = await Http.GetFromJsonAsync<List<DeviceView>>("api/inventory/devices");
        var allAccs = await Http.GetFromJsonAsync<List<AccessoryDto>>("api/accessories");
        availableDevices = allDevs.Where(d => d.StoreId == currentStoreId).ToList();
        availableAccessories = allAccs.Where(a => a.StoreId == currentStoreId && a.Quantity > 0).ToList();
    }

    private async Task AddDeviceToCart(DeviceView dev)
    {
        if (cart.Any(x => x.DeviceStockId == dev.Id)) return;

        try
        {
            var res = await Http.GetAsync($"api/telegram/check-reservation/{dev.Id}");

            if (res.IsSuccessStatusCode)
            {
                var reservation = await res.Content.ReadFromJsonAsync<ReservationDto>();

                if (reservation != null && reservation.AgreedPrice > 0)
                {
                    dev.SellingPrice = reservation.AgreedPrice;

                    if (reservation.Deposit > 0)
                    {
                        reservationDepositAmount += reservation.Deposit;
                        if (!suppressAlert)
                        {
                            await JS.InvokeVoidAsync("alert",
                                $"⚠️ ТЕЛЕФОН ЗАБРОНЬОВАНО!\n\n" +
                                $"👤 Клієнт: {reservation.CustomerName}\n" +
                                $"📞 Телефон: {reservation.CustomerPhone}\n" +
                                $"💰 Домовлена ціна: {reservation.AgreedPrice.ToString("N0")} грн\n" +
                                $"💵 Завдаток: {reservation.Deposit.ToString("N0")} грн (його буде автоматично додано до оплати!)");
                        }
                    }
                    else
                    {
                        if (!suppressAlert)
                        {
                            await JS.InvokeVoidAsync("alert",
                                $"⚠️ ТЕЛЕФОН ЗАБРОНЬОВАНО!\n\n" +
                                $"👤 Клієнт: {reservation.CustomerName}\n" +
                                $"📞 Телефон: {reservation.CustomerPhone}\n" +
                                $"💰 Домовлена ціна: {reservation.AgreedPrice.ToString("N0")} грн");
                        }
                    }

                    selectedCustomer = new CustomerDto
                    {
                        Name = reservation.CustomerName,
                        Phone = reservation.CustomerPhone
                    };

                    if (customerSelector != null)
                    {
                        await customerSelector.PreFillManualAsync(reservation.CustomerName, reservation.CustomerPhone);
                    }
                    tiedBookingIds.Add(reservation.BookingId);
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Помилка перевірки броні: {ex.Message}");
        }

        pendingDevice = dev;
        try
        {
            // Якщо не вдасться отримати гарантії - просто додамо без них
            string modelNameForSearch = dev.ModelName;
            availableWarranties = await Http.GetFromJsonAsync<List<WarrantyRate>>($"api/inventory/warranty-rates?modelName={modelNameForSearch}") ?? new();
            if (!availableWarranties.Any()) { ConfirmAddDevice(null); return; }
            selectedWarrantyRate = null;
            showWarrantyModal = true;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Err: {ex.Message}");
            ConfirmAddDevice(null);
        }
    }

    private void ConfirmAddDevice(WarrantyRate? warranty)
    {
        if (pendingDevice == null) return;
        var item = new CartItemDto
        {
            DeviceStockId = pendingDevice.Id,
            ModelName = pendingDevice.ModelName,
            Identifier = pendingDevice.Identifier,
            Category = "Device",
            Color = pendingDevice.Color,
            Capacity = pendingDevice.Capacity,
            Price = pendingDevice.SellingPrice,
            Cost = pendingDevice.PurchasePrice,
            Quantity = 1,
            WarrantyId = warranty?.Id,
            WarrantyPrice = warranty?.Price ?? 0,
            WarrantyInfo = warranty != null ? $"{warranty.TermMonths} міс. {warranty.Type}" : "Без гарантії"
        };
        cart.Add(item);
        showWarrantyModal = false;

        // 🔥 ЗАПУСКАЄМО РОЗУМНІ РЕКОМЕНДАЦІЇ
        var addedDevice = pendingDevice;
        pendingDevice = null;

        ShowRecommendations(addedDevice);
    }

    // 🔥 ЧИСТА ПЕРЕВІРКА СУМІСНОСТІ ЧЕРЕЗ БД
    private bool IsCompatibleFromDB(string? compatibleModelsStr, string devModelName)
    {
        if (string.IsNullOrWhiteSpace(compatibleModelsStr) || string.IsNullOrWhiteSpace(devModelName))
            return false;

        string Normalize(string s) => s.ToLower()
                                       .Replace("apple", "")
                                       .Replace("iphone", "")
                                       .Replace(" ", "")
                                       .Replace("-", "");

        string targetModel = Normalize(devModelName);

        var compatibleList = compatibleModelsStr.Split(',', StringSplitOptions.RemoveEmptyEntries)
                                                .Select(m => Normalize(m))
                                                .ToList();

        return compatibleList.Contains(targetModel);
    }

    // 🔥 ІДЕАЛЬНІ РЕКОМЕНДАЦІЇ
    private void ShowRecommendations(DeviceView dev)
    {
        if (string.IsNullOrWhiteSpace(dev.ModelName)) return;

        recommendedAccessories.Clear();

        var glasses = availableAccessories
            .Where(a => a.Quantity > 0 &&
                        a.ModelName.Contains("Скло", StringComparison.OrdinalIgnoreCase) &&
                        IsCompatibleFromDB(a.CompatibleModels, dev.ModelName))
            .OrderByDescending(a => a.SellingPrice)
            .ToList();

        if (glasses.Any())
        {
            recommendedAccessories.Add(glasses.First());
            if (glasses.Count > 1) recommendedAccessories.Add(glasses.Last());
        }

        var cases = availableAccessories
            .Where(a => a.Quantity > 0 &&
                        (a.ModelName.Contains("Чохол", StringComparison.OrdinalIgnoreCase) || a.ModelName.Contains("Case", StringComparison.OrdinalIgnoreCase)) &&
                        IsCompatibleFromDB(a.CompatibleModels, dev.ModelName))
            .OrderByDescending(a => a.SellingPrice)
            .ToList();

        if (cases.Any())
        {
            recommendedAccessories.Add(cases.First());
            if (cases.Count > 1) recommendedAccessories.Add(cases.Last());
        }

        var adapters = availableAccessories
            .Where(a => a.Quantity > 0 &&
                        !a.ModelName.Contains("Power", StringComparison.OrdinalIgnoreCase) &&
                        !a.ModelName.Contains("Bank", StringComparison.OrdinalIgnoreCase) &&
                        (a.ModelName.Contains("20Вт", StringComparison.OrdinalIgnoreCase) ||
                         a.ModelName.Contains("Блочок", StringComparison.OrdinalIgnoreCase) ||
                         a.ModelName.Contains("Адаптер", StringComparison.OrdinalIgnoreCase)))
            .OrderByDescending(a => a.SellingPrice)
            .Take(1);

        recommendedAccessories.AddRange(adapters);

        bool isTypeC = dev.ModelName.Contains("15") || dev.ModelName.Contains("16");
        string cableKeyword = isTypeC ? "Type-C" : "Lightning";

        var cables = availableAccessories
            .Where(a => a.Quantity > 0 &&
                        a.ModelName.Contains("Кабель", StringComparison.OrdinalIgnoreCase) &&
                        a.ModelName.Contains(cableKeyword, StringComparison.OrdinalIgnoreCase))
            .OrderByDescending(a => a.SellingPrice)
            .Take(1);

        recommendedAccessories.AddRange(cables);

        if (recommendedAccessories.Any())
        {
            recommendationTargetName = dev.ModelName;
            showRecommendationsModal = true;
        }
    }

    private async Task AddRecommendedAccessory(AccessoryDto acc)
    {
        await AddAccessoryToCart(acc);
    }

    private void AddAccessoryToCart(AccessoryDto acc)
    {
        var existing = cart.FirstOrDefault(x => x.ProductId == acc.ProductId);
        if (existing != null) { if (existing.Quantity < acc.Quantity) existing.Quantity++; }
        else
        {
            cart.Add(new CartItemDto
        {
                ProductId = acc.ProductId,
                ModelName = acc.ModelName,
                Category = "Accessory",
                Price = acc.SellingPrice,
                Cost = acc.PurchasePrice,
                Quantity = 1,
                MaxQuantity = acc.Quantity
            });
    }

    private void AddPosServiceToCart(Product srv)
    {
        var existing = cart.FirstOrDefault(x => x.ProductId == srv.Id && x.Category == "PosService");
        if (existing != null) existing.Quantity++;
        else cart.Add(new CartItemDto { ProductId = srv.Id, ModelName = srv.Name, Category = "PosService", Price = srv.SellingPrice, Cost = 0, Quantity = 1, MaxQuantity = 999 });
    }

    private void ChangeQty(CartItemDto item, int delta)
        {
            string confirmMessage;
            if (isAdmin || item.MaxQuantity > 0) confirmMessage = $"На залишку {item.MaxQuantity} шт. Збільшити?";
            else confirmMessage = "Товару більше немає на складі. Все одно збільшити кількість?";
            if (!await JS.InvokeAsync<bool>("confirm", confirmMessage)) return;
        }
        item.Quantity += delta;
        if (item.Quantity > item.MaxQuantity) item.Quantity = item.MaxQuantity;
        if (item.Quantity < 1) cart.Remove(item);
    }

    private async Task ChangeQtyFromCatalog(AccessoryDto acc, int delta)
    {
        var item = cart.FirstOrDefault(x => x.ProductId == acc.ProductId);
        if (item == null && delta > 0) { await AddAccessoryToCart(acc); return; }
        if (item != null) await ChangeQty(item, delta);
    }

    private void ChangeServiceQtyFromCatalog(Product srv, int delta)
    {
        var item = cart.FirstOrDefault(x => x.ProductId == srv.Id && x.Category == "PosService");
        if (item == null && delta > 0) { AddPosServiceToCart(srv); return; }
        if (item != null) { item.Quantity += delta; if (item.Quantity < 1) cart.Remove(item); }
    }

    private void OpenPaymentModal()
    {
        paymentParts = new();
            paymentParts.Add(new SalePayment { Method = "Готівка", Amount = TotalToPay, ExchangeRate = 1 });
        }

        showPaymentModal = true;
    }

    private void AddPaymentLine()
    {
        decimal amt = Remaining > 0 ? Remaining : 0;
        paymentParts.Add(new SalePayment { Method = "Готівка", Amount = amt, ExchangeRate = 1 });
    }

    private void RemovePaymentLine(SalePayment item)
        {
        paymentParts.Remove(item);
        if (!paymentParts.Any()) AddPaymentLine();
    }

    private void OnCurrencyChange(SalePayment part, ChangeEventArgs e)
        {
        part.Method = e.Value.ToString();
        part.ExchangeRate = (part.Method == "USD" || part.Method == "EUR") ? 0 : 1;
        }

    private void SelectWarranty(WarrantyRate rate) { selectedWarrantyRate = rate; StateHasChanged(); }
    private void SaveTradeIn() { if (string.IsNullOrWhiteSpace(activeTradeIn.Model) || activeTradeIn.Price <= 0) return; showTradeInModal = false; StateHasChanged(); }
    private void RemoveTradeIn() { activeTradeIn = new(); }

    private async Task ConfirmCheckout()
    {
        if (isSubmitting) return;
        isSubmitting = true;
        StateHasChanged();

        errorMessage = "";
                try
                {
                    var existingResponse = await Http.GetAsync($"api/customers/by-phone?phone={Uri.EscapeDataString(selectedCustomer.Phone)}");
                    if (existingResponse.IsSuccessStatusCode)
                    {
                        var existingCustomer = await existingResponse.Content.ReadFromJsonAsync<CustomerDto>();
                        if (existingCustomer != null)
                        {
                            selectedCustomer.Id = existingCustomer.Id;
                            selectedCustomer.TelegramChatId = existingCustomer.TelegramChatId;
                        }
                    }

                    if (selectedCustomer.Id == 0)
                    {
                        var custResponse = await Http.PostAsJsonAsync("api/customers", selectedCustomer);
                        if (custResponse.IsSuccessStatusCode)
                        {
                            var createdCustomer = await custResponse.Content.ReadFromJsonAsync<CustomerDto>();
                            if (createdCustomer != null) selectedCustomer.Id = createdCustomer.Id;
                        }
                    }
                }
                catch (Exception ex) { Console.WriteLine($"Customer check error: {ex.Message}"); }
            }

            var request = new CheckoutRequest
            {
                StoreId = currentStoreId,
                Items = cart,
                Payments = paymentParts,
                TradeIns = hasTradeIn ? activeTradeIn : null
            };

            var response = await Http.PostAsJsonAsync("api/sales/checkout", request);

            if (response.IsSuccessStatusCode)
            {
                var saleId = await response.Content.ReadFromJsonAsync<int>();

                foreach (var bId in tiedBookingIds)
                {
                    try { await Http.PostAsync($"api/telegram/complete/{bId}", null); } catch { }
                }
                tiedBookingIds.Clear();

                completedSaleId = saleId;
                completedCustomerId = selectedCustomer?.Id ?? 0;
                isTelegramSent = false;
                showPaymentModal = false;
                cart.Clear();
                activeTradeIn = new();
                await LoadStock();

                showSuccessModal = true;

                if (completedCustomerId > 0)
                {
                    await CheckTelegramStatus();
                }
            }
            else
            {
                errorMessage = await response.Content.ReadAsStringAsync();
            }
        }
        finally
        {
            isSubmitting = false;
            StateHasChanged();
        }
    }

    public class ReservationDto
    {
        public int BookingId { get; set; }
        public decimal AgreedPrice { get; set; }
        public decimal Deposit { get; set; }
        public string CustomerPhone { get; set; } = "";
        public string CustomerName { get; set; } = "";
    }
}