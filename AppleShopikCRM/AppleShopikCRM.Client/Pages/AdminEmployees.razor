@if (selectedKpiManager != null)
{
    <div class="modal-backdrop-apple" @onclick="() => selectedKpiManager = null">
        <div class="modal-sheet lg" @onclick:stopPropagation>
            <div class="ms-header">
                <div>
                    <h3 class="ms-title">Деталі: @selectedKpiManager.UserName</h3>
                    <div style="font-size: 12px; color: var(--apple-sub);">За період: @startDate.ToString("dd.MM.yyyy") — @endDate.ToString("dd.MM.yyyy")</div>
                </div>
                <button class="ms-close" @onclick="() => selectedKpiManager = null"><i class="bi bi-x"></i></button>
            </div>
            <div class="ms-body" style="background: #fafafa;">
                @foreach (var group in selectedKpiManager.Details.GroupBy(d => d.Category).OrderBy(g => g.Key))
                {
                    bool isExpanded = expandedKpiCategories.Contains(group.Key);
                    <div class="kpi-category-header shadow-sm" @onclick="() => ToggleKpiCategory(group.Key)">
                        <div style="display:flex; align-items:center; gap:10px;">
                            <span style="font-weight:700; font-size:15px; color:var(--apple-text);">@GetCategoryLabel(group.Key)</span>
                            <span class="badge bg-secondary bg-opacity-10 text-dark">@group.Sum(x => x.Quantity) шт</span>
                        </div>
                        <div style="display:flex; align-items:center; gap:16px;">
                            <div style="text-align:right;">
                                <div style="font-weight:700; font-size:14px;">@group.Sum(x => x.RevenueUAH).ToString("N0") ₴</div>
                                <div style="font-weight:700; font-size:12px; color:var(--apple-green);">+$@group.Sum(x => x.ProfitUSD).ToString("N0")</div>
                            </div>
                            <i class="bi @(isExpanded ? "bi-chevron-up" : "bi-chevron-down")"></i>
                        </div>
                    </div>
                    @if (isExpanded)
                    {
                        <div class="kpi-category-content">
                            <table class="apple-table" style="background:#fff; border-radius:8px; border:1px solid var(--apple-border);">
                                <thead>
                                    <tr><th>Чек / Дата</th><th>Назва товару</th><th style="text-align:center;">К-сть</th><th style="text-align:right;">Оборот</th><th style="text-align:right;">Прибуток</th></tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in group)
                                    {
                                        <tr>
                                            <td style="width: 130px;"><div style="font-weight: 600;">@item.Date.ToString("dd.MM.yy HH:mm")</div><div style="font-size:11px; color:var(--apple-blue);">#@item.SaleId</div></td>
                                            <td style="font-weight: 600;">@item.ItemName</td>
                                            <td style="text-align: center;">@item.Quantity</td>
                                            <td style="text-align: right; font-weight: 600;">@item.RevenueUAH.ToString("N0") ₴</td>
                                            <td style="text-align: right; font-weight: 700; color: var(--apple-green);">+$@item.ProfitUSD.ToString("N0")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                }
            </div>
        </div>
    </div>
}

@code {
    private string currentTab = "users";
    private bool isLoading = true;
    private PayrollDto? selectedPayroll = null;

    private bool showBlockedUsers = false; // 🔥 ФІЛЬТР ДЛЯ ЗАБЛОКОВАНИХ

    // Дати
    private DateTime startDate = new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1);
    private DateTime endDate = DateTime.Today;
    private DateTime payrollMonthYear = new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1);

    // Дані
    private List<UserListDto> usersList = new();
    private List<SalaryRuleDto> salaryRules = new();
    private List<ShiftDto> shifts = new();
    private List<ManagerKpiDto> kpis = new();
    private List<PayrollDto> payrolls = new();
    private List<Store> stores = new();

    // ДЛЯ АРХІВУ
    private TimesheetFormDto tsForm = new();
    private List<TimesheetArchiveDto> timesheetArchives = new();
    private bool isArchiveView = false;

    // Модалки
    private bool showUserModal = false, showEditUserModal = false;
    private string userError = "", userEditError = "";
    private NewUserDto newUser = new() { Role = "Manager" };
    private UpdateUserDto editingUser = new();

    private ManagerKpiDto? selectedKpiManager = null;
    private HashSet<string> expandedKpiCategories = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadStores();
        await SwitchTab("users");
    }

    private async Task LoadStores()
    {
        try { stores = await Http.GetFromJsonAsync<List<Store>>("api/transfers/stores") ?? new(); } catch { }
    }

    private async Task SwitchTab(string tab)
    {
        currentTab = tab;
        if (tab == "timesheet-pdf") return;
        await LoadTabData();
    }

    private async Task LoadTabData()
    {
        isLoading = true;
        StateHasChanged();
        try
        {
            string dateQuery = $"?start={startDate:yyyy-MM-dd}&end={endDate:yyyy-MM-dd}&_={DateTime.Now.Ticks}";

            if (currentTab == "users") usersList = await Http.GetFromJsonAsync<List<UserListDto>>("api/admin/users") ?? new();
            else if (currentTab == "rules") salaryRules = await Http.GetFromJsonAsync<List<SalaryRuleDto>>("api/admin/salary-rules") ?? new();
            else if (currentTab == "shifts") shifts = await Http.GetFromJsonAsync<List<ShiftDto>>($"api/admin/shifts{dateQuery}") ?? new();
            else if (currentTab == "kpi") kpis = await Http.GetFromJsonAsync<List<ManagerKpiDto>>($"api/admin/kpi{dateQuery}") ?? new();
            else if (currentTab == "payroll")
            {
                string payrollQuery = $"?month={payrollMonthYear.Month}&year={payrollMonthYear.Year}&storeId=0&_={DateTime.Now.Ticks}";
                payrolls = await Http.GetFromJsonAsync<List<PayrollDto>>($"api/admin/payroll{payrollQuery}") ?? new();
            }
        }
        catch (Exception ex) { Console.WriteLine(ex.Message); }
        finally { isLoading = false; StateHasChanged(); }
    }

    private async Task LoadArchives()
    {
        isArchiveView = true;
        isLoading = true;
        try
        {
            timesheetArchives = await Http.GetFromJsonAsync<List<TimesheetArchiveDto>>("api/admin/archive") ?? new();
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.Message);
        }
        finally
        {
            isLoading = false;
        }
    }

    private void SelectPayroll(PayrollDto p) { selectedPayroll = p; }

    private void RecalculateSelected()
    {
        if (selectedPayroll == null) return;

        selectedPayroll.BaseSalaryAmount = Math.Round((selectedPayroll.RuleMonthlyRate / 22m) * selectedPayroll.WorkingDays, 2);
        selectedPayroll.DevicesBonusAmount = selectedPayroll.DevicesSold * selectedPayroll.RuleDeviceBonus;
        selectedPayroll.WarrantiesBonusAmount = selectedPayroll.WarrantiesSold * selectedPayroll.RuleWarrantyBonus;
        selectedPayroll.AccessoriesBonusAmount = Math.Round(selectedPayroll.AccessoriesRevenueUAH * (selectedPayroll.RuleAccPercent / 100m), 2);
        selectedPayroll.ServicesBonusAmount = Math.Round(selectedPayroll.ServicesRevenueUAH * (selectedPayroll.RuleSrvPercent / 100m), 2);
        selectedPayroll.LatenessPenaltyAmount = selectedPayroll.Latenesses * selectedPayroll.RulePenalty;

        RecalculateTotalsOnly();
    }

    private void RecalculateTotalsOnly()
    {
        if (selectedPayroll == null) return;
        selectedPayroll.BaseSalaryCalculated = selectedPayroll.BaseSalaryAmount + selectedPayroll.DevicesBonusAmount + selectedPayroll.WarrantiesBonusAmount + selectedPayroll.AccessoriesBonusAmount + selectedPayroll.ServicesBonusAmount - selectedPayroll.LatenessPenaltyAmount;
        selectedPayroll.FinalPayout = selectedPayroll.BaseSalaryCalculated - selectedPayroll.AdvancePayment;
    }

    private async Task SaveSinglePayrollRecord()
    {
        if (selectedPayroll == null) return;

        if (DateTime.TryParse(payrollMonthYear + "-01", out DateTime selectedMonth))
        {
            var confirm = await JS.InvokeAsync<bool>("confirm", $"Зберегти відомість для {selectedPayroll.EmployeeName}?");
            if (!confirm) return;

            string query = $"?month={selectedMonth.Month}&year={selectedMonth.Year}";
            var res = await Http.PostAsJsonAsync($"api/admin/payroll/save{query}", new List<PayrollDto> { selectedPayroll });

            if (res.IsSuccessStatusCode)
            {
                await JS.InvokeVoidAsync("alert", "✅ Успішно збережено!");
                await LoadTabData();
                selectedPayroll = payrolls.FirstOrDefault(p => p.UserId == selectedPayroll.UserId);
            }
            else await JS.InvokeVoidAsync("alert", "❌ Помилка збереження.");
        }
    }

    private async Task SavePayrollRecords()
    {
        if (DateTime.TryParse(payrollMonthYear + "-01", out DateTime selectedMonth))
        {
            var confirm = await JS.InvokeAsync<bool>("confirm", $"Зберегти відомість та зафіксувати аванси за {selectedMonth.ToString("MM.yyyy")}?");
            if (!confirm) return;

            string query = $"?month={selectedMonth.Month}&year={selectedMonth.Year}";
            var res = await Http.PostAsJsonAsync($"api/admin/payroll/save{query}", payrolls);

            if (res.IsSuccessStatusCode)
            {
                await JS.InvokeVoidAsync("alert", "✅ Зарплатну відомість успішно збережено!");
                await LoadTabData();
            }
            else await JS.InvokeVoidAsync("alert", "❌ Виникла помилка під час збереження.");
        }
    }

    private async Task SaveAndDownloadTimesheet()
    {
        if (string.IsNullOrWhiteSpace(tsForm.FullName) || string.IsNullOrWhiteSpace(tsForm.Month))
        {
            await JS.InvokeVoidAsync("alert", "⚠️ Введіть ПІБ та Місяць, щоб зберегти документ!");
            return;
        }

        try
        {
            var archiveResponse = await Http.PostAsJsonAsync("api/admin/archive", tsForm);

            if (!archiveResponse.IsSuccessStatusCode)
            {
                string error = await archiveResponse.Content.ReadAsStringAsync();
                await JS.InvokeVoidAsync("alert", $"❌ Помилка БД: {error}");
                return;
            }

            var pdfResponse = await Http.PostAsJsonAsync("api/admin/generate-timesheet", tsForm);

            if (pdfResponse.IsSuccessStatusCode)
            {
                var fileBytes = await pdfResponse.Content.ReadAsByteArrayAsync();
                var base64 = Convert.ToBase64String(fileBytes);

                string fName = tsForm.FullName.Replace(" ", "_");
                string mName = tsForm.Month.Replace(" ", "_");
                string fileName = $"Табель_{fName}_{mName}.pdf";

                await JS.InvokeVoidAsync("eval", $@"
                    var a = document.createElement('a');
                    a.href = 'data:application/pdf;base64,{base64}';
                    a.download = '{fileName}';
                    document.body.appendChild(a);
                    a.click();
                    document.body.removeChild(a);
                ");

                await JS.InvokeVoidAsync("alert", "✅ Успішно збережено в архів та завантажено PDF!");
            }
            else
            {
                await JS.InvokeVoidAsync("alert", "❌ В БД збережено, але виникла помилка при генерації PDF.");
            }
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("alert", $"❌ Мережева помилка: {ex.Message}");
        }
    }

    private async Task DownloadArchivedPdf(TimesheetArchiveDto arc)
    {
        try
        {
            var payload = new TimesheetFormDto
            {
                FullName = arc.FullName,
                Month = arc.Month,
                WorkingDays = arc.WorkingDays,
                Latenesses = arc.Latenesses,
                IphonesSold = arc.IphonesSold,
                OtherAppleSold = arc.OtherAppleSold,
                WarrantiesSold = arc.WarrantiesSold,
                AccessoriesRevenueUAH = arc.AccessoriesRevenueUAH,
                ServicesSold = arc.ServicesSold,
                BaseSalaryAmount = arc.BaseSalaryAmount,
                IphonesBonusAmount = arc.IphonesBonusAmount,
                OtherAppleBonusAmount = arc.OtherAppleBonusAmount,
                WarrantiesBonusAmount = arc.WarrantiesBonusAmount,
                AccessoriesBonusAmount = arc.AccessoriesBonusAmount,
                ServicesBonusAmount = arc.ServicesBonusAmount,
                BonusAmount = arc.BonusAmount,
                PenaltyAmount = arc.PenaltyAmount,
                AdvancePayment = arc.AdvancePayment
            };

            var pdfResponse = await Http.PostAsJsonAsync("api/admin/generate-timesheet", payload);

            if (pdfResponse.IsSuccessStatusCode)
            {
                var fileBytes = await pdfResponse.Content.ReadAsByteArrayAsync();
                var base64 = Convert.ToBase64String(fileBytes);

                string fName = string.IsNullOrWhiteSpace(arc.FullName) ? "Працівник" : arc.FullName.Replace(" ", "_");
                string mName = string.IsNullOrWhiteSpace(arc.Month) ? "Місяць" : arc.Month.Replace(" ", "_");
                string fileName = $"Табель_{fName}_{mName}.pdf";

                await JS.InvokeVoidAsync("eval", $@"
                    var a = document.createElement('a');
                    a.href = 'data:application/pdf;base64,{base64}';
                    a.download = '{fileName}';
                    document.body.appendChild(a);
                    a.click();
                    document.body.removeChild(a);
                ");
            }
            else
            {
                string errorMsg = await pdfResponse.Content.ReadAsStringAsync();
                await JS.InvokeVoidAsync("alert", $"❌ Помилка сервера: {errorMsg}");
            }
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("alert", $"❌ Мережева помилка: {ex.Message}");
        }
    }

    private async Task CreateUser()
    {
        userError = "";
        if (string.IsNullOrWhiteSpace(newUser.FullName) || string.IsNullOrWhiteSpace(newUser.Password)) { userError = "Заповніть всі поля!"; return; }
        var res = await Http.PostAsJsonAsync("api/admin/create-user", newUser);
        if (res.IsSuccessStatusCode) { await JS.InvokeVoidAsync("alert", "Створено!"); showUserModal = false; newUser = new() { Role = "Manager" }; await LoadTabData(); }
        else userError = await res.Content.ReadAsStringAsync();
    }

    private void OpenEditUserModal(UserListDto u) { userEditError = ""; editingUser = new UpdateUserDto { Id = u.Id, FullName = u.FullName, StoreId = u.StoreId ?? 0, Role = u.Role, Password = "" }; showEditUserModal = true; }

    private async Task SaveChangesUser()
    {
        if (string.IsNullOrWhiteSpace(editingUser.FullName)) { userEditError = "ПІБ не може бути порожнім!"; return; }
        var res = await Http.PutAsJsonAsync($"api/admin/users/{editingUser.Id}", editingUser);
        if (res.IsSuccessStatusCode) { showEditUserModal = false; await LoadTabData(); }
        else userEditError = await res.Content.ReadAsStringAsync();
    }

    // 🔥 БЛОКУВАННЯ ТА РОЗБЛОКУВАННЯ
    private async Task BlockUser(string id, string name)
    {
        if (await JS.InvokeAsync<bool>("confirm", $"Заблокувати доступ для {name}?\nКористувач більше не зможе увійти в систему, але його дані та історія продажів збережуться."))
        {
            var res = await Http.PostAsync($"api/admin/users/{id}/block", null);
            if (res.IsSuccessStatusCode) await LoadTabData();
            else await JS.InvokeVoidAsync("alert", await res.Content.ReadAsStringAsync());
        }
    }

    private async Task UnblockUser(string id, string name)
    {
        if (await JS.InvokeAsync<bool>("confirm", $"Відновити доступ для {name}?"))
        {
            var res = await Http.PostAsync($"api/admin/users/{id}/unblock", null);
            if (res.IsSuccessStatusCode) await LoadTabData();
            else await JS.InvokeVoidAsync("alert", await res.Content.ReadAsStringAsync());
        }
    }

    private async Task SaveRule(SalaryRuleDto rule)
    {
        var res = await Http.PostAsJsonAsync("api/admin/salary-rules/update", rule);
        if (res.IsSuccessStatusCode) await JS.InvokeVoidAsync("alert", "✅ Збережено!");
        else await JS.InvokeVoidAsync("alert", "❌ Помилка!");
    }

    private void OpenKpiDetails(ManagerKpiDto manager) { selectedKpiManager = manager; expandedKpiCategories.Clear(); }
    private void ToggleKpiCategory(string category) { if (expandedKpiCategories.Contains(category)) expandedKpiCategories.Remove(category); else expandedKpiCategories.Add(category); }
    private string GetCategoryLabel(string cat) => cat switch { "Device" => "Техніка", "Accessory" => "Аксесуари", "Service" => "Ремонти", "PosService" => "Послуги", "Warranty" => "Гарантії", _ => "Інше" };

    // --- КЛАСИ DTO ---
    public class ShiftDto { public string UserName { get; set; } = ""; public string StoreName { get; set; } = ""; public DateTime WorkDate { get; set; } public DateTime? ClockInTime { get; set; } public DateTime? ClockOutTime { get; set; } }
    public class NewUserDto { public string FullName { get; set; } = ""; public string Email { get; set; } = ""; public string Password { get; set; } = ""; public string Role { get; set; } = "Manager"; public int StoreId { get; set; } = 0; }
    public class UserListDto { public string Id { get; set; } = ""; public string FullName { get; set; } = ""; public string Email { get; set; } = ""; public string Role { get; set; } = ""; public int? StoreId { get; set; } public string StoreName { get; set; } = ""; public bool IsBlocked { get; set; } }
    public class UpdateUserDto { public string Id { get; set; } = ""; public string FullName { get; set; } = ""; public int StoreId { get; set; } public string Role { get; set; } = ""; public string Password { get; set; } = ""; }
    public class SalaryRuleDto { public string UserId { get; set; } = ""; public string EmployeeName { get; set; } = ""; public string Role { get; set; } = ""; public string StoreName { get; set; } = ""; public decimal MonthlyBaseSalary { get; set; } public decimal PenaltyPerLateness { get; set; } public decimal BonusPerDevice { get; set; } public decimal BonusPerWarranty { get; set; } public decimal AccessoryBonusPercent { get; set; } public decimal ServiceBonusPercent { get; set; } }
    public class ManagerCategoryStatsDto { public int Count { get; set; } public decimal RevenueUAH { get; set; } public decimal ProfitUSD { get; set; } }
    public class ManagerSaleItemDetailDto { public int SaleId { get; set; } public DateTime Date { get; set; } public string ItemName { get; set; } = ""; public string Category { get; set; } = ""; public int Quantity { get; set; } public decimal RevenueUAH { get; set; } public decimal ProfitUSD { get; set; } }
    public class ManagerKpiDto { public string UserName { get; set; } = ""; public int ItemsSold { get; set; } public decimal TotalRevenueUAH { get; set; } public decimal TotalProfitUSD { get; set; } public ManagerCategoryStatsDto Devices { get; set; } = new(); public ManagerCategoryStatsDto Accessories { get; set; } = new(); public ManagerCategoryStatsDto Repairs { get; set; } = new(); public ManagerCategoryStatsDto Services { get; set; } = new(); public ManagerCategoryStatsDto Warranties { get; set; } = new(); public List<ManagerSaleItemDetailDto> Details { get; set; } = new(); }

    public class PayrollDto
    {
        public int? RecordId { get; set; }
        public string UserId { get; set; } = "";
        public string EmployeeName { get; set; } = "";
        public int StoreId { get; set; }
        public string StoreName { get; set; } = "";
