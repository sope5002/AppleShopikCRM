                    <table class="apple-table">
                        <thead>
                            <tr>
                                <th>Дата збереження</th>
                                <th>ПІБ працівника</th>
                                <th>Місяць</th>
                                <th>Нараховано</th>
                                <th>Виплачено</th>
                                <th style="text-align: right;">Дія</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!timesheetArchives.Any())
                            {
                                <tr><td colspan="6" class="text-center py-4 text-muted">Архів порожній</td></tr>
                            }
                            @foreach (var arc in timesheetArchives)
                            {
                                <tr>
                                    <td>@arc.CreatedAt.ToString("dd.MM.yyyy HH:mm")</td>
                                    <td style="font-weight: 600;">@arc.FullName</td>
                                    <td>@arc.Month</td>
                                    <td style="color: var(--apple-blue); font-weight: bold;">@arc.TotalAccrued.ToString("N0") ₴</td>
                                    <td style="color: var(--apple-green); font-weight: bold;">@arc.FinalPayout.ToString("N0") ₴</td>
                                    <td style="text-align: right;">
                                        <button class="btn-apple outline" @onclick="() => DownloadArchivedPdf(arc)">
                                            <i class="bi bi-download"></i> PDF
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        }
    }
</div>

