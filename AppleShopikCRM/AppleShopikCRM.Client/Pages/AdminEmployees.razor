@page "/admin/employees"
@using AppleShopikCRM.Client.Models
@using Microsoft.AspNetCore.Components.Web
@using System.Net.Http.Json
@inject HttpClient Http
@inject IJSRuntime JS
@rendermode InteractiveWebAssembly

<PageTitle>Працівники та ЗП — Apple Shopik</PageTitle>

<style>
    /* Базові стилі */
    :root {
        --apple-blue: #0071e3;
        --apple-blue-h: #0077ed;
        --apple-green: #34c759;
        --apple-red: #ff3b30;
        --apple-gray: #f5f5f7;
        --apple-border: #d2d2d7;
        --apple-text: #1d1d1f;
        --apple-sub: #6e6e73;
        --radius-lg: 16px;
        --radius-md: 10px;
        --shadow-card: 0 4px 16px rgba(0,0,0,.05);
    }

    .admin-root {
        padding: 24px;
        background: var(--apple-gray);
        min-height: 100vh;
        font-family: -apple-system, sans-serif;
        color: var(--apple-text);
    }

    .admin-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 24px;
        flex-wrap: wrap;
        gap: 16px;
    }

    .page-title {
        font-size: 1.5rem;
        font-weight: 700;
        margin: 0;
    }

    .filter-bar {
        background: #fff;
        padding: 8px 16px;
        border-radius: var(--radius-md);
        display: flex;
        align-items: center;
        gap: 12px;
        box-shadow: 0 1px 3px rgba(0,0,0,.04);
        border: 1px solid var(--apple-border);
    }

    .apple-input {
        border: 1px solid var(--apple-border);
        border-radius: 8px;
        padding: 8px 12px;
        font-size: 14px;
        outline: none;
        transition: border-color 0.15s;
        width: 100%;
    }

        .apple-input:focus {
            border-color: var(--apple-blue);
            box-shadow: 0 0 0 3px rgba(0,113,227,.1);
        }

    .segment-control {
        display: flex;
        background: #e9e9eb;
        border-radius: 10px;
        padding: 4px;
        gap: 4px;
        margin-bottom: 20px;
        width: fit-content;
        flex-wrap: wrap;
    }

    .segment-btn {
        border: none;
        background: transparent;
        border-radius: 8px;
        padding: 8px 20px;
        font-size: 14px;
        font-weight: 600;
        color: var(--apple-sub);
        cursor: pointer;
        transition: all 0.2s;
        position: relative;
    }

        .segment-btn.active {
            background: #fff;
            color: var(--apple-text);
            box-shadow: 0 2px 6px rgba(0,0,0,.1);
        }

    .btn-apple {
        border: none;
        border-radius: 8px;
        padding: 8px 16px;
        font-size: 14px;
        font-weight: 600;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        transition: 0.15s;
    }

        .btn-apple.primary {
            background: var(--apple-blue);
            color: #fff;
        }

            .btn-apple.primary:hover {
                background: var(--apple-blue-h);
            }

        .btn-apple.outline {
            background: transparent;
            border: 1.5px solid var(--apple-border);
            color: var(--apple-text);
        }

        .btn-apple.success {
            background: var(--apple-green);
            color: #fff;
        }

    .apple-card {
        background: #fff;
        border-radius: var(--radius-lg);
        box-shadow: var(--shadow-card);
        overflow: hidden;
        border: 1px solid var(--apple-border);
    }

    .apple-table {
        width: 100%;
        border-collapse: collapse;
    }

        .apple-table th {
            padding: 14px 20px;
            font-size: 12px;
            color: var(--apple-sub);
            text-transform: uppercase;
            border-bottom: 1px solid var(--apple-border);
            text-align: left;
            background: #fafafa;
        }

        .apple-table td {
            padding: 14px 20px;
            font-size: 14px;
            border-bottom: 1px solid #f0f0f0;
            vertical-align: middle;
        }

    .modal-backdrop-apple {
        position: fixed;
        inset: 0;
        background: rgba(0,0,0,.45);
        backdrop-filter: blur(4px);
        z-index: 1050;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 16px;
    }

    .modal-sheet {
        background: #fff;
        border-radius: 18px;
        width: 100%;
        max-width: 450px;
        box-shadow: 0 20px 60px rgba(0,0,0,.2);
        display: flex;
        flex-direction: column;
    }

        .modal-sheet.lg {
            max-width: 800px;
        }

    .ms-header {
        padding: 18px 20px 14px;
        border-bottom: 1px solid var(--apple-border);
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .ms-body {
        padding: 20px;
        display: flex;
        flex-direction: column;
        gap: 14px;
        max-height: 70vh;
        overflow-y: auto;
    }

    .ms-footer {
        padding: 14px 20px;
        border-top: 1px solid var(--apple-border);
        display: flex;
        justify-content: flex-end;
        gap: 10px;
        background: #fafafa;
        border-radius: 0 0 18px 18px;
    }

    .apple-label {
        font-size: 12px;
        font-weight: 600;
        color: var(--apple-sub);
        margin-bottom: -8px;
    }

    .kpi-cat-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 6px 10px;
        background: #fdfdfd;
        border: 1px solid var(--apple-border);
        border-radius: 8px;
        margin-bottom: 6px;
    }

    .kpi-cat-name {
        font-size: 12px;
        font-weight: 600;
        width: 110px;
    }

    .kpi-cat-val {
        font-size: 13px;
        font-weight: 700;
    }

    .kpi-cat-prof {
        font-size: 13px;
        font-weight: 700;
        color: #1a7a35;
        width: 60px;
        text-align: right;
    }

    .kpi-category-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 12px 16px;
        background: #f5f5f7;
        border: 1px solid var(--apple-border);
        border-radius: 10px;
        cursor: pointer;
        user-select: none;
        margin-bottom: 6px;
        transition: background 0.2s;
    }

        .kpi-category-header:hover {
            background: #e9e9eb;
        }

    .kpi-category-content {
        padding: 0 4px 12px 4px;
        animation: fadeIn 0.2s ease-in-out;
    }

    @@keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(-4px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    /* 🔥 СТИЛІ ДЛЯ ДРУКУ PDF */
    @@media print {
        .sidebar, nav, aside, header, .top-row, .menu, .navbar {
            display: none !important;
        }

        .main, .page, main, #app {
            margin: 0 !important;
            padding: 0 !important;
            width: 100% !important;
            display: block !important;
        }

        .no-print {
            display: none !important;
        }

        body, html, .admin-root {
            background: #fff !important;
            margin: 0 !important;
            padding: 0 !important;
            height: auto !important;
        }

        .print-container {
            display: block !important;
            width: 100% !important;
        }

        #printable-timesheet {
            box-shadow: none !important;
            border: none !important;
            width: 100% !important;
            max-width: 100% !important;
            padding: 10px !important;
            margin: 0 !important;
            color: #000 !important;
        }
    }
</style>

<div class="admin-root">
    <div class="admin-header no-print">
        <h1 class="page-title"><i class="bi bi-people-fill me-2" style="color:var(--apple-blue);"></i>Команда</h1>

        @if (currentTab == "shifts" || currentTab == "kpi")
        {
            <div class="filter-bar">
                <i class="bi bi-calendar3 text-muted"></i>
                <input type="date" class="apple-input" style="border:none; padding:0;" @bind="startDate" @bind:format="yyyy-MM-dd" />
                <span class="text-muted">—</span>
                <input type="date" class="apple-input" style="border:none; padding:0;" @bind="endDate" @bind:format="yyyy-MM-dd" />
                <button class="btn-apple outline ms-2" @onclick="LoadTabData"><i class="bi bi-arrow-clockwise"></i></button>
            </div>
        }
        @if (currentTab == "payroll")
        {
            <div class="filter-bar">
                <i class="bi bi-calendar-month text-muted"></i>
                <input type="month" class="apple-input" style="border:none; padding:0; font-weight: 600;" @bind="payrollMonthYear" @bind:format="yyyy-MM" />
                <button class="btn-apple outline ms-2" @onclick="LoadTabData"><i class="bi bi-arrow-clockwise"></i></button>
            </div>
        }
    </div>

    <div class="no-print" style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 10px;">
        <div class="segment-control">
            <button class="segment-btn @(currentTab == "users" ? "active" : "")" @onclick="@(() => SwitchTab("users"))">
                <i class="bi bi-person-badge me-1"></i> Працівники
            </button>
            <button class="segment-btn @(currentTab == "rules" ? "active" : "")" @onclick="@(() => SwitchTab("rules"))">
                <i class="bi bi-gear-fill me-1"></i> Правила ЗП
            </button>
            <button class="segment-btn @(currentTab == "shifts" ? "active" : "")" @onclick="@(() => SwitchTab("shifts"))">
                <i class="bi bi-clock-history me-1"></i> Робочі Зміни
            </button>
            <button class="segment-btn @(currentTab == "kpi" ? "active" : "")" @onclick="@(() => SwitchTab("kpi"))">
                <i class="bi bi-graph-up-arrow me-1"></i> KPI (Продажі)
            </button>
            <button class="segment-btn @(currentTab == "payroll" ? "active" : "")" @onclick="@(() => SwitchTab("payroll"))">
                <i class="bi bi-cash-coin me-1" style="color: var(--apple-green);"></i> Зарплата
            </button>
            <button class="segment-btn @(currentTab == "timesheet-pdf" ? "active" : "")" @onclick="@(() => SwitchTab("timesheet-pdf"))">
                <i class="bi bi-filetype-pdf me-1" style="color: var(--apple-red);"></i> Табель PDF
            </button>
        </div>

        @if (currentTab == "users")
        {
            <div class="d-flex gap-2 mb-3">
                <button class="btn-apple primary" @onclick="() => showUserModal = true">
                    <i class="bi bi-person-plus-fill"></i> Новий працівник
                </button>
                <button class="btn-apple outline @(showBlockedUsers ? "active" : "")" @onclick="() => showBlockedUsers = !showBlockedUsers">
                    <i class="bi bi-person-x-fill"></i> @(showBlockedUsers ? "Показати активних" : "Заблоковані працівники")
                </button>
            </div>
        }
    </div>

    @if (isLoading)
    {
        <div class="text-center py-5 text-muted no-print"><div class="spinner-border"></div></div>
    }
    else
    {
        @if (currentTab == "users")
        {
            <div class="apple-card no-print">
                <table class="apple-table">
                    <thead>
                        <tr>
                            <th>ПІБ</th>
                            <th>Email (Логін)</th>
                            <th>Магазин</th>
                            <th>Роль</th>
                            <th style="text-align: right;">Дії</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!usersList.Where(u => u.IsBlocked == showBlockedUsers).Any())
                        {
                            <tr><td colspan="5" class="text-center py-4 text-muted">Список порожній</td></tr>
                        }
                        @foreach (var u in usersList.Where(u => u.IsBlocked == showBlockedUsers))
                        {
                            <tr style="@(u.IsBlocked ? "opacity: 0.6; background: #fafafa;" : "")">
                                <td style="font-weight:600;">@u.FullName</td>
                                <td>@u.Email</td>
                                <td><span class="badge bg-secondary bg-opacity-10 text-dark">@u.StoreName</span></td>
                                <td>
                                    @if (u.Role == "Admin")
                                    {
                                        <span class="badge bg-danger">Адмін</span>
                                    }
                                    else if (u.Role == "Technician")
                                    {

                                        <span class="badge bg-info text-dark">Майстер</span>
                                    }
                                    else
                                    {

                                        <span class="badge bg-primary">Менеджер</span>
                                    }
                                </td>
                                <td style="text-align: right; white-space: nowrap;">
                                    @if (!u.IsBlocked)
                                    {
                                        <button class="btn-apple outline me-2" style="padding: 4px 10px; font-size: 12px;" @onclick="() => OpenEditUserModal(u)"><i class="bi bi-pencil-square"></i></button>
                                        <button class="btn-apple outline" style="padding: 4px 10px; font-size: 12px; color: var(--apple-red); border-color: var(--apple-red);" title="Заблокувати" @onclick="() => BlockUser(u.Id, u.FullName)"><i class="bi bi-lock-fill"></i></button>
                                    }
                                    else
                                    {
                                        <button class="btn-apple outline" style="padding: 4px 10px; font-size: 12px; color: var(--apple-green); border-color: var(--apple-green);" title="Розблокувати" @onclick="() => UnblockUser(u.Id, u.FullName)"><i class="bi bi-unlock-fill"></i> Відновити</button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }

        else if (currentTab == "rules")
        {
            <div class="apple-card no-print">
                <div class="table-responsive">
                    <table class="apple-table align-middle">
                        <thead class="table-dark text-center">
                            <tr>
                                <th style="min-width: 150px;">Працівник</th>
                                <th>Ставка (грн)</th>
                                <th>Штраф (грн)</th>
                                <th>Бонус Техніка (грн)</th>
                                <th>Бонус Гарантія (грн)</th>
                                <th>Аксесуари (%)</th>
                                <th>Послуги (%)</th>
                                <th>Дія</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var rule in salaryRules)
                            {
                                <tr>
                                    <td class="fw-bold">
                                        @rule.EmployeeName <br />
                                        <span class="badge bg-secondary" style="font-size: 10px;">@rule.StoreName</span>
                                    </td>
                                    <td><input type="number" step="100" class="apple-input text-center" style="padding: 4px;" @bind="rule.MonthlyBaseSalary" /></td>
                                    <td><input type="number" step="10" class="apple-input text-center" style="padding: 4px;" @bind="rule.PenaltyPerLateness" /></td>
                                    <td><input type="number" step="10" class="apple-input text-center" style="padding: 4px;" @bind="rule.BonusPerDevice" /></td>
                                    <td><input type="number" step="10" class="apple-input text-center" style="padding: 4px;" @bind="rule.BonusPerWarranty" /></td>
                                    <td><input type="number" step="0.1" class="apple-input text-center" style="padding: 4px;" @bind="rule.AccessoryBonusPercent" /></td>
                                    <td><input type="number" step="0.1" class="apple-input text-center" style="padding: 4px;" @bind="rule.ServiceBonusPercent" /></td>
                                    <td class="text-center">
                                        <button class="btn-apple success" style="padding: 6px 12px; width: 100%;" @onclick="() => SaveRule(rule)">Зберегти</button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }

        else if (currentTab == "shifts")
        {
            <div class="apple-card no-print">
                <table class="apple-table">
                    <thead>
                        <tr>
                            <th>Працівник</th>
                            <th>Магазин</th>
                            <th>Дата</th>
                            <th>Відкриття</th>
                            <th>Закриття</th>
                            <th>Відпрацьовано</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!shifts.Any())
                        {
                            <tr><td colspan="6" class="text-center py-4 text-muted">Немає змін за цей період</td></tr>
                        }
                        @foreach (var s in shifts)
                        {
                            <tr>
                                <td style="font-weight:600;">@s.UserName</td>
                                <td><span class="badge bg-secondary bg-opacity-10 text-dark">@s.StoreName</span></td>
                                <td>@s.WorkDate.ToString("dd.MM.yyyy")</td>
                                <td style="color:var(--apple-green); font-weight:600;">@(s.ClockInTime?.ToString("HH:mm") ?? "—")</td>
                                <td style="color:var(--apple-red); font-weight:600;">@(s.ClockOutTime?.ToString("HH:mm") ?? "В роботі")</td>
                                <td>
                                    @if (s.ClockInTime.HasValue && s.ClockOutTime.HasValue)
                                    {
                                        var span = s.ClockOutTime.Value - s.ClockInTime.Value;
                                        <span>@Math.Floor(span.TotalHours) год @span.Minutes хв</span>
                                    }
                                    else
                                    {
                                        <span>—</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }

        else if (currentTab == "kpi")
        {
            <div class="apple-card no-print">
                <table class="apple-table">
                    <thead>
                        <tr>
                            <th>Менеджер</th>
                            <th>Продажі (Деталізація)</th>
                            <th>Загальна Каса</th>
                            <th>Загальний Прибуток</th>
                            <th style="text-align: right;">Дії</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!kpis.Any())
                        {
                            <tr><td colspan="5" class="text-center py-4 text-muted">Немає продажів за цей період</td></tr>
                        }
                        @foreach (var k in kpis.OrderByDescending(x => x.TotalProfitUSD))
                        {
                            <tr>
                                <td style="font-weight:600; font-size: 1.1rem; vertical-align: top; padding-top: 16px;">
                                    @k.UserName
                                    <div style="font-size: 12px; color: var(--apple-sub); font-weight: normal; margin-top: 4px;">Всього: @k.ItemsSold шт.</div>
                                </td>
                                <td style="padding-top: 12px;">
                                    @if (k.Devices.Count > 0)
                                    {
                                        <div class="kpi-cat-row"><span class="kpi-cat-name" style="color: var(--apple-blue);"><i class="bi bi-phone"></i> Техніка (@k.Devices.Count)</span><span class="kpi-cat-val">@k.Devices.RevenueUAH.ToString("N0") ₴</span><span class="kpi-cat-prof">+$@k.Devices.ProfitUSD.ToString("N0")</span></div>
                                    }
                                    @if (k.Accessories.Count > 0)
                                    {
                                        <div class="kpi-cat-row"><span class="kpi-cat-name" style="color: #e68600;"><i class="bi bi-headphones"></i> Аксесуари (@k.Accessories.Count)</span><span class="kpi-cat-val">@k.Accessories.RevenueUAH.ToString("N0") ₴</span><span class="kpi-cat-prof">+$@k.Accessories.ProfitUSD.ToString("N0")</span></div>
                                    }
                                    @if (k.Repairs.Count > 0)
                                    {
                                        <div class="kpi-cat-row"><span class="kpi-cat-name" style="color: var(--apple-red);"><i class="bi bi-tools"></i> Ремонти (@k.Repairs.Count)</span><span class="kpi-cat-val">@k.Repairs.RevenueUAH.ToString("N0") ₴</span><span class="kpi-cat-prof">+$@k.Repairs.ProfitUSD.ToString("N0")</span></div>
                                    }
                                    @if (k.Services.Count > 0)
                                    {
                                        <div class="kpi-cat-row"><span class="kpi-cat-name" style="color: #1a7a35;"><i class="bi bi-stars"></i> Послуги (@k.Services.Count)</span><span class="kpi-cat-val">@k.Services.RevenueUAH.ToString("N0") ₴</span><span class="kpi-cat-prof">+$@k.Services.ProfitUSD.ToString("N0")</span></div>
                                    }
                                    @if (k.Warranties.Count > 0)
                                    {
                                        <div class="kpi-cat-row"><span class="kpi-cat-name" style="color: #5856d6;"><i class="bi bi-shield-check"></i> Гарантії (@k.Warranties.Count)</span><span class="kpi-cat-val">@k.Warranties.RevenueUAH.ToString("N0") ₴</span><span class="kpi-cat-prof">+$@k.Warranties.ProfitUSD.ToString("N0")</span></div>
                                    }
                                </td>
                                <td style="font-weight:700; color:var(--apple-text); vertical-align: top; padding-top: 16px; font-size: 1.1rem;">@k.TotalRevenueUAH.ToString("N0") ₴</td>
                                <td style="font-weight:800; color:var(--apple-green); font-size:1.3rem; vertical-align: top; padding-top: 16px;">+$@k.TotalProfitUSD.ToString("N0")</td>
                                <td style="vertical-align: top; padding-top: 16px; text-align: right;"><button class="btn-apple outline" style="padding: 6px 12px; font-size: 12px;" @onclick="() => OpenKpiDetails(k)">Деталі</button></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }

        else if (currentTab == "payroll")
        {
            <div class="no-print" style="display: grid; grid-template-columns: 300px 1fr; gap: 20px;">
                <div class="apple-card" style="padding: 0; max-height: 70vh; overflow-y: auto;">
                    <div style="padding: 16px; background: #fafafa; border-bottom: 1px solid var(--apple-border); position: sticky; top: 0;">
                        <h6 style="margin: 0; font-weight: 700; color: var(--apple-sub);">СПИСОК ДО ОПЛАТИ</h6>
                    </div>
                    @if (!payrolls.Any())
                    {
                        <div class="text-center py-4 text-muted" style="font-size: 13px;">Немає розрахунків</div>
                    }
                    @foreach (var p in payrolls)
                    {
                        <div style="padding: 12px 16px; border-bottom: 1px solid #f0f0f0; cursor: pointer; background: @(selectedPayroll == p ? "rgba(0,113,227,0.05)" : "#fff"); border-left: @(selectedPayroll == p ? "4px solid var(--apple-blue)" : "4px solid transparent");"
                             @onclick="() => SelectPayroll(p)">
                            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 4px;">
                                <span style="font-weight: 600; font-size: 15px; color: var(--apple-text);">@p.EmployeeName</span>
                                @if (p.IsSaved)
                                {
                                    <i class="bi bi-check-circle-fill text-success" title="Збережено"></i>
                                }
                            </div>
                            <div style="font-size: 11px; color: var(--apple-sub); margin-bottom: 6px;">@p.StoreName</div>
                            <div style="display: flex; justify-content: space-between; align-items: center; font-size: 13px;">
                                <span class="text-muted">Нараховано:</span>
                                <span style="font-weight: 600;">@p.BaseSalaryCalculated.ToString("N0") ₴</span>
                            </div>
