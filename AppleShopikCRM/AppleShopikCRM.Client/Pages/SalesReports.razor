        bool confirm = await JS.InvokeAsync<bool>("confirm", "Ви дійсно хочете відв'язати клієнта від цього чеку?");
        if (!confirm) return;

        var res = await Http.PostAsync($"api/reports/remove-customer/{selectedSale.Id}", null);
        if (res.IsSuccessStatusCode)
