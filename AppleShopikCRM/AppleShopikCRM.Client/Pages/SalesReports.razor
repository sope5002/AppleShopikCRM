    private async Task RemoveItemFromReceipt(int saleItemId)
    {
        if (selectedSale == null) return;

        int randomCode = new Random().Next(1000, 9999);
        string? input = await JS.InvokeAsync<string>("prompt", $"Увага! Товар буде вилучено з чеку і повернено на склад.\nВведіть код для підтвердження: {randomCode}");

        if (input != randomCode.ToString())
        {
            await JS.InvokeVoidAsync("alert", "Невірний код. Дію скасовано.");
            return;
        }

        bool updateCash = await JS.InvokeAsync<bool>("confirm", "Оновити КАСУ?\n\n[ОК] - Відняти суму з сьогоднішнього доходу\n[Cancel] - Видалити товар без зміни каси");

        var payload = new { UpdateCash = updateCash };
        var res = await Http.PostAsJsonAsync($"api/reports/remove-item/{saleItemId}", payload);

        if (res.IsSuccessStatusCode)
        {
            await JS.InvokeVoidAsync("alert", "Товар успішно вилучено!");
            selectedSale = null;
            await LoadStockForSwaps();
            await LoadReport();
        }
        else
