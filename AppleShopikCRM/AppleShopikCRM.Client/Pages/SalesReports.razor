        int randomCode = new Random().Next(1000, 9999);
        string? input = await JS.InvokeAsync<string>("prompt", $"⚠️ УВАГА! Чек буде видалено, а товари повернуто на склад.\nВведіть код для підтвердження: {randomCode}");

        if (input != randomCode.ToString())
        {
            await JS.InvokeVoidAsync("alert", "Невірний код. Дію скасовано.");
            return;
        }

        bool updateCash = await JS.InvokeAsync<bool>("confirm", "Оновити КАСУ?\n\n[ОК] - Списати суму чеку з каси\n[Cancel] - Видалити без зміни каси");

        var res = await Http.DeleteAsync($"api/reports/delete-receipt/{selectedSale.Id}?updateCash={updateCash}");

        if (res.IsSuccessStatusCode)
