@page "/sales-reports"

@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@using System.Net.Http.Json

@inject HttpClient Http
@inject AuthenticationStateProvider AuthStateProvider
@inject IJSRuntime JS
@rendermode InteractiveWebAssembly

<PageTitle>Звіти продажів — Apple Shopik</PageTitle>

<style>
    .report-root {
        padding: 24px;
        background: var(--apple-gray, #f5f5f7);
        min-height: 100vh;
        font-family: -apple-system, sans-serif;
    }

    .header-bar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 24px;
        flex-wrap: wrap;
        gap: 16px;
    }

    .filter-bar {
        background: #fff;
        padding: 10px 16px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        gap: 12px;
        box-shadow: 0 1px 3px rgba(0,0,0,.04);
        border: 1px solid #d2d2d7;
        flex-wrap: wrap;
    }

    .apple-input {
        border: 1px solid #d2d2d7;
        border-radius: 8px;
        padding: 8px 12px;
        font-size: 14px;
        outline: none;
        background: #fff;
    }

    .btn-apple {
        border: none;
        border-radius: 8px;
        padding: 8px 16px;
        font-size: 14px;
        font-weight: 600;
        cursor: pointer;
        background: #0071e3;
        color: #fff;
        transition: 0.2s;
        display: inline-flex;
        align-items: center;
        gap: 6px;
    }

        .btn-apple:hover {
            background: #0077ed;
        }

        .btn-apple.outline {
            background: transparent;
            border: 1.5px solid #d2d2d7;
            color: #1d1d1f;
        }

            .btn-apple.outline:hover {
                background: #f5f5f7;
            }

        .btn-apple.danger {
            background: #ff3b30;
            color: #fff;
        }

        .btn-apple.success {
            background: #34c759;
            color: #fff;
        }

    .summary-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
        gap: 16px;
        margin-bottom: 24px;
    }

    .summary-card {
        background: #fff;
        padding: 16px 20px;
        border-radius: 16px;
        box-shadow: 0 2px 8px rgba(0,0,0,.04);
        border: 1px solid #d2d2d7;
        display: flex;
        align-items: center;
        gap: 16px;
    }

    .sc-icon {
        width: 48px;
        height: 48px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 24px;
    }

    .sc-title {
        font-size: 12px;
        color: #6e6e73;
        font-weight: 700;
        margin: 0 0 4px 0;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .sc-value {
        font-size: 22px;
        font-weight: 700;
        color: #1d1d1f;
        margin: 0;
    }

    .seg-tabs {
        display: flex;
        background: #e9e9eb;
        border-radius: 10px;
        padding: 4px;
        gap: 4px;
        width: fit-content;
        flex-wrap: wrap;
        margin-bottom: 0;
    }

    .seg-tab {
        border: none;
        background: transparent;
        border-radius: 8px;
        padding: 8px 24px;
        font-size: 14px;
        font-weight: 600;
        color: #6e6e73;
        cursor: pointer;
        transition: all 0.2s;
    }

        .seg-tab.active {
            background: #fff;
            color: #1d1d1f;
            box-shadow: 0 2px 6px rgba(0,0,0,.1);
        }

    .apple-card {
        background: #fff;
        border-radius: 16px;
        box-shadow: 0 4px 16px rgba(0,0,0,.05);
        overflow: hidden;
        border: 1px solid #d2d2d7;
    }

    .apple-table {
        width: 100%;
        border-collapse: collapse;
    }

        .apple-table th {
            padding: 14px 20px;
            font-size: 12px;
            color: #6e6e73;
            text-transform: uppercase;
            border-bottom: 1px solid #d2d2d7;
            text-align: left;
            background: #fafafa;
        }

        .apple-table td {
            padding: 14px 20px;
            font-size: 14px;
            border-bottom: 1px solid #f0f0f0;
            color: #1d1d1f;
            vertical-align: middle;
        }

    .tab-details-panel {
        background: #fff;
        padding: 16px 20px;
        border-radius: 12px;
        border: 1px solid #d2d2d7;
        margin-bottom: 20px;
        display: flex;
        flex-wrap: wrap;
        gap: 20px;
        align-items: center;
    }

    .detail-item {
        padding-right: 20px;
        border-right: 1px solid #e5e5ea;
    }

        .detail-item:last-child {
            border-right: none;
            padding-right: 0;
        }

    .modal-backdrop-apple {
        position: fixed;
        inset: 0;
        background: rgba(0,0,0,.45);
        z-index: 1050;
        display: flex;
        align-items: center;
        justify-content: center;
        backdrop-filter: blur(4px);
    }

    .modal-sheet {
        background: #fff;
        border-radius: 18px;
        width: 100%;
        max-width: 800px;
        max-height: 90vh;
        display: flex;
        flex-direction: column;
        box-shadow: 0 20px 60px rgba(0,0,0,.2);
    }

    .ms-header {
        padding: 16px 24px;
        border-bottom: 1px solid #d2d2d7;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .ms-body {
        padding: 24px;
        overflow-y: auto;
        background: #fafafa;
    }

    .ms-footer {
        padding: 16px 24px;
        border-top: 1px solid #d2d2d7;
        display: flex;
        justify-content: flex-end;
        gap: 10px;
        background: #fff;
        border-radius: 0 0 18px 18px;
    }

    .payment-tag {
        display: inline-block;
        padding: 4px 8px;
        background: #f5f5f7;
        border-radius: 6px;
        font-size: 11px;
        font-weight: 600;
        color: #6e6e73;
        margin-right: 4px;
        margin-bottom: 4px;
        border: 1px solid #e5e5ea;
    }

    .search-container {
        position: relative;
        width: 250px;
        flex-shrink: 0;
    }

    .search-icon {
        position: absolute;
        left: 12px;
        top: 50%;
        transform: translateY(-50%);
        color: #6e6e73;
    }

    .autocomplete-dropdown {
        position: absolute;
        top: 100%;
        left: 0;
        right: 0;
        background: #fff;
        border: 1px solid #d2d2d7;
        border-radius: 8px;
        box-shadow: 0 8px 24px rgba(0,0,0,0.12);
        z-index: 9999;
        max-height: 250px;
        overflow-y: auto;
        margin-top: 4px;
    }

    .ac-item {
        padding: 10px 14px;
        cursor: pointer;
        font-size: 13px;
        border-bottom: 1px solid #f0f0f0;
        display: flex;
        flex-direction: column;
    }

        .ac-item:last-child {
            border-bottom: none;
        }

        .ac-item:hover {
            background: #f5f5f7;
            color: #0071e3;
        }

    .w-card {
        display: flex;
        align-items: center;
        justify-content: space-between;
        border: 1.5px solid var(--apple-border);
        border-radius: 12px;
        padding: 16px;
        margin-bottom: 10px;
        cursor: pointer;
        transition: all 0.2s ease;
        background: #fff;
    }

        .w-card:hover {
            border-color: #a1a1a6;
            box-shadow: 0 4px 10px rgba(0,0,0,0.05);
        }

        .w-card.active {
            border-color: var(--apple-blue);
            background: rgba(0, 113, 227, 0.05);
            box-shadow: 0 0 0 1px var(--apple-blue);
        }

    .w-left {
        display: flex;
        flex-direction: column;
        gap: 4px;
    }

    .w-title {
        font-size: 16px;
        font-weight: 700;
        color: var(--apple-text);
    }

    .w-sub {
        font-size: 13px;
        color: var(--apple-sub);
    }

    .w-right {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .w-price {
        font-size: 16px;
        font-weight: 700;
        color: var(--apple-text);
    }

    .w-price-edit {
        width: 85px;
        padding: 6px 8px;
        font-size: 16px;
        font-weight: 700;
        text-align: right;
        border: 1.5px solid var(--apple-blue);
        border-radius: 8px;
        outline: none;
        color: var(--apple-blue);
        background: #fff;
    }

    .w-check {
        width: 24px;
        height: 24px;
        background: var(--apple-blue);
        color: #fff;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 12px;
    }
</style>

<div class="report-root">
    <div class="header-bar">
        <h2 style="margin: 0; font-weight: 700;"><i class="bi bi-receipt me-2" style="color: #0071e3;"></i>Звіт про продажі</h2>

        <div class="filter-bar">
            <AuthorizeView Roles="Admin">
                <Authorized>
                    <div class="d-flex align-items-center gap-2 border-end pe-3 me-1">
                        <i class="bi bi-shop text-muted"></i>
                        <select class="apple-input" @bind="selectedStoreId" style="min-width: 150px; border: none; background: #f5f5f7;">
                            @foreach (var store in stores)
                            {
                                <option value="@store.Id">@store.Name</option>
                            }
                        </select>
                    </div>
                </Authorized>
            </AuthorizeView>

            <i class="bi bi-calendar3 text-muted"></i>
            <input type="date" class="apple-input" style="border:none; padding:0; width: 110px;" @bind="startDate" />
            <span class="text-muted">—</span>
            <input type="date" class="apple-input" style="border:none; padding:0; width: 110px;" @bind="endDate" />
            <button class="btn-apple ms-2" @onclick="LoadReport"><i class="bi bi-search"></i> Показати</button>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger mx-auto" style="max-width: 800px; border-radius: 12px;">
            <i class="bi bi-exclamation-octagon-fill me-2"></i>
            <strong>Упс! Щось пішло не так:</strong>
            <p class="mb-0 mt-2" style="font-family: monospace; font-size: 13px;">@errorMessage</p>
            <button class="btn btn-sm btn-outline-danger mt-3" @onclick="LoadReport">Спробувати знову</button>
        </div>
    }

    @if (isLoading)
    {
        <div class="text-center py-5 text-muted">
            <div class="spinner-border" role="status"></div>
            <p class="mt-2">Завантаження звіту...</p>
        </div>
    }
    else if (reportData != null && string.IsNullOrEmpty(errorMessage))
    {
        <div style="font-size: 13px; color: #6e6e73; font-weight: 700; text-transform: uppercase; margin-bottom: 12px; letter-spacing: 0.5px;">
            <i class="bi bi-globe me-1"></i> Загальна каса за період
        </div>
        <div class="summary-grid">
            <div class="summary-card">
                <div class="sc-icon" style="background: rgba(52,199,89,.1); color: #34c759;"><i class="bi bi-cash"></i></div>
                <div>
                    <h4 class="sc-title">Готівка UAH</h4>
                    <p class="sc-value">@reportData.Totals.UAH.ToString("N0") ₴</p>
                </div>
            </div>
            <div class="summary-card">
                <div class="sc-icon" style="background: rgba(175,82,222,.1); color: #af52de;"><i class="bi bi-credit-card"></i></div>
                <div>
                    <h4 class="sc-title">Термінал / Карта</h4>
                    <p class="sc-value">@reportData.Totals.Card.ToString("N0") ₴</p>
                </div>
            </div>
            <div class="summary-card">
                <div class="sc-icon" style="background: rgba(0,113,227,.1); color: #0071e3;"><i class="bi bi-currency-dollar"></i></div>
                <div>
                    <h4 class="sc-title">Готівка USD</h4>
                    <p class="sc-value">@reportData.Totals.USD.ToString("N0") $</p>
                </div>
            </div>
            <div class="summary-card">
                <div class="sc-icon" style="background: rgba(255,149,0,.1); color: #ff9500;"><i class="bi bi-currency-euro"></i></div>
                <div>
                    <h4 class="sc-title">Готівка EUR</h4>
                    <p class="sc-value">@reportData.Totals.EUR.ToString("N0") €</p>
                </div>
            </div>
        </div>

        <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 10px; margin-bottom: 16px;">
            <div class="seg-tabs">
                <button class='seg-tab @(activeTab == "List" ? "active" : "")' @onclick='() => activeTab = "List"'>
                    <i class="bi bi-list-ul me-1"></i> Список чеків
                </button>
                <button class='seg-tab @(activeTab == "Device" ? "active" : "")' @onclick='() => activeTab = "Device"'>
                    <i class="bi bi-phone me-1"></i> Техніка
                </button>
                <button class='seg-tab @(activeTab == "Accessory" ? "active" : "")' @onclick='() => activeTab = "Accessory"'>
                    <i class="bi bi-headphones me-1"></i> Аксесуари
                </button>
                <button class='seg-tab @(activeTab == "Service" ? "active" : "")' @onclick='() => activeTab = "Service"'>
                    <i class="bi bi-tools me-1"></i> Ремонти
                </button>
                <button class='seg-tab @(activeTab == "PosService" ? "active" : "")' @onclick='() => activeTab = "PosService"'>
                    <i class="bi bi-stars me-1"></i> Швидкі послуги
                </button>
            </div>

            @* Глобальний пошук красиво вбудований в рядок з табами *@
            <div class="search-container ms-auto d-flex gap-2">
                <div style="position: relative; flex:1;">
                    <i class="bi bi-search search-icon"></i>
                    <input type="text" class="apple-input" style="width:100%; padding-left: 36px; border-radius:20px;" placeholder="Пошук (ID, ТТН, IMEI)..." @bind="globalSearchQuery" @onkeyup="HandleGlobalSearchEnter" />
                </div>
                <button class="btn-apple" style="border-radius: 20px; white-space: nowrap; padding: 6px 16px;" @onclick="ExecuteGlobalSearch">Шукати</button>
            </div>
        </div>

        @if (activeTab == "List")
        {
            <div class="apple-card">
                <table class="apple-table">
                    <thead>
                        <tr>
                            <th style="width: 50px; text-align: center;">ID</th>
                            <th>Дата / Час</th>
                            <th>Клієнт / Продавець</th>
                            <th>Оплата</th>
                            <th>Сума чека</th>
                            <th style="text-align: right;">Дії</th>
                        </tr>
                    </thead>
                    <tbody>
                        <Virtualize TItem="ReceiptDto" Items="FilteredReceipts" Context="sale">
                            <tr>
                                <td style="font-weight:700; color:#6e6e73; text-align: center;">
                                    <div style="font-size: 14px;">#@sale.Id</div>
                                    <div style="font-size: 16px; margin-top: 4px;" title="@sale.Source">
                                        @if (sale.Source == "Instagram")
                                        {
                                            <i class="bi bi-instagram" style="color:#E1306C;"></i>
                                        }
                                        else if (sale.Source == "Telegram")
                                        {

                                            <i class="bi bi-telegram" style="color:#0088cc;"></i>
                                        }
                                        else
                                        {

                                            <i class="bi bi-shop" style="color:#6e6e73;"></i>
                                        }
                                    </div>
                                </td>
                                <td>
                                    <div style="font-weight:600; color:#1d1d1f;">@sale.Date.ToString("dd.MM.yyyy HH:mm")</div>
                                    <div style="font-size: 11px; color: #6e6e73; margin-top: 2px;">@sale.ItemsCount товарів</div>
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(sale.CustomerName))
                                    {
                                        <div style="font-weight:700; color:#0071e3; font-size:13px;"><i class="bi bi-person-fill"></i> @sale.CustomerName</div>
                                    }
                                    <div style="font-size:12px; color:#6e6e73; margin-top: 2px;">Продавець: @sale.CashierName</div>
                                </td>
                                <td>
                                    <div style="display:flex; flex-wrap:wrap; max-width: 250px;">
                                        @foreach (var p in sale.Payments)
                                        {
                                            string sym = p.Method.Contains("USD") ? "$" : (p.Method.Contains("EUR") ? "€" : "₴");
                                            <span class="payment-tag">
                                                @p.Method: <strong>@p.Amount.ToString("N0") @sym</strong>
                                            </span>
                                        }
                                    </div>
                                </td>
                                <td>
                                    <span style="font-weight:700;">@sale.FinalAmount.ToString("N0") ₴</span>
                                </td>
                                <td style="text-align: right;">
                                    <button class="btn-apple outline" style="padding: 6px 12px; font-size: 12px;" @onclick="() => OpenReceiptDetails(sale)">
                                        Деталі
                                    </button>
                                </td>
                            </tr>
                        </Virtualize>
                        @if (!FilteredReceipts.Any())
                        {
                            <tr><td colspan="6" class="text-center py-5 text-muted">За обраний період чеків немає.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            @* Ледаче (Lazy) формування списку тільки для відкритої вкладки *@
            var filteredItems = reportData.Items.Where(i => i.ItemType == activeTab).ToList();
            int tabTotalCount = filteredItems.Sum(i => i.Quantity);
            decimal tabTotalPrice = filteredItems.Sum(i => i.Price);

            <div class="tab-details-panel shadow-sm">
                <div class="detail-item">
                    <div style="font-size: 12px; color: #6e6e73; font-weight: 600; text-transform: uppercase;">
                        Всього продано (@(activeTab == "Device" ? "Техніка" : activeTab == "Accessory" ? "Аксесуари" : activeTab == "Service" ? "Ремонти" : "Швидкі послуги"))
                    </div>
                    <div style="font-size: 20px; font-weight: 700; color: #1d1d1f; margin-top: 2px;">
                        @tabTotalCount <span style="font-size: 14px; font-weight: 600;">од.</span>
                    </div>
                </div>

                <div class="detail-item" style="border-right: 2px dashed #e5e5ea; padding-right: 24px; margin-right: 4px;">
                    <div style="font-size: 12px; color: #6e6e73; font-weight: 600; text-transform: uppercase;">
                        Вартість товарів
                    </div>
                    <div style="font-size: 20px; font-weight: 700; color: #1d1d1f; margin-top: 2px;">
                        @tabTotalPrice.ToString("N0") <span style="font-size: 14px; font-weight: 600;">₴</span>
                    </div>
                </div>

                @{
                    var tabBreakdown = filteredItems
                    .GroupBy(i => i.SaleId)
                    .Select(g => g.First())
                    .SelectMany(i => i.Payments)
                    .GroupBy(p => p.Method)
                    .Select(g => new { Method = g.Key, TotalSum = g.Sum(x => x.Amount) })
                    .OrderByDescending(x => x.TotalSum)
                    .ToList();

                    foreach (var p in tabBreakdown)
                    {
                        string sym = p.Method.Contains("USD") ? "$" : (p.Method.Contains("EUR") ? "€" : "₴");
                        <div class="detail-item" style="border-right: none;">
                            <div style="font-size: 12px; color: #0071e3; font-weight: 600; text-transform: uppercase;">Отримано (@p.Method)</div>
                            <div style="font-size: 18px; font-weight: 700; color: #1d1d1f; margin-top: 2px;">
                                @p.TotalSum.ToString("N0") <span style="font-size: 14px; color: #6e6e73;">@sym</span>
                            </div>
                        </div>
                    }
                }
            </div>

            @if (filteredItems.Any())
            {
                <div class="apple-card">
                    <table class="apple-table">
                        <thead>
                            <tr>
                                <th>Дата та Час</th>
                                <th>Назва товару / послуги</th>
                                <th>Категорія</th>
                                <th>К-сть</th>
                                <th>Ціна товару</th>
                                <th>Продавець</th>
                            </tr>
                        </thead>
                        <tbody>
                            <Virtualize TItem="SaleItemDto" Items="filteredItems" Context="item">
                                <tr>
                                    <td style="color: #6e6e73;">@item.Date.ToString("dd.MM.yyyy HH:mm")</td>
                                    <td style="font-weight: 600;">@item.ItemName</td>
                                    <td>
                                        @if (item.ItemType == "Accessory")
                                        {
                                            <span class="badge bg-secondary bg-opacity-10 text-dark">Аксесуар</span>
                                        }
                                        else if (item.ItemType == "Device")
                                        {

                                            <span class="badge bg-primary bg-opacity-10 text-primary">Техніка</span>
                                        }
                                        else if (item.ItemType == "Service")
                                        {

                                            <span class="badge bg-warning bg-opacity-10 text-dark">Ремонт</span>
                                        }
                                        else if (item.ItemType == "PosService")
                                        {

                                            <span class="badge bg-info bg-opacity-10 text-dark"><i class="bi bi-stars"></i> Послуга</span>
                                        }
                                        else
                                        {

                                            <span class="badge bg-light text-dark">Інше</span>
                                        }
                                    </td>
                                    <td><span style="font-weight: 600;">@item.Quantity</span> шт</td>
                                    <td style="font-weight: 600; color: #1d1d1f; font-size: 15px;">@item.Price.ToString("N0") ₴</td>
                                    <td>@item.Cashier</td>
                                </tr>
                            </Virtualize>
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5 text-muted">За обраний період продажів немає.</div>
            }
        }
    }
</div>

@* ── МОДАЛКА З ДЕТАЛЯМИ ЧЕКУ ── *@
@if (selectedSale != null)
{
    <div class="modal-backdrop-apple" @onclick="CloseReceiptDetails">
        <div class="modal-sheet" @onclick:stopPropagation>
            <div class="ms-header">
                <div>
                    <h3 style="font-size:1.2rem; font-weight:700; margin:0; display:flex; align-items:center;">
                        Чек #@selectedSale.Id
                        @if (isAdmin)
                        {
                            <span class="badge bg-dark ms-2" style="font-size: 10px;">Admin Mode</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary ms-2" style="font-size: 10px;">Manager Mode</span>
                        }
                    </h3>
                    <div style="font-weight:400; color:#6e6e73; font-size:12px; margin-top: 4px;">@selectedSale.Date.ToString("dd.MM.yyyy HH:mm") | Продавець: @selectedSale.CashierName</div>
                </div>
                <button style="border:none; background:transparent; cursor:pointer; font-size:20px;" @onclick="CloseReceiptDetails">✕</button>
            </div>

            <div class="ms-body">

                @* ПАНЕЛЬ ОНОВЛЕННЯ ДЖЕРЕЛА ТА ТТН *@
                <div style="background: #fff; border: 1px solid #d2d2d7; border-radius: 12px; padding: 12px 16px; margin-bottom: 20px;">
                    <div style="font-size: 12px; font-weight: 700; color: #1d1d1f; margin-bottom: 8px;">Деталі відправки / Джерело</div>
                    <div style="display: flex; gap: 16px; align-items: flex-end; flex-wrap: wrap;">
                        <div style="flex: 2; min-width: 250px;">
                            <label class="apple-label" style="margin-top: 0;">Джерело</label>
                            <div style="display: flex; gap: 8px;">
                                <button class="btn-apple @(editSource == "Offline" ? "primary" : "outline")" style="padding: 6px 12px; font-size: 12px; flex:1; justify-content:center;" @onclick='() => SetSource("Offline")' disabled="@(!isAdmin)"><i class="bi bi-shop"></i> Офлайн</button>
                                <button class="btn-apple @(editSource == "Instagram" ? "primary" : "outline")" style="padding: 6px 12px; font-size: 12px; flex:1; justify-content:center;" @onclick='() => SetSource("Instagram")' disabled="@(!isAdmin)"><i class="bi bi-instagram"></i> Instagram</button>
                                <button class="btn-apple @(editSource == "Telegram" ? "primary" : "outline")" style="padding: 6px 12px; font-size: 12px; flex:1; justify-content:center;" @onclick='() => SetSource("Telegram")' disabled="@(!isAdmin)"><i class="bi bi-telegram"></i> Telegram</button>
                            </div>
                        </div>
                        <div style="flex: 1; min-width: 180px;">
                            <label class="apple-label" style="margin-top: 0;">ТТН Нової Пошти</label>
                            <input type="text" class="apple-input" placeholder="Наприклад: 20450..." @bind="editTrackingNumber" disabled="@(!isAdmin && !string.IsNullOrWhiteSpace(selectedSale.TrackingNumber))" />
                        </div>
                        <button class="btn-apple outline" style="padding: 10px 16px;" @onclick="SaveReceiptDetails">Зберегти деталі</button>
                    </div>
                </div>

                @* ПАНЕЛЬ КЛІЄНТА *@
                @if (!string.IsNullOrEmpty(selectedSale.CustomerName))
                {
                    <div style="background: rgba(52,199,89,.05); border: 1px solid rgba(52,199,89,.2); border-radius: 12px; padding: 12px 16px; margin-bottom: 20px; display: flex; justify-content: space-between; align-items: center;">
                        <div>
                            <div style="font-size: 12px; font-weight: 700; color: #34c759; margin-bottom: 4px;"><i class="bi bi-person-check-fill me-1"></i> Клієнт чеку</div>
                            <div style="font-size: 15px; font-weight: 700; color: #1d1d1f;">
                                @selectedSale.CustomerName
                                <span style="font-weight: 600; color: #6e6e73; margin-left: 6px; font-family: monospace;">@selectedSale.CustomerPhone</span>
                            </div>
                        </div>
                        @if (isAdmin)
                        {
                            <button class="btn-apple outline" style="padding: 6px 12px; font-size: 12px; color: var(--apple-red); border-color: var(--apple-red);" @onclick="UnlinkCustomer">
                                <i class="bi bi-x-circle"></i> Відв'язати
                            </button>
                        }
                    </div>
                }
                else
                {
                    <div style="background: rgba(0,113,227,.05); border: 1px solid rgba(0,113,227,.2); border-radius: 12px; padding: 12px 16px; margin-bottom: 20px;">
                        <div style="font-size: 12px; font-weight: 700; color: #0071e3; margin-bottom: 8px;"><i class="bi bi-person-plus-fill me-1"></i> Прив'язати клієнта до чеку</div>
                        <div style="display: flex; gap: 10px; align-items: flex-start;">
                            <div style="position: relative; flex: 1;">
                                <input type="text" class="apple-input" placeholder="Телефон (напр: 097...) або Ім'я" @bind="customerPhone" @oninput="OnCustomerPhoneInput" autocomplete="off" />
                                @if (customerSuggestions.Any())
                                {
                                    <div class="autocomplete-dropdown">
                                        @foreach (var c in customerSuggestions)
                                        {
                                            <div class="ac-item" @onclick="() => SelectCustomer(c)">
                                                <strong style="color:var(--apple-text);">@c.Phone</strong> <span style="color:#6e6e73; font-size:12px;">- @c.Name</span>
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                            <input type="text" class="apple-input" placeholder="Ім'я (необов'язково)" @bind="customerName" style="flex: 1;" />
                            <button class="btn-apple outline" style="padding: 10px 12px;" @onclick="AssignCustomer">Зберегти</button>
                        </div>
                    </div>
                }

                <div style="display:flex; justify-content:space-between; margin-bottom:12px; font-size:11px; text-transform:uppercase; font-weight:700; color:#6e6e73; padding:0 8px;">
                    <div>Товар / Послуга</div>
                    <div style="text-align:right;">Вартість</div>
                </div>

                @if (selectedSale.Items != null && selectedSale.Items.Any())
                {
                    @foreach (var item in selectedSale.Items)
                    {
                        <div style="padding: 12px 16px; border-bottom: 1px solid #d2d2d7; background: #fff; border-radius: 8px; margin-bottom: 8px;">
                            <div style="display: flex; justify-content: space-between; align-items: center;">
                                <div>
                                    <div style="font-size:15px; font-weight:700; color:#1d1d1f;">@item.ModelName <span style="color:#6e6e73; font-weight:400; font-size:13px;">x @item.Quantity шт.</span></div>
                                    <div style="font-size:12px; color:#6e6e73;">@item.Type</div>
                                </div>

                                <div style="text-align: right;">
                                    <div style="font-size:16px; font-weight:800;">
                                        @((item.SellingPrice * item.Quantity).ToString("N0")) ₴
                                        @if (item.Type == "Device" || item.Type == "Accessory")
                                        {
                                            <span style="font-size: 13px; color: #6e6e73; font-weight: 600; margin-left: 4px;">
                                                ($@(item.SellingPriceUSD* item.Quantity))
                                            </span>
                                        }
                                    </div>
                                    @if (item.WarrantyPrice > 0)
                                    {
                                        <div style="margin-top: 4px;">
                                            <span style="font-size:12px; color:#0071e3; font-weight:600;"><i class="bi bi-shield-check me-1"></i>Гарантія: </span>
                                            <span style="font-size:13px; font-weight:700;">+@item.WarrantyPrice.ToString("N0") ₴</span>
                                        </div>
                                    }
                                </div>
                            </div>

                            @* ПАНЕЛЬ ДІЙ З ТОВАРОМ *@
                            <div style="display: flex; justify-content: flex-end; gap: 8px; margin-top: 10px; padding-top: 10px; border-top: 1px dashed #f0f0f0;">
                                @if (isAdmin)
                                {
                                    @if (item.Type == "Device" && item.WarrantyPrice == 0)
                                    {
                                        <button class="btn-apple outline" style="padding: 4px 10px; font-size: 11px; color: #34c759; border-color: #34c759;" @onclick="() => OpenAddWarrantyModal(item)">
                                            <i class="bi bi-shield-plus"></i> Додати гарантію
                                        </button>
                                    }

                                    <button class="btn-apple outline" style="padding: 4px 10px; font-size: 11px; color: #ff3b30; border-color: #ff3b30;" @onclick="() => RemoveItemFromReceipt(item.Id)">
                                        <i class="bi bi-trash"></i> Вилучити з чеку
                                    </button>

                                    @if (item.Type == "Accessory" || item.Type == "Device")
                                    {
                                        <button class="btn-apple outline" style="padding: 4px 10px; font-size: 11px;" @onclick="() => OpenItemSwap(item)">
                                            <i class="bi bi-arrow-left-right"></i> Замінити
                                        </button>
                                    }
                                    <button class="btn-apple outline" style="padding: 4px 10px; font-size: 11px;" @onclick="() => OpenPriceEdit(item)">
                                        <i class="bi bi-pencil"></i> Змінити ціну
                                    </button>
                                }
                            </div>

                            @* БЛОК РЕДАГУВАННЯ ЦІНИ *@
                            @if (isAdmin && editingItemId == item.Id && !isSwappingItem)
                            {
                                <div style="margin-top: 10px; padding: 10px; background: #fafafa; border-radius: 8px; border: 1px solid #d2d2d7; display: flex; gap: 10px; align-items: center;">
                                    <span style="font-size: 12px; font-weight: 600;">Нова ціна (за 1 шт):</span>
                                    <input type="number" class="apple-input" style="width: 100px; padding: 4px 8px;" @bind="newEditPrice" />
                                    <button class="btn-apple success" style="padding: 4px 12px; font-size: 12px;" @onclick="() => SaveNewPrice(item.Id)">Зберегти</button>
                                    <button class="btn-apple outline" style="padding: 4px 8px; font-size: 12px; border: none;" @onclick="() => editingItemId = 0">✕</button>
                                </div>
                            }

                            @* БЛОК ЗАМІНИ ТОВАРУ (АВТОПОШУК) *@
                            @if (isAdmin && editingItemId == item.Id && isSwappingItem)
                            {
                                <div style="margin-top: 10px; padding: 12px; background: #fdfdfd; border-radius: 8px; border: 1px solid var(--apple-blue);">
                                    <div style="font-size: 12px; font-weight: 700; color: var(--apple-blue); margin-bottom: 8px;">Оберіть новий товар на заміну (зі складу):</div>

                                    <div style="position: relative; margin-bottom: 12px;">
                                        <input type="text" class="apple-input" placeholder="🔍 Почніть вводити назву або IMEI..."
                                               value="@swapSearchTerm" @oninput="OnSwapSearchInput" @onfocus="() => isSwapDropdownOpen = true" autocomplete="off" style="padding: 8px 12px; font-size: 13px; width: 100%;" />

                                        @if (isSwapDropdownOpen && newSwapStockId == 0 && !string.IsNullOrWhiteSpace(swapSearchTerm))
                                        {
                                            <div class="autocomplete-dropdown">
                                                @if (swapItemType == "Accessory")
                                                {
                                                    var filteredAccs = GetFilteredAccessories(swapSearchTerm);
                                                    if (filteredAccs.Any())
                                                    {
                                                        foreach (var a in filteredAccs)
                                                        {
                                                            <div class="ac-item" @onclick='() => SelectSwapAccessory(a)'>
                                                                <strong style="color:var(--apple-text); font-size: 14px;">@a.ModelName</strong>
                                                                <span style="color:#6e6e73; font-size:12px; margin-top:2px;">Ціна: @a.SellingPrice ₴ | Залишок: @a.Quantity шт.</span>
                                                            </div>
                                                        }
                                                    }
                                                    else
                                                    {
                                                        <div class="ac-item text-muted">Нічого не знайдено</div>
                                                    }
                                                }
                                                else if (swapItemType == "Device")
                                                {
                                                    var filteredDevs = GetFilteredDevices(swapSearchTerm);
                                                    if (filteredDevs.Any())
                                                    {
                                                        foreach (var d in filteredDevs)
                                                        {
                                                            <div class="ac-item" @onclick='() => SelectSwapDevice(d)'>
                                                                <strong style="color:var(--apple-text); font-size: 14px;">@d.ModelName @d.Capacity @d.Color</strong>
                                                                <span style="color:#6e6e73; font-size:12px; font-family: monospace; margin-top:2px;">IMEI: @d.Identifier | Ціна: @d.SellingPrice ₴</span>
                                                            </div>
                                                        }
                                                    }
                                                    else
                                                    {
                                                        <div class="ac-item text-muted">Нічого не знайдено</div>
                                                    }
                                                }
                                            </div>
                                        }
                                    </div>

                                    <div style="display: flex; gap: 10px; align-items: center; justify-content: flex-end;">
                                        @if (newSwapStockId > 0)
                                        {
                                            <span style="font-size: 12px; color: var(--apple-green); font-weight: 600; flex: 1;"><i class="bi bi-check-circle-fill"></i> Готово до заміни</span>
                                        }
                                        <button class="btn-apple primary" style="padding: 6px 12px; font-size: 12px;" @onclick="() => ConfirmSwapItem(item.Id)" disabled="@(newSwapStockId == 0)">Замінити</button>
                                        <button class="btn-apple outline" style="padding: 6px 8px; font-size: 12px; border: none;" @onclick='() => { editingItemId = 0; swapSearchTerm = ""; newSwapStockId = 0; isSwapDropdownOpen = false; }'>✕</button>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                }

                @* 🔥 ДОДАВАННЯ НОВОГО ТОВАРУ В ЧЕК *@
                @if (isAdmin)
                {
                    <div style="margin-top: 20px; border-top: 2px dashed #d2d2d7; padding-top: 20px;">
                        @if (!isAddingNewItem)
                        {
                            <button class="btn-apple outline" style="width: 100%; justify-content: center; border-style: dashed;" @onclick='() => { isAddingNewItem = true; newItemType = "Accessory"; newItemSearchTerm = ""; }'>
                                <i class="bi bi-plus-circle me-1"></i> Додати товар у чек
                            </button>
                        }
                        else
                        {
                            <div style="background: #fafafa; padding: 16px; border-radius: 12px; border: 1px solid #d2d2d7;">
                                <div style="font-size: 13px; font-weight: 700; margin-bottom: 12px;">Додавання нового товару</div>
                                <div style="display: flex; gap: 10px; margin-bottom: 12px;">
                                    <button class="btn-apple @(newItemType == "Accessory" ? "primary" : "outline")" style="flex:1; justify-content: center;" @onclick='() => { newItemType = "Accessory"; newItemSearchTerm = ""; newItemStockId = 0; }'>Аксесуари</button>
                                    <button class="btn-apple @(newItemType == "Device" ? "primary" : "outline")" style="flex:1; justify-content: center;" @onclick='() => { newItemType = "Device"; newItemSearchTerm = ""; newItemStockId = 0; }'>Техніка</button>
                                </div>

                                <div style="position: relative; margin-bottom: 16px;">
                                    <input type="text" class="apple-input" placeholder="🔍 Введіть назву або IMEI..."
                                           value="@newItemSearchTerm" @oninput="OnNewItemSearchInput" @onfocus="() => isNewItemDropdownOpen = true" autocomplete="off" style="padding: 8px 12px;" />

                                    @if (isNewItemDropdownOpen && newItemStockId == 0 && !string.IsNullOrWhiteSpace(newItemSearchTerm))
                                    {
                                        <div class="autocomplete-dropdown">
                                            @if (newItemType == "Accessory")
                                            {
                                                var filteredAccs = GetFilteredAccessories(newItemSearchTerm);
                                                if (filteredAccs.Any())
                                                {
                                                    foreach (var a in filteredAccs)
                                                    {
                                                        <div class="ac-item" @onclick='() => SelectNewAccessory(a)'>
                                                            <strong style="color:var(--apple-text); font-size: 14px;">@a.ModelName</strong>
                                                            <span style="color:#6e6e73; font-size:12px; margin-top:2px;">Ціна: @a.SellingPrice ₴ | Залишок: @a.Quantity шт.</span>
                                                        </div>
                                                    }
                                                }
                                                else
                                                {
                                                    <div class="ac-item text-muted">Нічого не знайдено</div>
                                                }
                                            }
                                            else if (newItemType == "Device")
                                            {
                                                var filteredDevs = GetFilteredDevices(newItemSearchTerm);
                                                if (filteredDevs.Any())
                                                {
                                                    foreach (var d in filteredDevs)
                                                    {
                                                        <div class="ac-item" @onclick='() => SelectNewDevice(d)'>
                                                            <strong style="color:var(--apple-text); font-size: 14px;">@d.ModelName @d.Capacity @d.Color</strong>
                                                            <span style="color:#6e6e73; font-size:12px; font-family: monospace; margin-top:2px;">IMEI: @d.Identifier | Ціна: @d.SellingPrice ₴</span>
                                                        </div>
                                                    }
                                                }
                                                else
                                                {
                                                    <div class="ac-item text-muted">Нічого не знайдено</div>
                                                }
                                            }
                                        </div>
                                    }
                                </div>

                                <label class="apple-label" style="margin-top:0;">Ціна продажу (₴)</label>
                                <input type="number" class="apple-input mb-3" @bind="newItemPrice" />

                                <div style="display: flex; gap: 10px; justify-content: flex-end;">
                                    <button class="btn-apple outline" @onclick="() => isAddingNewItem = false">Скасувати</button>
                                    <button class="btn-apple success" @onclick="ConfirmAddNewItem" disabled="@(newItemStockId == 0)"><i class="bi bi-check-lg me-1"></i>Додати в чек</button>
                                </div>
                            </div>
                        }
                    </div>
                }

            </div>
            <div class="ms-footer">
                <div style="flex:1;">
                    <div style="font-size:12px; color:#6e6e73;">До сплати по чеку:</div>
                    <div style="font-size:20px; font-weight:800; color:#1d1d1f;">
                        @selectedSale.FinalAmount.ToString("N0") ₴
                    </div>
                </div>

                @if (isAdmin)
                {
                    <button class="btn-apple danger" @onclick="DeleteEntireReceipt" style="padding:10px 16px; margin-right: 8px;">
                        <i class="bi bi-trash"></i> Видалити чек
                    </button>
                }

                <button class="btn-apple outline" @onclick="PrintSelectedReceipt" style="padding:10px 16px; margin-right: 8px;">
                    <i class="bi bi-printer"></i> Друк
                </button>
                <button class="btn-apple primary" @onclick="CloseReceiptDetails" style="padding:10px 24px;">Закрити</button>
            </div>
        </div>
    </div>
}

@* 🔥 МОДАЛКА ГАРАНТІЇ 🔥 *@
@if (showWarrantyModal && pendingWarrantyItem != null)
{
    <div class="modal-backdrop-apple" style="z-index: 1060;" @onclick="() => showWarrantyModal = false">
        <div class="modal-sheet" @onclick:stopPropagation>
            <div class="ms-header">
                <h3 class="ms-title">
                    <i class="bi bi-shield-plus me-2" style="color:var(--apple-blue);"></i>Оформлення гарантії
                </h3>
                <button class="ms-close" @onclick="() => showWarrantyModal = false"><i class="bi bi-x"></i></button>
            </div>

            <div class="ms-body" style="background:#fafafa; max-height: 60vh; overflow-y: auto;">
                <p style="font-size:14px; color:var(--apple-sub); margin-bottom:16px; text-align: center;">
                    Оберіть план захисту для <strong>@pendingWarrantyItem.ModelName</strong>
                </p>

                @if (!availableWarranties.Any())
                {
                    <div class="text-center py-4 text-muted">Тарифів гарантії не знайдено.</div>
                }
                else
                {
                    @foreach (var rate in availableWarranties)
                    {
                        bool active = selectedWarrantyRate?.Id == rate.Id;

                        <div class="w-card @(active ? "active" : "")" @onclick="() => SelectWarranty(rate)">
                            <div class="w-left">
                                <div class="w-title">@rate.Type</div>
                                <div class="w-sub">@rate.TermMonths місяців захисту</div>
                            </div>

                            <div class="w-right">
                                @if (active)
                                {
                                    <div style="display:flex; align-items:center; gap:6px;" @onclick:stopPropagation>
                                        <input type="number" class="w-price-edit" @bind="rate.Price" @bind:event="oninput" min="0" />
                                        <span style="font-size:14px; font-weight:600; color:var(--apple-blue);">грн</span>
                                    </div>
                                    <div class="w-check"><i class="bi bi-check-lg"></i></div>
                                }
                                else
                                {
                                    <div class="w-price">@rate.Price.ToString("N0") грн</div>
                                }
                            </div>
                        </div>
                    }
                }
            </div>

            <div class="ms-footer">
                <button class="btn-apple outline" @onclick="() => showWarrantyModal = false">Скасувати</button>
                <button class="btn-apple primary" @onclick="ConfirmAddWarranty" disabled="@(selectedWarrantyRate == null)">
                    <i class="bi bi-check-lg me-1"></i>Оформити
                </button>
            </div>
        </div>
    </div>
}

@code {
    private DateTime startDate = DateTime.Today;
    private DateTime endDate = DateTime.Today;
    private bool isLoading = true;
    private string errorMessage = "";
    private string searchReceiptId = "";
    private string globalSearchQuery = "";

    private string activeTab = "List";
    private int selectedStoreId = 0;
    private bool isAdmin = false;

    private List<StoreDto> stores = new();
    private List<WarrantyRateDto> warrantyRates = new();
    private ReportResultDto? reportData;
    private ReceiptDto? selectedSale;

    private string customerPhone = "";
    private string customerName = "";
    private List<CustomerSuggestion> customerSuggestions = new();

    private string editSource = "";
    private string editTrackingNumber = "";

    private int editingItemId = 0;
    private decimal newEditPrice = 0;
    private bool isSwappingItem = false;
    private string swapItemType = "";

    private int newSwapStockId = 0;
    private string swapSearchTerm = "";
    private bool isSwapDropdownOpen = false;

    private int addingWarrantyItemId = 0;
    private bool showWarrantyModal = false;
    private SaleHistoryItemDto? pendingWarrantyItem;
    private List<WarrantyRateDto> availableWarranties = new();
    private WarrantyRateDto? selectedWarrantyRate;

    private bool isAddingNewItem = false;
    private string newItemType = "Accessory";

    private int newItemStockId = 0;

    private decimal newItemPrice = 0;
    private string newItemSearchTerm = "";
    private bool isNewItemDropdownOpen = false;

    private List<DeviceView> availableDevices = new();
    private List<AccessoryDto> availableAccessories = new();

    private ICollection<ReceiptDto> FilteredReceipts
    {
        get
        {
            if (reportData == null) return Array.Empty<ReceiptDto>();
            if (string.IsNullOrWhiteSpace(searchReceiptId)) return reportData.Receipts;
            return reportData.Receipts.Where(r => r.Id.ToString().Contains(searchReceiptId)).ToList();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            isLoading = true;
            errorMessage = "";

            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;

            if (user.Identity != null && user.Identity.IsAuthenticated)
            {
                isAdmin = user.IsInRole("Admin");

                var storeClaim = user.FindFirst("StoreId");
                if (storeClaim != null && int.TryParse(storeClaim.Value, out int sId))
                {
                    selectedStoreId = sId;
                }

                if (isAdmin)
                {
                    try
                    {
                        var result = await Http.GetFromJsonAsync<List<StoreDto>>("api/transfers/stores");
                        if (result != null) stores = result;

                        if (selectedStoreId == 0 && stores.Any())
                            selectedStoreId = stores.First().Id;
                    }
                    catch { }
                }

                try
                {
                    warrantyRates = await Http.GetFromJsonAsync<List<WarrantyRateDto>>("api/reports/warranty-rates") ?? new();
                }
                catch { }

                await LoadStockForSwaps();
                await LoadReport();
            }
            else
            {
                errorMessage = "Ви не авторизовані. Будь ласка, увійдіть в систему знову.";
                isLoading = false;
            }
        }
        catch (Exception ex)
        {
            errorMessage = "Помилка доступу: " + ex.Message;
            isLoading = false;
        }
    }

    private async Task LoadStockForSwaps()
    {
        try
        {
            var rawDevices = await Http.GetFromJsonAsync<List<DeviceView>>("api/inventory/devices") ?? new();
            var rawAccs = await Http.GetFromJsonAsync<List<AccessoryDto>>("api/accessories") ?? new();

            availableDevices = rawDevices.Where(d => d.StoreId == selectedStoreId && d.IsSold == 0).ToList();
            availableAccessories = rawAccs.Where(a => a.StoreId == selectedStoreId).ToList();
        }
        catch { }
    }

    private async Task LoadReport()
    {
        isLoading = true;
        errorMessage = "";
        StateHasChanged();

        try
        {
            string query = $"?storeId={selectedStoreId}&start={startDate:yyyy-MM-dd}&end={endDate:yyyy-MM-dd}";
            var response = await Http.GetAsync($"api/reports/sales{query}");

            if (response.IsSuccessStatusCode)
            {
                reportData = await response.Content.ReadFromJsonAsync<ReportResultDto>();
            }
            else
            {
                var errorContent = await response.Content.ReadAsStringAsync();
                errorMessage = $"Сервер повернув помилку ({response.StatusCode}): {errorContent}";
            }
        }
        catch (Exception ex)
        {
            errorMessage = "Помилка зв'язку з сервером: " + ex.Message;
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task ExecuteGlobalSearch()
    {
        if (string.IsNullOrWhiteSpace(globalSearchQuery)) return;

        isLoading = true;
        errorMessage = "";
        StateHasChanged();

        try
        {
            string query = $"?query={Uri.EscapeDataString(globalSearchQuery)}&start={startDate:yyyy-MM-dd}&end={endDate:yyyy-MM-dd}";
            var response = await Http.GetAsync($"api/reports/search-receipts{query}");

            if (response.IsSuccessStatusCode)
            {
                var searchResults = await response.Content.ReadFromJsonAsync<List<ReceiptDto>>();
                if (reportData != null)
                {
                    reportData.Receipts = searchResults ?? new List<ReceiptDto>();
                    activeTab = "List";
                }
            }
            else
            {
                var errorContent = await response.Content.ReadAsStringAsync();
                errorMessage = $"Помилка пошуку: {errorContent}";
            }
        }
        catch (Exception ex)
        {
            errorMessage = "Помилка зв'язку з сервером: " + ex.Message;
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task HandleGlobalSearchEnter(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await ExecuteGlobalSearch();
        }
    }

