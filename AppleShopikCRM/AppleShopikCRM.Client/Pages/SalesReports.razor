    private List<AccessoryDto> GetFilteredAccessories(string term)
    {
        if (string.IsNullOrWhiteSpace(term)) return availableAccessories.Take(20).ToList();
        var tokens = term.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return availableAccessories.Where(a =>
            tokens.All(t => a.ModelName.Contains(t, StringComparison.OrdinalIgnoreCase))
        ).Take(20).ToList();
    }

    private List<DeviceView> GetFilteredDevices(string term)
    {
        if (string.IsNullOrWhiteSpace(term)) return availableDevices.Take(20).ToList();
        var tokens = term.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return availableDevices.Where(d =>
            tokens.All(t =>
                (d.ModelName ?? "").Contains(t, StringComparison.OrdinalIgnoreCase) ||
                (d.Identifier ?? "").Contains(t, StringComparison.OrdinalIgnoreCase) ||
                (d.Color ?? "").Contains(t, StringComparison.OrdinalIgnoreCase) ||
                (d.Capacity ?? "").Contains(t, StringComparison.OrdinalIgnoreCase)
            )
        ).Take(20).ToList();
    }

