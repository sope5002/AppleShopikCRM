    private async Task AssignCustomer()
    {
        if (string.IsNullOrWhiteSpace(customerPhone) || selectedSale == null) return;

        var payload = new { CustomerPhone = customerPhone, CustomerName = customerName };
        var res = await Http.PostAsJsonAsync($"api/reports/assign-customer/{selectedSale.Id}", payload);

        if (res.IsSuccessStatusCode)
        {
            var data = await res.Content.ReadFromJsonAsync<AssignResult>();
            selectedSale.CustomerName = data?.CustomerName ?? customerName;
            selectedSale.CustomerPhone = customerPhone;

            await JS.InvokeVoidAsync("alert", "Клієнта успішно прив'язано до чеку!");
            customerPhone = "";
            customerName = "";
            customerSuggestions.Clear();
            StateHasChanged();
        }
        else
        {
            await JS.InvokeVoidAsync("alert", "Помилка: " + await res.Content.ReadAsStringAsync());
        }
    }

    private async Task UnlinkCustomer()
