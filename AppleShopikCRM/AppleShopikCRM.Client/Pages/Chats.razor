@page "/chats"
@using Microsoft.AspNetCore.SignalR.Client
@using Microsoft.AspNetCore.Components.Forms
@using System.Net.Http.Json
@using System.Net.Http.Headers
@inject HttpClient Http
@inject NavigationManager Nav
@implements IAsyncDisposable
@rendermode InteractiveWebAssembly
@inject IJSRuntime JS

<PageTitle>Чати — Apple Shopik</PageTitle>

<style>
    .chat-container {
        display: flex;
        height: calc(100vh - 60px);
        background: #fff;
        font-family: -apple-system, sans-serif;
    }

    /* Ліва панель - Список чатів */
    .chat-sidebar {
        width: 320px;
        border-right: 1px solid #e5e5ea;
        display: flex;
        flex-direction: column;
        background: #f9f9f9;
    }

    .chat-sidebar-header {
        padding: 16px;
        font-size: 20px;
        font-weight: 700;
        border-bottom: 1px solid #e5e5ea;
        background: #f9f9f9;
    }

    .chat-list {
        flex: 1;
        overflow-y: auto;
    }

    .chat-list-item {
        padding: 12px 16px;
        border-bottom: 1px solid #f0f0f0;
        cursor: pointer;
        transition: background 0.2s;
        display: flex;
        gap: 12px;
        align-items: center;
    }

        .chat-list-item:hover {
            background: #f1f1f1;
        }

        .chat-list-item.active {
            background: #e0f0ff;
        }

    .chat-avatar {
        width: 46px;
        height: 46px;
        border-radius: 50%;
        background: linear-gradient(135deg, #007aff, #00c6ff);
        color: white;
        display: flex;
        justify-content: center;
        align-items: center;
        font-size: 20px;
        font-weight: bold;
        flex-shrink: 0;
        object-fit: cover; /* 🔥 Щоб фото не розтягувалось */
        border: 1px solid #e5e5ea;
    }

        .chat-avatar.instagram {
            background: linear-gradient(45deg, #f09433 0%, #e6683c 25%, #dc2743 50%, #cc2366 75%, #bc1888 100%);
            border: none;
        }

    .chat-info {
        flex: 1;
        min-width: 0;
    }

    .chat-name-row {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        margin-bottom: 4px;
    }

    .chat-name {
        font-weight: 600;
        font-size: 15px;
        color: #1c1c1e;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .chat-time {
        font-size: 12px;
        color: #8e8e93;
    }

    .chat-last-msg {
        font-size: 13px;
        color: #8e8e93;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    /* Права панель - Повідомлення */
    .chat-main {
        flex: 1;
        display: flex;
        flex-direction: column;
        background: #ffffff;
    }

    .chat-main-header {
        padding: 16px 20px;
        border-bottom: 1px solid #e5e5ea;
        font-weight: 600;
        font-size: 17px;
        display: flex;
        align-items: center;
        gap: 10px;
        box-shadow: 0 1px 2px rgba(0,0,0,0.02);
        z-index: 10;
    }

    .messages-area {
        flex: 1;
        padding: 20px;
        overflow-y: auto;
        display: flex;
        flex-direction: column;
        gap: 8px;
        background: #ffffff;
    }

    /* Бульбашки повідомлень */
    .msg-bubble {
        max-width: 65%;
        padding: 10px 14px;
        font-size: 15px;
        line-height: 1.4;
        position: relative;
        word-wrap: break-word;
    }

    .msg-incoming {
        align-self: flex-start;
        background: #e9e9eb;
        color: #000;
        border-radius: 18px 18px 18px 4px;
    }

    .msg-outgoing {
        align-self: flex-end;
        background: #007aff;
        color: #fff;
        border-radius: 18px 18px 4px 18px;
    }

    .msg-time {
        font-size: 10px;
        margin-top: 4px;
        opacity: 0.7;
        text-align: right;
    }

    /* Зона вводу */
    .chat-input-area {
        padding: 14px 20px;
        border-top: 1px solid #e5e5ea;
        background: #f9f9f9;
        display: flex;
        gap: 10px;
    }

    .chat-input {
        flex: 1;
        border: 1px solid #d1d1d6;
        border-radius: 20px;
        padding: 10px 16px;
        font-size: 15px;
        outline: none;
    }

        .chat-input:focus {
            border-color: #007aff;
        }

    .btn-send {
        background: #007aff;
        color: white;
        border: none;
        border-radius: 50%;
        width: 40px;
        height: 40px;
        display: flex;
        justify-content: center;
        align-items: center;
        cursor: pointer;
    }

    .chat-media-img {
        max-width: 100%;
        border-radius: 12px;
        margin-bottom: 6px;
        cursor: pointer;
    }

    .btn-attach {
        background: transparent;
        border: none;
        color: #8e8e93;
        font-size: 20px;
        padding: 0 10px;
        cursor: pointer;
        display: flex;
        align-items: center;
    }

        .btn-attach:hover {
            color: #007aff;
        }

    .btn-back {
        display: none;
        background: transparent;
        border: none;
        color: #007aff;
        font-size: 20px;
        margin-right: 10px;
        cursor: pointer;
        padding: 0;
    }

    /* АДАПТИВНІСТЬ ДЛЯ ТЕЛЕФОНІВ (ширина екрану менше 768px) */
    
</style>

<div class="chat-container @(isMobileChatOpen ? "show-mobile-chat" : "")">
    @* ЛІВА ПАНЕЛЬ *@
    <div class="chat-sidebar">
        <div class="chat-sidebar-header" style="padding-bottom: 8px;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 10px;">
                <span>Повідомлення</span>
                <button class="btn btn-sm btn-light d-md-none" @onclick='() => Nav.NavigateTo("/")'>
                    <i class="bi bi-house-door"></i>
                </button>
            </div>

            @* 🔥 ПАНЕЛЬ ПОШУКУ *@
            <div class="input-group input-group-sm mb-2">
                <input type="text" class="form-control" placeholder="Пошук клієнта або тексту..."
                       @bind="searchQuery" @bind:event="oninput" @onkeyup="HandleSearch" />
                <button class="btn btn-outline-secondary" @onclick="LoadChats">
                    <i class="bi bi-search"></i>
                </button>
            </div>

            @* 🔥 ФІЛЬТР ЗА СТОРІНКАМИ (Вкладки) *@
            <div class="d-flex gap-1" style="overflow-x: auto; font-size: 13px; padding-bottom: 4px;">
                <button class="btn btn-sm @(selectedPageId == "" ? "btn-primary" : "btn-outline-secondary")" style="border-radius: 15px;" @onclick='() => FilterByPage("")'>
                    Всі
                </button>
                <button class="btn btn-sm @(selectedPageId == "ID_ІНСТИ" ? "btn-primary" : "btn-outline-secondary")" style="border-radius: 15px;" @onclick='() => FilterByPage("ID_ІНСТИ")'>
                    <i class="bi bi-instagram"></i> Insta
                </button>
                <button class="btn btn-sm @(selectedPageId == "ID_ТЕЛЕГРАМУ" ? "btn-primary" : "btn-outline-secondary")" style="border-radius: 15px;" @onclick='() => FilterByPage("ID_ТЕЛЕГРАМУ")'>
                    <i class="bi bi-telegram"></i> Telegram
                </button>
            </div>
        </div>
        <div class="chat-list">
            @if (chats == null)
            {
                <div class="p-3 text-muted text-center">Завантаження...</div>
            }
            else if (!chats.Any())
            {
                <div class="p-3 text-muted text-center">Немає чатів</div>
            }
            else
            {
                @foreach (var chat in chats)
                {
                    <div class="chat-list-item @(selectedChat?.Id == chat.Id ? "active" : "")" @onclick="() => SelectChat(chat)">

                        @* 🔥 ЛОГІКА ВІДОБРАЖЕННЯ АВАТАРКИ *@
                        @if (!string.IsNullOrEmpty(chat.AvatarUrl))
                        {
                            <img src="@chat.AvatarUrl" class="chat-avatar" alt="@chat.CustomerName" />
                        }
                        else
                        {
                            <div class="chat-avatar instagram">
                                <i class="bi bi-instagram"></i>
                            </div>
                        }

                        <div class="chat-info">
                            <div class="chat-name-row">
                                <div class="chat-name">@chat.CustomerName</div>
                                <div class="chat-time">@chat.LastActivity.ToLocalTime().ToString("HH:mm")</div>
                            </div>
                            <div class="chat-last-msg">@chat.LastMessageText</div>
                        </div>
                        @if (chat.UnreadCount > 0)
                        {
                            <span class="badge bg-primary rounded-pill">@chat.UnreadCount</span>
                        }
                    </div>
                }
            }
        </div>
    </div>

    @* ПРАВА ПАНЕЛЬ *@
    <div class="chat-main">
        @if (selectedChat == null)
        {
            <div style="flex:1; display:flex; align-items:center; justify-content:center; color:#8e8e93;">Оберіть чат для перегляду</div>
        }
        else
        {
            <div class="chat-main-header">
                @* 🔥 КНОПКА НАЗАД *@
                <button class="btn-back" @onclick="BackToList">
                    <i class="bi bi-chevron-left"></i>
                </button>

                @if (!string.IsNullOrEmpty(selectedChat.AvatarUrl))
                {
                    <img src="@selectedChat.AvatarUrl" style="width:32px; height:32px; border-radius:50%; object-fit:cover;" />
                }
                else
                {

                    <i class="bi bi-instagram text-danger"></i>
                }
                @selectedChat.CustomerName
            </div>

            <div class="messages-area" id="messages-container">
                @if (messages != null)
                {
                    @foreach (var msg in messages)
                    {
                        <div class="msg-bubble @(msg.Direction == 0 ? "msg-incoming" : "msg-outgoing")">
                            @* 🔥 ВІДОБРАЖЕННЯ МЕДІА *@
                            @if (!string.IsNullOrEmpty(msg.MediaUrl))
                            {
                                @if (msg.MediaType == "image" || msg.MediaUrl.Contains(".jpg") || msg.MediaUrl.Contains(".png"))
                                {
                                    <img src="@msg.MediaUrl" class="chat-media-img" />
                                }
                                else
                                {
                                    <a href="@msg.MediaUrl" target="_blank" style="color: inherit; text-decoration: underline;">[Переглянути файл]</a>
                                }
                            }

                            @if (!string.IsNullOrEmpty(msg.Text) && !msg.Text.StartsWith("[Медіа"))
                            {
                                <div>@msg.Text</div>
                            }
                            <div class="msg-time">@msg.Timestamp.ToLocalTime().ToString("HH:mm")</div>
                        </div>
                    }
                }
            </div>

            <div class="chat-input-area">
                @* 🔥 КНОПКА ПРИКРІПИТИ ФАЙЛ *@
                <label for="file-upload" class="btn-attach">
                    <i class="bi bi-paperclip"></i>
                </label>
                <InputFile id="file-upload" OnChange="UploadAndSendImage" style="display:none" accept="image/*" />

                <input type="text" class="chat-input"
                       placeholder="Написати повідомлення..."
                       @bind="newMessageText"
                       @bind:event="oninput"
                       @onkeydown="HandleKeyDown"
                       disabled="@isSending" />

                <button class="btn-send" @onclick="() => SendMessage(null, null)" disabled="@(string.IsNullOrWhiteSpace(newMessageText) && !isSending)">
                    @if (isSending)
                    {
                        <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true" style="width: 1rem; height: 1rem;"></span>
                    }
                    else
                    {
                        <i class="bi bi-send-fill"></i>
                    }
                </button>
            </div>
        }
    </div>
</div>

@code {
    private HubConnection? hubConnection;
    private List<ChatDto> chats = new();
    private List<MessageDto> messages = new();
    private ChatDto? selectedChat;
    private string newMessageText = "";
    private bool isSending = false;
    private bool isMobileChatOpen = false;
    private string searchQuery = "";
    private string selectedPageId = "";

    protected override async Task OnInitializedAsync()
    {
        await LoadChats();

        hubConnection = new HubConnectionBuilder()
            .WithUrl(Nav.ToAbsoluteUri("/chathub"))
            .WithAutomaticReconnect()
            .Build();

        hubConnection.On<MessageDto>("ReceiveMessage", (message) =>
         {
             var existingChat = chats.FirstOrDefault(c => c.Id == message.ChatId);

             if (existingChat != null)
             {
                 existingChat.LastMessageText = message.Text;
                 existingChat.LastActivity = DateTime.UtcNow;

                 // 🔥 ВИПРАВЛЕНО: Використовуємо Direction замість IsFromAdmin
                 // Direction == 0 означає, що написав клієнт.
                 if (message.Direction == 0)
                 {
                     // Додаємо +1 до непрочитаних.
                     // Цифра буде рости, поки менеджер не відправить відповідь!
                     existingChat.UnreadCount++;
                 }

                 chats.Remove(existingChat);
                 chats.Insert(0, existingChat);
             }
             else
             {
                 InvokeAsync(LoadChats); // Якщо чат новий і його ще немає в списку
             }

             InvokeAsync(StateHasChanged);
         });

        hubConnection.On<ChatDto>("UpdateChatList", (updatedChat) =>
        {
            var existingChat = chats.FirstOrDefault(c => c.Id == updatedChat.Id);
            if (existingChat != null)
            {
                chats.Remove(existingChat);
            }
            chats.Insert(0, updatedChat);
            StateHasChanged();
        });

        await hubConnection.StartAsync();
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !string.IsNullOrWhiteSpace(newMessageText) && !isSending)
        {
            await SendMessage(null, null);
        }
    }
    private async Task UploadAndSendImage(InputFileChangeEventArgs e)
    {
        if (selectedChat == null) return;
        var file = e.File;
        if (file == null) return;

        isSending = true;
        StateHasChanged();

        try
        {
            using var content = new MultipartFormDataContent();
            var fileContent = new StreamContent(file.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024)); // До 10 МБ
            fileContent.Headers.ContentType = new MediaTypeHeaderValue(file.ContentType);
            content.Add(fileContent, "file", file.Name);

            // 1. Завантажуємо файл на наш сервер
            var uploadRes = await Http.PostAsync("api/chats/upload", content);
            if (uploadRes.IsSuccessStatusCode)
            {
                var result = await uploadRes.Content.ReadFromJsonAsync<UploadResult>();
                if (result != null)
                {
                    // 2. Формуємо ПУБЛІЧНЕ ПОСИЛАННЯ через ngrok для Фейсбуку
                    var baseUrl = Nav.BaseUri.TrimEnd('/'); // https://...ngrok-free.app
                    var fullMediaUrl = $"{baseUrl}{result.Url}";

                    // 3. Відправляємо в Інстаграм
                    await SendMessage(fullMediaUrl, "image");
                }
            }
            else
            {
                await JS.InvokeVoidAsync("alert", "Помилка завантаження файлу на сервер");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Upload error: {ex.Message}");
        }
        finally
        {
            isSending = false;
            StateHasChanged();
        }
    }

    private async Task SendMessage(string? mediaUrl, string? mediaType)
    {
        if ((string.IsNullOrWhiteSpace(newMessageText) && string.IsNullOrEmpty(mediaUrl)) || selectedChat == null) return;

        isSending = true;
        StateHasChanged();

        try
        {
            var req = new
            {
                Text = newMessageText,
                MediaUrl = mediaUrl,
                MediaType = mediaType
            };

            var res = await Http.PostAsJsonAsync($"api/chats/{selectedChat.Id}/send", req);

            if (res.IsSuccessStatusCode)
            {
                var savedMsg = await res.Content.ReadFromJsonAsync<MessageDto>();
                if (savedMsg != null)
                {
                    messages.Add(savedMsg);
                    selectedChat.LastMessageText = savedMsg.Text;
                    if (string.IsNullOrEmpty(savedMsg.Text)) selectedChat.LastMessageText = "[Медіа]";
                    selectedChat.LastActivity = savedMsg.Timestamp;

                    chats.Remove(selectedChat);
                    chats.Insert(0, selectedChat);

                    
                    selectedChat.UnreadCount = 0;
                    selectedChat.LastMessageText = newMessageText;
                    if (string.IsNullOrEmpty(mediaUrl)) newMessageText = "";
                    await ScrollToBottom();
                }
            }
            else
            {
                await JS.InvokeVoidAsync("alert", "Помилка відправки в Instagram.");
            }
        }
        catch (Exception ex) { Console.WriteLine(ex.Message); }
        finally { isSending = false; StateHasChanged(); }
    }

    private async Task SelectChat(ChatDto chat)
    {
        selectedChat = chat;
        messages = null!;
        isMobileChatOpen = true;

        messages = await Http.GetFromJsonAsync<List<MessageDto>>($"api/chats/{chat.Id}/messages") ?? new();

        await ScrollToBottom();
    }
    private void BackToList()
    {
        isMobileChatOpen = false;
        // selectedChat залишаємо як є, щоб при поверненні на ПК він був відкритий
        StateHasChanged();
    }

    private async Task ScrollToBottom()
    {
        await Task.Delay(50);
        await JS.InvokeVoidAsync("eval", "var el = document.getElementById('messages-container'); if(el) el.scrollTop = el.scrollHeight;");
    }

    public async ValueTask DisposeAsync()
    {
        if (hubConnection is not null)
        {
            await hubConnection.DisposeAsync();
        }
    }
    // 🔥 Завантаження чатів з бекенду з урахуванням фільтрів
    private async Task LoadChats()
    {
        chats = await Http.GetFromJsonAsync<List<ChatDto>>($"api/chats?search={searchQuery}&pageId={selectedPageId}") ?? new();
        StateHasChanged();
    }

    // 🔥 Обробка натискання Enter у пошуку
    private async Task HandleSearch(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await LoadChats();
        }
    }

    // 🔥 Обробка кліку по вкладках (Всі / Insta / Telegram)
    private async Task FilterByPage(string pageId)
    {
        selectedPageId = pageId;
        searchQuery = ""; // Скидаємо пошук при перемиканні вкладок
        await LoadChats();
    }

    public class ChatDto { public Guid Id { get; set; } public int Platform { get; set; } public string CustomerName { get; set; } = ""; public string? AvatarUrl { get; set; } public string? LastMessageText { get; set; } public DateTime LastActivity { get; set; } public int UnreadCount { get; set; } }
    public class MessageDto { public Guid Id { get; set; } public Guid ChatId { get; set; } public int Direction { get; set; } public string Text { get; set; } = ""; public string? MediaUrl { get; set; } public string? MediaType { get; set; } public DateTime Timestamp { get; set; } public bool IsRead { get; set; } }
    public class UploadResult { public string Url { get; set; } = ""; }
}