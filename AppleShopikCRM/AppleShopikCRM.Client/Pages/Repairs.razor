    public class RepairService { public int Id { get; set; } public string Name { get; set; } = ""; public decimal Price { get; set; } public decimal CostPrice { get; set; } public string? CompatibleModel { get; set; } }
    public class FinancialStatsDto { public int TotalRepairsCount { get; set; } public decimal TotalRevenue { get; set; } public decimal TotalCost { get; set; } public decimal NetProfit { get; set; } }
