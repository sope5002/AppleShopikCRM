@page "/repairs"
@using AppleShopikCRM.Client.Models
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@using Blazored.LocalStorage
@using Microsoft.AspNetCore.Components.Web

@inject HttpClient Http
@inject AuthenticationStateProvider AuthStateProvider
@inject IJSRuntime JsRuntime
@inject ILocalStorageService LocalStorage
@inject NavigationManager NavManager

@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))

<div class="container-fluid">
    @if (!isLoaded)
    {
        <div class="d-flex justify-content-center align-items-center" style="height: 80vh;">
            <div class="spinner-border text-primary" role="status"><span class="visually-hidden">Loading...</span></div>
        </div>
    }
    else
    {
        @* --- ШАПКА --- *@
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h3>🛠️ Центр ремонтів</h3>
                <div class="form-check form-switch mt-2">
                    <input class="form-check-input" type="checkbox" id="modeSwitch" checked="@isTechnicianMode" @onchange="ToggleTechnicianMode">
                    <label class="form-check-label fw-bold @(isTechnicianMode ? "text-danger" : "text-secondary")" for="modeSwitch">
                        @(isTechnicianMode ? "🔒 Режим Майстра (УВІМК)" : "👀 Режим Перегляду")
                    </label>
                </div>
            </div>
            <div class="d-flex gap-2">
                @if (hasAdminRole)
                {
                    <button class="btn btn-info text-white shadow-sm" @onclick="LoadFinancialStats">
                        <i class="bi bi-graph-up-arrow me-2"></i>Дохід
                    </button>
                }
                <button class="btn btn-outline-secondary" @onclick="() => showHistoryModal = true">
                    <i class="bi bi-clock-history me-2"></i>Історія
                </button>
                <button class="btn btn-primary shadow" @onclick="OpenNewTicketModal">
                    <i class="bi bi-plus-lg me-2"></i>Нова заявка
                </button>
            </div>
        </div>

        @* --- KANBAN (3 КОЛОНКИ) --- *@
        <div class="row g-3" style="min-height: 70vh;">

            @* 1. ЧЕРГА *@
            <div class="col-md-4">
                <div class="bg-light p-3 rounded h-100 shadow-sm border">
                    <h6 class="text-center fw-bold text-secondary border-bottom pb-3 mb-3">📥 Черга / Прийнято</h6>
                    @foreach (var t in tickets.Where(x => x.Status == RepairStatus.New || x.Status == RepairStatus.InTransit))
                    {
                        <div class="card mb-3 shadow-sm border-0" style="cursor: pointer;" @onclick="() => OpenEditModal(t)">
                            <div class="card-body p-3">
                                <div class="d-flex justify-content-between"><strong class="small text-muted">#@t.TicketNumber</strong><span class="badge bg-secondary">Новий</span></div>
                                @if (t.DeviceStock != null)
                                {
                                    <div class="fw-bold text-primary mt-2 fs-5">@t.DeviceStock.ModelName</div>
                                    <div class="text-dark small">@t.DeviceStock.Color @t.DeviceStock.Capacity</div>

                                    <div class="mt-2"><span class="badge bg-info text-dark">СКЛАД</span></div>
                                }
                                else
                                {

                                    <div class="fw-bold text-primary mt-2 fs-5">@t.DeviceModel</div>
                                    <div class="small text-muted">@t.ClientName</div>
        }
                                <small class="text-muted d-block mt-1">@t.IssueDescription</small>
                            </div>
                        </div>
                    }
                </div>
            </div>

            @* 2. В РОБОТІ *@
            <div class="col-md-4">
                <div class="bg-white p-3 rounded h-100 shadow border border-primary">
                    <h6 class="text-center fw-bold text-primary border-bottom pb-3 mb-3">⚙️ В роботі</h6>
                    @foreach (var t in tickets.Where(x => x.Status == RepairStatus.InProgress || x.Status == RepairStatus.PendingParts))
                    {
                        <div class="card mb-3 shadow-sm border-start border-4 border-primary" style="cursor: pointer;" @onclick="() => OpenEditModal(t)">
                            <div class="card-body p-3">
                                <div class="d-flex justify-content-between"><strong class="small text-muted">#@t.TicketNumber</strong><span class="badge bg-warning text-dark">Робота</span></div>
                                @if (t.DeviceStock != null)
                                {
                                    <div class="fw-bold mt-2 fs-5">@t.DeviceStock.ModelName</div>
                                    <div class="text-dark small">@t.DeviceStock.Color @t.DeviceStock.Capacity</div>
        }
                                else
                                {
                                    <div class="fw-bold mt-2 fs-5">@t.DeviceModel</div>
                                    <div class="small text-muted">@t.ClientName</div>
        }
                                <small class="text-muted d-block mt-1">@t.IssueDescription</small>
                            </div>
                        </div>
                    }
                </div>
            </div>

            @* 3. ГОТОВО *@
            <div class="col-md-4">
                <div class="bg-light p-3 rounded h-100 shadow-sm border border-success">
                    <h6 class="text-center fw-bold text-success border-bottom pb-3 mb-3">✅ Готово (Очікує оплати)</h6>
                    @foreach (var t in tickets.Where(x => x.Status == RepairStatus.Ready))
                    {
                        <div class="card mb-3 shadow-sm border-start border-4 border-success" style="cursor: pointer;" @onclick="() => OpenEditModal(t)">
                            <div class="card-body p-3">
                                <div class="d-flex justify-content-between align-items-center">
                                    <div>
                                        <strong class="small text-muted">#@t.TicketNumber</strong>
                                        @if (t.DeviceStock != null)
                                        {
                                            <div class="fw-bold mt-1 fs-5">@t.DeviceStock.ModelName</div>
                                            <div class="text-dark small">@t.DeviceStock.Color @t.DeviceStock.Capacity</div>
        }
                                        else
                                        {
                                            <div class="fw-bold mt-1 fs-5">@t.DeviceModel</div>
                                            <div class="small text-muted">@t.ClientName</div>
        }
                                    </div>
                                    <div class="text-end"><span class="badge bg-success mb-1">Готово</span><div class="text-success fw-bold fs-5">@t.Price.ToString("N0") ₴</div></div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    }
</div>

@* --- МОДАЛКИ --- *@

@* 1. ФІНАНСОВИЙ ЗВІТ *@
@if (showStatsModal && stats != null)
{
    <div class="modal fade show d-block" style="background: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content shadow">
                <div class="modal-header bg-info text-white">
                    <h5 class="modal-title">📊 Фінансовий звіт (Поточний місяць)</h5>
                    <button class="btn-close btn-close-white" @onclick="() => showStatsModal = false"></button>
                </div>
                <div class="modal-body text-center">
                    <h6 class="text-muted mb-3">Завершені ремонти: <b>@stats.TotalRepairsCount</b></h6>
                    <div class="row g-2">
                        <div class="col-6">
                            <div class="p-3 border rounded bg-light h-100">
                                <div class="small text-muted text-uppercase">Виручка (Каса)</div>
                                <div class="fs-4 fw-bold text-primary">@stats.TotalRevenue.ToString("N0") ₴</div>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="p-3 border rounded bg-light h-100">
                                <div class="small text-muted text-uppercase">Витрати (Запчастини)</div>
                                <div class="fs-4 fw-bold text-danger">@stats.TotalCost.ToString("N0") ₴</div>
                            </div>
                        </div>
                    </div>
                    <div class="mt-3 p-3 bg-success bg-opacity-10 border border-success rounded">
                        <div class="text-success small fw-bold text-uppercase">ЧИСТИЙ ПРИБУТОК</div>
                        <div class="display-6 fw-bold text-success">@stats.NetProfit.ToString("N0") ₴</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@* 2. ІСТОРІЯ *@
@if (showHistoryModal)
{
    <div class="modal fade show d-block" style="background: rgba(0,0,0,0.5);"><div class="modal-dialog modal-xl"><div class="modal-content"><div class="modal-header"><h5 class="modal-title">Історія</h5><button class="btn-close" @onclick="() => showHistoryModal = false"></button></div><div class="modal-body"><table class="table table-hover"><thead><tr><th>Дата</th><th>Пристрій</th><th>Клієнт</th><th>Сума</th></tr></thead><tbody>@foreach(var t in tickets.Where(x=>x.Status==RepairStatus.Completed).OrderByDescending(x=>x.CompletedAt)){
    <tr><td>@t.CompletedAt?.ToShortDateString()</td><td>@(t.DeviceStock?.ModelName ?? t.DeviceModel)</td><td>@t.ClientName</td><td class="text-success fw-bold">@t.Price</td></tr>
}
</tbody></table></div></div></div></div>
}

@* 3. СТВОРЕННЯ (ВИПРАВЛЕНО - ВСІ ПОЛЯ Є) *@
@if (showCreateModal)
{
    <div class="modal fade show d-block" style="background: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title">Нова заявка</h5>
                    <button class="btn-close btn-close-white" @onclick="() => showCreateModal = false"></button>
                </div>
                <div class="modal-body">
                    <ul class="nav nav-pills mb-3 nav-fill">
                        <li class="nav-item">
                            <button class="nav-link @(newTicket.Type == RepairType.ClientService ? "active" : "")"
                                    @onclick="() => newTicket.Type = RepairType.ClientService">
                                👤 Клієнтський
                            </button>
                        </li>
                        <li class="nav-item">
                            <button class="nav-link @(newTicket.Type == RepairType.InternalStock ? "active" : "")"
                                    @onclick="() => newTicket.Type = RepairType.InternalStock">
                                🏢 Зі складу
                            </button>
                        </li>
                    </ul>

                    @if (newTicket.Type == RepairType.InternalStock)
                    {
                        <div class="mb-3 p-3 bg-light border rounded">
                            <label class="fw-bold text-primary">Оберіть телефон</label>
                            <select class="form-select mt-2" @bind="newTicket.DeviceStockId">
                                <option value="">-- Оберіть телефон --</option>
                                @foreach (var d in availableStock)
                                {
                                    <option value="@d.Id">@d.ModelName @d.Color @d.Capacity (@d.ConditionStatus)</option>
                                }
                            </select>
                        </div>
                    }
                    else
                    {
                        @* 🔥 ОСЬ ТУТ ПОВЕРНУТО ВСІ ПОЛЯ ДЛЯ КЛІЄНТА 🔥 *@
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label fw-bold">Ім'я Клієнта</label>
                                <input class="form-control" @bind="newTicket.ClientName" placeholder="Іван Іванов" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-bold">Телефон</label>
                                <input class="form-control" @bind="newTicket.ClientPhone" placeholder="050-XXX-XX-XX" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-bold">Модель пристрою</label>
                                <input class="form-control" @bind="newTicket.DeviceModel" placeholder="iPhone 13" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-bold">Серійний номер / IMEI</label>
                                <input class="form-control" @bind="newTicket.SerialNumber" placeholder="35..." />
                            </div>
                        </div>
                    }

                    <div class="mt-3">
                        <label class="form-label fw-bold">Опис проблеми</label>
                        <textarea class="form-control" rows="3" @bind="newTicket.IssueDescription" placeholder="Розбитий екран, не включається..."></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="() => showCreateModal = false">Скасувати</button>
                    <button class="btn btn-success px-4" @onclick="CreateTicket">Створити</button>
                </div>
            </div>
        </div>
    </div>
}

@* 4. РЕДАГУВАННЯ *@
@if (showEditModal && selectedTicket != null)
{
    bool isReadOnly = selectedTicket.Status == RepairStatus.Ready || selectedTicket.Status == RepairStatus.Completed;

    <div class="modal fade show d-block" style="background: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header @(selectedTicket.Status == RepairStatus.Completed ? "bg-secondary text-white" : "bg-primary text-white")">
                    <h5 class="modal-title">#@selectedTicket.TicketNumber @(isTechnicianMode ? "(Майстер)" : "")</h5>
                    <button class="btn-close btn-close-white" @onclick="() => showEditModal = false"></button>
                </div>
                <div class="modal-body">
                    @* Інфо про девайс *@
                    <div class="alert alert-secondary">
                        <div class="d-flex justify-content-between">
                            <div>
                                <strong>Проблема:</strong> @selectedTicket.IssueDescription <br />
                                @if (selectedTicket.DeviceStock != null)
                                {
                                    <small>@selectedTicket.DeviceStock.ModelName @selectedTicket.DeviceStock.Color @selectedTicket.DeviceStock.Capacity</small>
                                }
                                else
                                {

                                    <small>@selectedTicket.DeviceModel</small>
                                }
                            </div>
                            @if (!string.IsNullOrEmpty(selectedTicket.ClientName))
                            {
                                <div class="text-end border-start ps-3">
                                    <small class="d-block text-muted">Клієнт:</small>
                                    <strong>@selectedTicket.ClientName</strong><br />
                                    <small>@selectedTicket.ClientPhone</small>
                                </div>
                            }
                        </div>
                    </div>

                    @if (isTechnicianMode)
                    {
                        <div class="card p-3 mb-3 border-warning" style="background-color: #fffbf0;">
                            <h6 class="text-warning fw-bold">🛠️ Зона Майстра</h6>

                            @if (!isReadOnly)
                            {
                                <div class="mb-3 bg-white p-2 border rounded">
                                    <div class="input-group mb-2">
                                        <span class="input-group-text"><i class="bi bi-search"></i></span>
                                        <input type="text" class="form-control form-control-sm" placeholder="Додати послугу..." @bind="serviceSearchQuery" @bind:event="oninput" />
                                    </div>
                                    <div class="list-group" style="max-height: 100px; overflow-y: auto;">
                                        @foreach (var s in FilteredServices)
                                        {
                                            <button class="list-group-item list-group-item-action d-flex justify-content-between align-items-center py-1" @onclick="() => AddServiceToTicket(s)">
                                                <span>@s.Name</span>
                                                <span class="badge bg-secondary me-2">@s.Price ₴</span>
                                            </button>
                                        }
                                    </div>
                                </div>
                            }

                            @if (selectedTicket.Type == RepairType.InternalStock)
                            {
                                <div class="row g-2 mb-3 border-bottom pb-2">
                                    <div class="col-6"><label>АКБ %</label><input type="number" class="form-control" @bind="editingBattery" disabled="@isReadOnly" /></div>
                                    <div class="col-6"><label>Стан</label><input type="text" class="form-control" @bind="editingCondition" disabled="@isReadOnly" /></div>
                                    @if (!isReadOnly)
                                    {
                                        <div class="col-12 text-end"><button class="btn btn-sm btn-info text-white" @onclick="SaveDeviceSpecs">Оновити</button></div>
                                    }
                                </div>
                            }

                            <div class="mb-2">
                                <label class="fw-bold">Звіт (Що зроблено) <span class="text-danger">*</span></label>
                                <textarea class="form-control" @bind="selectedTicket.ResolutionReport" rows="2" disabled="@isReadOnly"></textarea>
                            </div>

                            <div class="row">
                                @if (hasAdminRole)
                                {
                                    <div class="col-md-6">
                                        <label class="text-danger">Собівартість</label>
                                        <input type="number" class="form-control border-danger" @bind="selectedTicket.CostPart" disabled="@isReadOnly" />
                                    </div>
                                }
                                <div class="col-md-6">
                                    <label class="text-success">Ціна (Клієнт)</label>
                                    <input type="number" class="form-control border-success fw-bold" @bind="selectedTicket.Price" disabled="@isReadOnly" />
                                </div>
                            </div>
                            @if (selectedTicket.Status == RepairStatus.InProgress)
                            {
                                <div class="mt-3 text-end"><button class="btn btn-warning btn-sm" @onclick="UpdateTicketDetails">💾 Зберегти зміни</button></div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="mb-3"><label class="fw-bold">Виконано:</label><div class="p-3 bg-light border rounded">@(selectedTicket.ResolutionReport ?? "...")</div></div>
                    }

                    @if (selectedTicket.Status != RepairStatus.Completed)
                    {
                        <hr />
                        <div class="d-flex justify-content-end align-items-center">
                            @if (selectedTicket.Status == RepairStatus.New || selectedTicket.Status == RepairStatus.InTransit)
                            {
                                <button class="btn btn-primary btn-lg shadow" @onclick="() => ChangeStatus(RepairStatus.InProgress)">
                                    <i class="bi bi-tools me-2"></i> Взяти в роботу
                                </button>
                            }
                            @if (selectedTicket.Status == RepairStatus.InProgress)
                            {
                                <button class="btn btn-success btn-lg shadow" @onclick="() => ChangeStatus(RepairStatus.Ready)">
                                    <i class="bi bi-check-lg me-2"></i> Завершити ремонт
                                </button>
                            }
                            @if (selectedTicket.Status == RepairStatus.Ready)
                            {
                                <div class="text-end">
                                    <h4 class="text-success fw-bold mb-0 me-3 d-inline-block">До сплати: @selectedTicket.Price ₴</h4>
                                    @if (selectedTicket.Type == RepairType.InternalStock)
                                    {
                                        <button class="btn btn-primary btn-lg shadow" @onclick="ConfirmInternalReceipt">На склад</button>
                                    }
                                    else
                                    {
                                        <button class="btn btn-success btn-lg shadow" @onclick="OpenPaymentModal"><i class="bi bi-wallet2 me-2"></i> Оплатити</button>
                                    }
                                </div>
                            }
                        </div>
                    }
                    else
                    {

                        <div class="alert alert-success text-center"><h4>Закрито</h4></div>
                    }
                </div>
            </div>
        </div>
    </div>
}

@* 5. ОПЛАТА *@
@if (showPaymentModal && selectedTicket != null)
{
    <div class="modal fade show d-block" style="background: rgba(0,0,0,0.6);">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content shadow-lg">
                <div class="modal-header bg-success text-white">
                    <h5 class="modal-title">Оплата (Борг: @selectedTicket.Price ₴)</h5>
                    <button class="btn-close btn-close-white" @onclick="() => showPaymentModal = false"></button>
                </div>
                <div class="modal-body bg-light">
                    <div class="card border-0 shadow-sm mb-3">
                        <div class="card-body p-3">
                            @foreach (var part in paymentParts)
                            {
                                <div class="row g-2 mb-3 align-items-end border-bottom pb-3">
                                    <div class="col-md-3">
                                        <select class="form-select fw-bold" @bind="part.Method">
                                            @foreach (var m in new[] { "Готівка", "USD", "EUR", "Картка", "Термінал" })
                                            {
                                                <option value="@m">@m</option>
                                            }
                                        </select>
                                    </div>
                                    <div class="col-md-3"><input type="number" class="form-control fw-bold" @bind="part.Amount" /></div>
                                    @if (part.Method == "USD" || part.Method == "EUR")
                                    {
                                        <div class="col-md-2"><input type="number" class="form-control border-warning" @bind="part.ExchangeRate" /></div>
                                        <div class="col-md-3 text-success fw-bold align-self-center">= @((part.Amount * part.ExchangeRate).ToString("N0"))</div>
                                    }
                                    else
                                    {

                                        <div class="col-md-5 text-muted small align-self-center">Курс 1.0</div>
                                    }
                                    <div class="col-md-1"><button class="btn btn-outline-danger btn-sm" @onclick="() => RemovePaymentLine(part)">X</button></div>
                                </div>
                            }
                            <button class="btn btn-link fw-bold btn-sm" @onclick="AddPaymentLine">+ Додати метод оплати</button>
                        </div>
                    </div>
                    <div class="d-flex justify-content-between px-3 py-2 bg-white rounded border">
                        <div class="fs-5">Внесено: <strong>@TotalPaid.ToString("N0")</strong></div>
                        @if (Remaining > 0)
                        {
                            <div class="fs-5 text-danger fw-bold">Ще: @Remaining.ToString("N0")</div>
                        }
                        else
                        {

                            <div class="fs-5 text-success fw-bold">ОК (Решта: @Math.Abs(Remaining).ToString("N0"))</div>
                        }
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="() => showPaymentModal = false">Відміна</button>
                    <button class="btn btn-success px-5 fw-bold" @onclick="ConfirmPayment" disabled="@(Remaining > 0)">
                        Підтвердити оплату
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    // --- ДАНІ ---
    private List<RepairTicket> tickets = new();
    private List<DeviceView> availableStock = new();

    // --- ПОСЛУГИ ---
    private List<RepairService> availableServices = new();
    private string serviceSearchQuery = "";
    private IEnumerable<RepairService> FilteredServices => availableServices.Where(s => s.Name.Contains(serviceSearchQuery, StringComparison.OrdinalIgnoreCase));

    // --- СТАТИСТИКА ---
    private FinancialStatsDto? stats;
    private bool showStatsModal = false;

    // --- СТАН UI ---
    private RepairTicket newTicket = new();
    private RepairTicket? selectedTicket;
    private bool showCreateModal = false, showEditModal = false, showPaymentModal = false, showHistoryModal = false;
    private bool isLoaded = false;
    private bool isTechnicianMode = false, hasAdminRole = false;
    private string currentUserId = "";
    private int currentStoreId = 1;

    // --- ОПЛАТА ---
    private List<SalePayment> paymentParts = new();
    private decimal TotalPaid => paymentParts.Sum(x => x.Amount * (x.Method == "USD" || x.Method == "EUR" ? x.ExchangeRate : 1));
    private decimal Remaining => (selectedTicket?.Price ?? 0) - TotalPaid;

    // --- РЕДАГУВАННЯ ---
    private int editingBattery;
    private string editingCondition = "Used";

    protected override Task OnInitializedAsync() => Task.CompletedTask;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                var authState = await AuthStateProvider.GetAuthenticationStateAsync();
                var user = authState.User;
                if (user.Identity != null && user.Identity.IsAuthenticated)
                {
                    currentUserId = user.FindFirst("sub")?.Value ?? user.FindFirst(ClaimTypes.NameIdentifier)?.Value ?? "Unknown";
                    if (int.TryParse(user.FindFirst("StoreId")?.Value, out int sId)) currentStoreId = sId;
                    hasAdminRole = user.IsInRole("Admin") || user.IsInRole("Technician");
                    if (hasAdminRole) isTechnicianMode = true;
                }
                await LoadData();
                isLoaded = true;
                StateHasChanged();
            }
            catch (Exception ex) { Console.WriteLine($"Auth Error: {ex.Message}"); }
        }
    }

    private async Task LoadData()
    {
        try
        {
            tickets = await Http.GetFromJsonAsync<List<RepairTicket>>("api/repairs") ?? new();
            var allDevices = await Http.GetFromJsonAsync<List<DeviceView>>("api/inventory/devices") ?? new();
            var busyDeviceIds = tickets.Where(t => t.Status != RepairStatus.Completed && t.Status != RepairStatus.ReturnedToStore && t.DeviceStockId.HasValue).Select(t => t.DeviceStockId.Value).ToHashSet();
            availableStock = allDevices.Where(d => d.StoreId == currentStoreId && d.IsSold == 0 && !busyDeviceIds.Contains(d.Id)).ToList();
        }
        catch (Exception e) { Console.WriteLine($"LoadData Error: {e.Message}"); }
    }

    private async Task LoadFinancialStats()
    {
        try { stats = await Http.GetFromJsonAsync<FinancialStatsDto>("api/repairs/stats"); showStatsModal = true; }
        catch { await JsRuntime.InvokeVoidAsync("alert", "Помилка завантаження звіту"); }
    }

    private async void OpenEditModal(RepairTicket t)
    {
        selectedTicket = new RepairTicket { Id = t.Id, Status = t.Status, IssueDescription = t.IssueDescription, DeviceModel = t.DeviceModel, SerialNumber = t.SerialNumber, TicketNumber = t.TicketNumber, ResolutionReport = t.ResolutionReport, CostPart = t.CostPart, Price = t.Price, Type = t.Type, DeviceStockId = t.DeviceStockId, DeviceStock = t.DeviceStock, CompletedAt = t.CompletedAt, TechnicianId = t.TechnicianId, ClientName = t.ClientName, ClientPhone = t.ClientPhone };
        if (t.DeviceStock != null) { editingBattery = t.DeviceStock.BatteryHealth; editingCondition = t.DeviceStock.ConditionStatus; }
        string modelToSearch = t.DeviceStock?.ModelName ?? t.DeviceModel ?? "";
        try { availableServices = await Http.GetFromJsonAsync<List<RepairService>>($"api/repairs/services?modelName={Uri.EscapeDataString(modelToSearch)}") ?? new(); } catch { availableServices = new(); }
        showEditModal = true; StateHasChanged();
    }

    private void AddServiceToTicket(RepairService service)
    {
        if (selectedTicket == null) return;
        selectedTicket.Price += service.Price;
        selectedTicket.CostPart += service.CostPrice;
        selectedTicket.ResolutionReport = string.IsNullOrEmpty(selectedTicket.ResolutionReport) ? service.Name : selectedTicket.ResolutionReport + $", {service.Name}";
    }

    private async Task ChangeStatus(RepairStatus s)
    {
        if (selectedTicket == null) return;
        if (s == RepairStatus.Ready && string.IsNullOrEmpty(selectedTicket.ResolutionReport)) { await JsRuntime.InvokeVoidAsync("alert", "⚠️ Заповніть поле 'Звіт'!"); return; }
        var p = new { Id = selectedTicket.Id, Status = s, ResolutionReport = selectedTicket.ResolutionReport, CostPart = selectedTicket.CostPart, Price = selectedTicket.Price, TechnicianId = (s == RepairStatus.InProgress) ? currentUserId : selectedTicket.TechnicianId };
        var r = await Http.PutAsJsonAsync("api/repairs/status", p);
        if (r.IsSuccessStatusCode) { showEditModal = false; await LoadData(); StateHasChanged(); } else { await JsRuntime.InvokeVoidAsync("alert", "Помилка сервера"); }
    }

    private async Task UpdateTicketDetails() { if (selectedTicket == null) return; var payload = new { Id = selectedTicket.Id, Status = selectedTicket.Status, ResolutionReport = selectedTicket.ResolutionReport, CostPart = selectedTicket.CostPart, Price = selectedTicket.Price, TechnicianId = selectedTicket.TechnicianId }; await Http.PutAsJsonAsync("api/repairs/status", payload); await LoadData(); }
    private async Task SaveDeviceSpecs() { if (selectedTicket?.DeviceStockId == null) return; if (selectedTicket.DeviceStock != null) { selectedTicket.DeviceStock.BatteryHealth = editingBattery; selectedTicket.DeviceStock.ConditionStatus = editingCondition; } await Http.PutAsJsonAsync("api/repairs/update-device-specs", new DeviceStock { Id = selectedTicket.DeviceStockId.Value, BatteryHealth = editingBattery, ConditionStatus = editingCondition }); await LoadData(); }
    private void OpenNewTicketModal() { newTicket = new() { StoreId = currentStoreId, Status = RepairStatus.New }; showCreateModal = true; }
    private async Task CreateTicket() { newTicket.StoreId = currentStoreId; await Http.PostAsJsonAsync("api/repairs", newTicket); showCreateModal = false; await LoadData(); }
    private async Task ToggleTechnicianMode(ChangeEventArgs e) { bool on = (bool)e.Value!; if (on && !hasAdminRole) { string? pin = await JsRuntime.InvokeAsync<string>("prompt", "PIN:"); if (pin == "1111") isTechnicianMode = true; else { await JsRuntime.InvokeVoidAsync("alert", "Невірний PIN"); isTechnicianMode = false; StateHasChanged(); } } else isTechnicianMode = on; }
    private void OpenPaymentModal() { if (selectedTicket == null) return; paymentParts = new() { new SalePayment { Amount = selectedTicket.Price } }; showPaymentModal = true; }
    private void AddPaymentLine() => paymentParts.Add(new SalePayment { Amount = Remaining > 0 ? Remaining : 0 });
    private void RemovePaymentLine(SalePayment p) { paymentParts.Remove(p); if (!paymentParts.Any()) AddPaymentLine(); }

    private async Task ConfirmPayment()
    {
        if (selectedTicket == null) return;

        var req = new RepairPaymentRequest { TicketId = selectedTicket.Id, Payments = paymentParts };
        var response = await Http.PostAsJsonAsync("api/repairs/complete-payment", req);

        if (response.IsSuccessStatusCode)
        {
            // Отримуємо ID створеного чеку
            var result = await response.Content.ReadFromJsonAsync<PaymentResponse>();

            showPaymentModal = false;
            showEditModal = false;
            await LoadData();

            bool print = await JsRuntime.InvokeAsync<bool>("confirm", "✅ Оплата успішна! Відкрити чек?");
            if (print && result != null)
            {
                // ПЕРЕНАПРАВЛЯЄМО НА ВАШУ СТОРІНКУ ЧЕКУ
                // (Припускаю, що у вас є сторінка деталей продажу, наприклад /sale-details/{id})
                NavManager.NavigateTo($"/sale-details/{result.SaleId}");
            }
        }
        else
        {
            var e = await response.Content.ReadAsStringAsync();
            await JsRuntime.InvokeVoidAsync("alert", $"Помилка: {e}");
        }
    }

    // Клас для отримання ID (додайте в кінець файлу)
    public class PaymentResponse { public int SaleId { get; set; } }
    private async Task ConfirmInternalReceipt() { if (selectedTicket == null) return; if (!await JsRuntime.InvokeAsync<bool>("confirm", "Повернути на склад?")) return; var r = await Http.PostAsync($"api/repairs/confirm-return/{selectedTicket.Id}", null); if (r.IsSuccessStatusCode) { showEditModal = false; await LoadData(); } }

