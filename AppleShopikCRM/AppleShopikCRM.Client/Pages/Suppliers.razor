            </div>
            <div class="ms-body">
                <div style="background:#e8f4fd; padding:12px; border-radius:8px; border:1px solid #b6d4fe; margin-bottom:10px;">
                    <div style="font-size:12px; color:#084298;">Наш борг перед постачальником:</div>
                    <div style="font-size:20px; font-weight:700; color:#052c65;">$@selectedSupplier.Debt.ToString("N2")</div>
                </div>

