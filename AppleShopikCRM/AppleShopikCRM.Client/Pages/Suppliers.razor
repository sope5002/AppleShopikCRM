            <div class="ms-footer">
                <button class="btn-apple outline" @onclick="() => showPaymentModal = false">Скасувати</button>
                <button class="btn-apple success" @onclick="SubmitPayment" disabled="@isProcessing">
                    @if (isProcessing)
                    {
                        <span class="spinner-border spinner-border-sm me-1"></span>
                    }
                    <i class="bi bi-wallet2"></i> Списати з каси
                </button>
            </div>
        </div>
    </div>
}

@* ОНОВЛЕНА МОДАЛКА: ПОСТАЧАЛЬНИК ПОВЕРТАЄ БОРГ НАМ *@
@if (showReceivePaymentModal && selectedSupplier != null)
{
    <div class="modal-backdrop-apple" @onclick="() => showReceivePaymentModal = false">
        <div class="modal-sheet" @onclick:stopPropagation>
            <div class="ms-header">
                <h3 class="ms-title">Отримання боргу: @selectedSupplier.Name</h3>
                <button class="ms-close" @onclick="() => showReceivePaymentModal = false"><i class="bi bi-x"></i></button>
            </div>
            <div class="ms-body">
                @if (receivePaymentReq.SaleId.HasValue)
                {
                    <div style="background:rgba(52,199,89,.1); padding:12px; border-radius:8px; border:1px solid rgba(52,199,89,.3); margin-bottom:10px;">
                        <div style="font-size:12px; color:#1a7a35;">Оплата за конкретний чек/телефон. Залишок боргу:</div>
                        <div style="font-size:20px; font-weight:700; color:var(--apple-green);">$@specificDebtTargetAmount.ToString("N2")</div>
                    </div>
                }
                else
                {
                    <div style="background:rgba(52,199,89,.1); padding:12px; border-radius:8px; border:1px solid rgba(52,199,89,.3); margin-bottom:10px;">
                        <div style="font-size:12px; color:#1a7a35;">Постачальник винен нам загалом:</div>
                        <div style="font-size:20px; font-weight:700; color:var(--apple-green);">$@Math.Abs(selectedSupplier.Debt).ToString("N2")</div>
                    </div>
                }

                @if (!string.IsNullOrEmpty(paymentError))
                {
                    <div style="color:var(--apple-red); font-size:13px; font-weight:600; margin-bottom:10px;">@paymentError</div>
                }

                <div style="display:flex; gap:10px; margin-bottom: 12px;">
                    <div style="flex: 1;">
                        <label class="apple-label" style="margin-top:0;">Сума оплати</label>
                        <input type="number" class="apple-input" style="font-weight:700; font-size:1.2rem;" @bind="receivePaymentReq.Amount" />
                    </div>
                    <div style="flex: 1;">
                        <label class="apple-label" style="margin-top:0;">Валюта оплати</label>
                        <select class="apple-input" @bind="receivePaymentReq.Currency">
                            <option value="USD">Долар ($)</option>
                            <option value="Готівка">Готівка (₴)</option>
                            <option value="EUR">Євро (€)</option>
                            <option value="Картка">На карту</option>
                        </select>
                    </div>
                </div>

                @if (receivePaymentReq.Currency != "USD")
                {
                    <div style="padding: 10px; border: 1px dashed var(--apple-blue); border-radius: 8px; background: rgba(0,113,227,.05); margin-bottom: 12px;">
                        <label class="apple-label" style="margin-top:0;">За яким курсом рахувати погашення боргу?</label>
                        <div style="display: flex; gap: 10px; align-items: center;">
                            <input type="number" class="apple-input" style="width: 100px;" @bind="receivePaymentReq.ExchangeRate" />
                            <span style="font-size: 13px; color: var(--apple-sub);">Спишеться боргу: <b>$@(Math.Round(receivePaymentReq.Amount / (receivePaymentReq.ExchangeRate > 0 ? receivePaymentReq.ExchangeRate : 1), 2))</b></span>
                        </div>
                    </div>
                }

                <label class="apple-label">Коментар</label>
                <input type="text" class="apple-input" @bind="receivePaymentReq.Comment" placeholder="Повернення коштів..." />
            </div>
            <div class="ms-footer">
                <button class="btn-apple outline" @onclick="() => showReceivePaymentModal = false">Скасувати</button>
                <button class="btn-apple primary" @onclick="SubmitReceivePayment" disabled="@isProcessing">
                    @if (isProcessing)
                    {
                        <span class="spinner-border spinner-border-sm me-1"></span>
                    }
                    <i class="bi bi-box-arrow-in-down"></i> Покласти в касу
                </button>
            </div>
        </div>
    </div>
}

@* 🔥 ОНОВЛЕНА МОДАЛКА: МИ ВІДДАЄМО ТОВАР ПОСТАЧАЛЬНИКУ *@
@if (showGiveDeviceModal && selectedSupplier != null)
{
    <div class="modal-backdrop-apple" @onclick="() => showGiveDeviceModal = false">
        <div class="modal-sheet" @onclick:stopPropagation>
            <div class="ms-header">
                <h3 class="ms-title">Віддати товар: @selectedSupplier.Name</h3>
                <button class="ms-close" @onclick="() => showGiveDeviceModal = false"><i class="bi bi-x"></i></button>
            </div>
            <div class="ms-body">

                <label class="apple-label" style="margin-top:0;">Джерело продажу (для статистики)</label>
                <div class="segment-control" style="margin-bottom: 16px; width: 100%;">
                    <button class="segment-btn @(giveReq.Source == "Опт" ? "active" : "")" style="flex:1;" @onclick='() => giveReq.Source = "Опт"'>Опт</button>
                    <button class="segment-btn @(giveReq.Source == "Offline" ? "active" : "")" style="flex:1;" @onclick='() => giveReq.Source = "Offline"'>Офлайн</button>
                </div>

                <div style="background:#fafafa; padding:12px; border-radius:8px; border:1px solid #d2d2d7; margin-bottom:16px;">
                    <div style="font-size:12px; color:var(--apple-sub); margin-bottom:4px;">Поточний баланс (Борг):</div>
                    @if (selectedSupplier.Debt > 0)
                    {
                        <div style="font-weight:700; color:var(--apple-red);">Ми винні: $@selectedSupplier.Debt.ToString("N2")</div>
                    }
                    else if (selectedSupplier.Debt < 0)
                    {
                        <div style="font-weight:700; color:var(--apple-green);">Він винен: $@Math.Abs(selectedSupplier.Debt).ToString("N2")</div>
                    }
                    else
                    {
                        <div style="font-weight:700;">$0.00</div>
                    }
                </div>

                @if (!string.IsNullOrEmpty(paymentError))
                {
                    <div style="color:var(--apple-red); font-size:13px; font-weight:600; margin-bottom:10px;">@paymentError</div>
                }

                <div class="search-container mb-3">
                    <label class="apple-label" style="margin-top:0;">Оберіть пристрій зі складу *</label>
                    <input type="text" class="apple-input" placeholder="🔍 Введіть назву або IMEI..."
                           value="@giveSearchTerm" @oninput="OnGiveSearchInput" @onfocus="() => isGiveDropdownOpen = true" autocomplete="off" />

                    @if (isGiveDropdownOpen && giveReq.DeviceId == 0 && !string.IsNullOrWhiteSpace(giveSearchTerm))
                    {
                        <div class="autocomplete-dropdown">
                            @{
                                var filtered = GetFilteredDevices(giveSearchTerm);
                            }
                            @if (filtered.Any())
                            {
                                foreach (var d in filtered)
                                {
                                    <div class="ac-item" @onclick='() => SelectDeviceToGive(d)'>
                                        <strong style="color:var(--apple-text); font-size: 14px;">@d.ModelName @d.Capacity @d.Color</strong>
                                        <span style="color:#6e6e73; font-size:12px; font-family: monospace;">
                                            IMEI: @d.Identifier
                                            @if (isAdmin)
                                            {
                                                <text>| Закупка: $@d.PurchasePrice</text>
                                            }
                                        </span>
                                    </div>
                                }
                            }
                            else
                            {
                                <div class="ac-item text-muted">Нічого не знайдено</div>
                            }
                        </div>
                    }

                    @if (giveReq.DeviceId > 0)
                    {
                        <div style="padding: 10px; background: rgba(0,113,227,.1); border: 1px solid rgba(0,113,227,.3); border-radius: 8px; margin-top: 8px; display: flex; justify-content: space-between; align-items: center;">
                            <div>
                                <div style="font-weight: 600; color: var(--apple-text); font-size: 14px;">@giveSearchTerm</div>
                            </div>
                            <button style="border:none; background:transparent; color:var(--apple-sub); cursor:pointer;" @onclick='() => { giveReq.DeviceId = 0; giveSearchTerm = ""; }'><i class="bi bi-x-circle-fill"></i></button>
                        </div>
                    }
                </div>

                <div style="display:flex; gap:10px; margin-bottom: 12px;">
                    <div style="flex:1;">
                        <label class="apple-label">Домовлена ціна ($)</label>
                        <input type="number" class="apple-input" @bind="giveReq.AgreedPriceUSD" />
                    </div>
                    <div style="flex:1;">
                        <label class="apple-label">Він дає одразу</label>
                        <input type="number" class="apple-input" @bind="giveReq.PaidNowAmount" />
                    </div>
                </div>

                <div style="display:flex; gap:10px; margin-bottom: 12px;">
                    <div style="flex:1;">
                        <label class="apple-label" style="margin-top:0;">Валюта оплати</label>
                        <select class="apple-input" @bind="giveReq.PaidNowCurrency">
                            <option value="USD">Долар ($)</option>
                            <option value="Готівка">Готівка (₴)</option>
                            <option value="EUR">Євро (€)</option>
                            <option value="Картка">На карту</option>
                        </select>
                    </div>
                    @if (giveReq.PaidNowCurrency != "USD")
                    {
                        <div style="flex:1;">
                            <label class="apple-label" style="margin-top:0;">Курс рахування</label>
                            <input type="number" class="apple-input" @bind="giveReq.ExchangeRate" />
                        </div>
                    }
                </div>

                @if (giveReq.AgreedPriceUSD > 0)
                {
                    decimal paidNowUSD_calc = giveReq.PaidNowCurrency == "USD" ? giveReq.PaidNowAmount : Math.Round(giveReq.PaidNowAmount / (giveReq.ExchangeRate > 0 ? giveReq.ExchangeRate : 1), 2);
                    decimal owesUs = giveReq.AgreedPriceUSD - paidNowUSD_calc;

                    <div style="margin-top: 12px; font-size: 13px; color: var(--apple-sub);">
                        Залишок: постачальник залишиться винен вам <strong style="color:var(--apple-text);">$@owesUs</strong> за цей телефон.<br />
                        Ця сума відніметься від вашого загального боргу перед ним.
                    </div>
                }

            </div>
            <div class="ms-footer">
                <button class="btn-apple outline" @onclick="() => showGiveDeviceModal = false">Скасувати</button>
                <button class="btn-apple primary" @onclick="SubmitGiveDevice" disabled="@(giveReq.DeviceId == 0 || giveReq.AgreedPriceUSD <= 0 || isProcessing)">
                    @if (isProcessing)
                    {
                        <span class="spinner-border spinner-border-sm me-1"></span>
                    }
                    <i class="bi bi-box-arrow-right"></i> Віддати товар
                </button>
            </div>
        </div>
    </div>
}


@code {
    private bool isAdmin = false;
    private string currentTab = "list";
    private List<Supplier> suppliers = new();
    private List<ConsignmentDebtDto> debts = new();
    private List<PaidHistoryDto> paidHistory = new();
    private List<Store> stores = new();
    private bool isLoading = true;

    private bool showSupplierModal = false;
    private Supplier editingSupplier = new();

    private bool showPaymentModal = false; // Ми платимо
    private bool showReceivePaymentModal = false; // Нам платять
    private bool showGiveDeviceModal = false; // Ми віддаємо товар

    private bool showOutboundDebtsModal = false;
    private bool isLoadingOutbound = false;
    private List<OutboundDebtDto> outboundDebts = new();
    private decimal specificDebtTargetAmount = 0;

    private bool isProcessing = false;
    private string paymentError = "";
    private Supplier? selectedSupplier;

    private PayDebtRequest paymentReq = new();
    private ReceivePaymentRequest receivePaymentReq = new();
    private GiveDeviceRequest giveReq = new();

    private int currentStoreId = 0;
    private HashSet<string> expandedHistory = new();

    private List<DeviceView> availableDevices = new();
    private string giveSearchTerm = "";
    private bool isGiveDropdownOpen = false;

    class ConsignmentDebtDto { public int DeviceId { get; set; } public string SupplierName { get; set; } = ""; public string ModelName { get; set; } = ""; public string Identifier { get; set; } = ""; public decimal PurchasePrice { get; set; } public decimal PaidAmount { get; set; } public decimal DebtUSD { get; set; } public bool IsSold { get; set; } }
    class PaidHistoryDto { public int DeviceId { get; set; } public string SupplierName { get; set; } = ""; public string ModelName { get; set; } = ""; public string Identifier { get; set; } = ""; public decimal PurchasePrice { get; set; } public DateTime DateAdded { get; set; } }

    // 🔥 Оновлена модель з PurchasePrice
    class DeviceView { public int Id { get; set; } public string ModelName { get; set; } = ""; public string Capacity { get; set; } = ""; public string Color { get; set; } = ""; public string Identifier { get; set; } = ""; public int IsSold { get; set; } public decimal SellingPrice { get; set; } public decimal PurchasePrice { get; set; } }

    // 🔥 Оновлена модель для списку боргів
    class OutboundDebtDto { public int SaleId { get; set; } public DateTime Date { get; set; } public string ModelName { get; set; } = ""; public string Imei { get; set; } = ""; public decimal AgreedPriceUSD { get; set; } public decimal RemainingDebtUSD { get; set; } public bool IsFullyPaid { get; set; } public string Status { get; set; } = ""; }

    public class PayDebtRequest { public int StoreId { get; set; } public decimal Amount { get; set; } public string Comment { get; set; } = ""; }
    public class ReceivePaymentRequest { public int StoreId { get; set; } public decimal Amount { get; set; } public string Currency { get; set; } = "USD"; public decimal ExchangeRate { get; set; } = 41.5m; public string Comment { get; set; } = ""; public int? SaleId { get; set; } }
    public class GiveDeviceRequest { public int StoreId { get; set; } public int DeviceId { get; set; } public decimal AgreedPriceUSD { get; set; } public decimal PaidNowAmount { get; set; } public string PaidNowCurrency { get; set; } = "USD"; public decimal ExchangeRate { get; set; } = 41.5m; public string Source { get; set; } = "Опт"; }

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        isAdmin = user.IsInRole("Admin");

        var storeClaim = user.FindFirst("StoreId");
        if (storeClaim != null && int.TryParse(storeClaim.Value, out int sId)) currentStoreId = sId;

        await LoadData();

        try
        {
            stores = await Http.GetFromJsonAsync<List<Store>>("api/transfers/stores") ?? new();
            if (currentStoreId == 0 && stores.Any()) currentStoreId = stores.First().Id;
        }
        catch { }
    }

    private async Task LoadData()
    {
        isLoading = true;
        StateHasChanged();
        try
        {
            suppliers = await Http.GetFromJsonAsync<List<Supplier>>("api/suppliers") ?? new();

            if (isAdmin && currentTab == "debts") debts = await Http.GetFromJsonAsync<List<ConsignmentDebtDto>>("api/suppliers/consignment-debts") ?? new();
            if (isAdmin && currentTab == "history") paidHistory = await Http.GetFromJsonAsync<List<PaidHistoryDto>>("api/suppliers/paid-history") ?? new();
        }
        catch { }
        isLoading = false;
        StateHasChanged();
    }

    private async Task LoadDebtsTab() { currentTab = "debts"; await LoadData(); }
    private async Task LoadHistoryTab() { currentTab = "history"; expandedHistory.Clear(); await LoadData(); }

    private void ToggleHistory(string supplierName)
    {
        if (expandedHistory.Contains(supplierName)) expandedHistory.Remove(supplierName);
        else expandedHistory.Add(supplierName);
    }

    private void OpenSupplierModal(Supplier? s)
    {
        editingSupplier = s != null ? new Supplier { Id = s.Id, Name = s.Name, Phone = s.Phone, Notes = s.Notes, Debt = s.Debt } : new Supplier();
        showSupplierModal = true;
    }

    private async Task SaveSupplier()
    {
        if (string.IsNullOrWhiteSpace(editingSupplier.Name)) return;
        if (editingSupplier.Id == 0) await Http.PostAsJsonAsync("api/suppliers", editingSupplier);
        else await Http.PutAsJsonAsync($"api/suppliers/{editingSupplier.Id}", editingSupplier);

        showSupplierModal = false;
        await LoadData();
    }

    private void OpenPaymentModal(Supplier s)
    {
        selectedSupplier = s;
        paymentReq = new PayDebtRequest { StoreId = currentStoreId, Amount = s.Debt, Comment = "" };
        paymentError = "";
        showPaymentModal = true;
    }

    private async Task SubmitPayment()
    {
        if (paymentReq.StoreId == 0) { paymentError = "Магазин не визначено."; return; }
        if (paymentReq.Amount <= 0) { paymentError = "Сума має бути > 0."; return; }

        isProcessing = true; paymentError = "";
        try
        {
            var res = await Http.PostAsJsonAsync($"api/suppliers/{selectedSupplier!.Id}/pay", paymentReq);
            if (res.IsSuccessStatusCode)
            {
                await JS.InvokeVoidAsync("alert", "Оплату успішно списано з каси, борг розподілено по товарах!");
                showPaymentModal = false;
                await LoadData();
            }
            else { paymentError = await res.Content.ReadAsStringAsync(); }
        }
        catch (Exception ex) { paymentError = ex.Message; }
        finally { isProcessing = false; }
    }

    private async Task OpenOutboundDebtsModal(Supplier s)
    {
        selectedSupplier = s;
        showOutboundDebtsModal = true;
        isLoadingOutbound = true;
        outboundDebts.Clear();
        StateHasChanged();

        try
        {
            outboundDebts = await Http.GetFromJsonAsync<List<OutboundDebtDto>>($"api/suppliers/{s.Id}/outbound-debts") ?? new();
        }
        catch { }
        finally { isLoadingOutbound = false; StateHasChanged(); }
    }

    private void OpenReceivePaymentModal(Supplier s, int? saleId, decimal? specificAmount)
    {
        selectedSupplier = s;
        decimal storeRate = stores.FirstOrDefault(st => st.Id == currentStoreId)?.ExchangeRate ?? 41.5m;
        specificDebtTargetAmount = specificAmount ?? Math.Abs(s.Debt);

        receivePaymentReq = new ReceivePaymentRequest
        {
            StoreId = currentStoreId,
            Amount = specificDebtTargetAmount,
            Comment = "",
            SaleId = saleId,
            Currency = "USD",
            ExchangeRate = storeRate
        };
        paymentError = "";
        showReceivePaymentModal = true;
    }

    private async Task SubmitReceivePayment()
    {
        if (receivePaymentReq.Amount <= 0) { paymentError = "Сума має бути > 0."; return; }

        isProcessing = true; paymentError = "";
        try
        {
            var res = await Http.PostAsJsonAsync($"api/suppliers/{selectedSupplier!.Id}/receive-payment", receivePaymentReq);
            if (res.IsSuccessStatusCode)
            {
                await JS.InvokeVoidAsync("alert", "Гроші успішно додано в касу!");
                showReceivePaymentModal = false;

                if (showOutboundDebtsModal)
                {
                    await OpenOutboundDebtsModal(selectedSupplier);
                }

                await LoadData();
            }
            else { paymentError = await res.Content.ReadAsStringAsync(); }
        }
        catch (Exception ex) { paymentError = ex.Message; }
        finally { isProcessing = false; }
    }

    private async Task OpenGiveDeviceModal(Supplier s)
    {
        selectedSupplier = s;
        decimal storeRate = stores.FirstOrDefault(st => st.Id == currentStoreId)?.ExchangeRate ?? 41.5m;

        giveReq = new GiveDeviceRequest
        {
            StoreId = currentStoreId,
            DeviceId = 0,
            AgreedPriceUSD = 0,
            PaidNowAmount = 0,
            PaidNowCurrency = "USD",
            ExchangeRate = storeRate,
            Source = "Опт"
        };
        giveSearchTerm = "";
        paymentError = "";

        try { availableDevices = await Http.GetFromJsonAsync<List<DeviceView>>("api/inventory/devices") ?? new(); availableDevices = availableDevices.Where(d => d.IsSold == 0).ToList(); } catch { }
        showGiveDeviceModal = true;
    }

    private void OnGiveSearchInput(ChangeEventArgs e)
    {
        giveSearchTerm = e.Value?.ToString() ?? "";
        giveReq.DeviceId = 0;
        isGiveDropdownOpen = true;
    }

    private List<DeviceView> GetFilteredDevices(string term)
    {
        var tokens = term.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return availableDevices.Where(d => tokens.All(t => (d.ModelName ?? "").Contains(t, StringComparison.OrdinalIgnoreCase) || (d.Identifier ?? "").Contains(t, StringComparison.OrdinalIgnoreCase))).Take(10).ToList();
    }

    private void SelectDeviceToGive(DeviceView d)
    {
        giveReq.DeviceId = d.Id;
        // 🔥 Менеджерам підставляється ціна продажу, Адмінам - ціна закупки
        giveReq.AgreedPriceUSD = isAdmin ? d.PurchasePrice : d.SellingPrice;
        giveSearchTerm = $"{d.ModelName} {d.Capacity} {d.Color} - {d.Identifier}";
        isGiveDropdownOpen = false;
    }

    private async Task SubmitGiveDevice()
    {
        if (giveReq.DeviceId == 0) { paymentError = "Оберіть пристрій."; return; }
        if (giveReq.AgreedPriceUSD <= 0) { paymentError = "Вкажіть ціну."; return; }

        isProcessing = true; paymentError = "";
        try
        {
            var res = await Http.PostAsJsonAsync($"api/suppliers/{selectedSupplier!.Id}/give-device", giveReq);
            if (res.IsSuccessStatusCode)
            {
                await JS.InvokeVoidAsync("alert", "Товар успішно віддано, борг перераховано!");
                showGiveDeviceModal = false; await LoadData();
            }
            else { paymentError = await res.Content.ReadAsStringAsync(); }
        }
        catch (Exception ex) { paymentError = ex.Message; }
        finally { isProcessing = false; }
    }

    private async Task PayDeviceIndividual(int deviceId)
    {
        bool confirm = await JS.InvokeAsync<bool>("confirm", "Ви впевнені, що розрахувалися з постачальником САМЕ ЗА ЦЕЙ пристрій?");
        if (!confirm) return;

        var res = await Http.PostAsync($"api/suppliers/pay-supplier/{deviceId}", null);
        if (res.IsSuccessStatusCode) { await LoadData(); }
        else { await JS.InvokeVoidAsync("alert", "Помилка при закритті боргу за пристрій."); }
    }
}