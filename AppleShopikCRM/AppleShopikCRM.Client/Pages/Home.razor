    </Authorized>
    <NotAuthorized>
        @* Тільки тепер цей редірект спрацює правильно (якщо токена дійсно немає) *@
        <div class="alert alert-warning">Перевірка доступу...</div>
        <AppleShopikCRM.Client.Pages.RedirectToLogin />
    </NotAuthorized>
</AuthorizeView>

@* 🔥 МОДАЛЬНЕ ВІКНО ПРИВ'ЯЗКИ ТЕЛЕФОНУ *@
@if (showBindModal && bookingToBind != null)
{
    <div class="modal-backdrop-apple" @onclick="CloseBindModal">
        <div class="modal-sheet" style="max-width: 400px;" @onclick:stopPropagation>
            <div class="ms-header" style="padding: 14px 16px; border-bottom: 1px solid #e5e5ea; display: flex; justify-content: space-between; align-items: center;">
                <h6 style="margin: 0; font-weight: 700;"><i class="bi bi-link-45deg text-primary"></i> @(bookingToBind.DeviceStockId != null ? "Редагувати прив'язку" : "Прив'язка до складу")</h6>
                <button class="btn-close" @onclick="CloseBindModal"></button>
            </div>
            <div class="ms-body" style="padding: 16px;">
                @* 🔥 ПОЛЕ ПОШУКУ (IMEI або Модель) *@
                <div class="mb-3">
                    <label style="font-size: 11px; font-weight: 600; color: #6e6e73;">Швидкий пошук (Модель або IMEI)</label>
                    <div class="position-relative">
                        <i class="bi bi-search" style="position:absolute; left:10px; top:8px; color:#adb5bd;"></i>
                        <input type="text" class="form-control form-control-sm ps-4"
                               placeholder="Введіть IMEI або назву..."
                               @bind="deviceSearchQuery" @bind:event="oninput"
                               style="border-radius: 8px;" />
                    </div>
                </div>

                <div class="mb-3">
                    <label style="font-size: 11px; font-weight: 600; color: #6e6e73;">Виберіть пристрій *</label>
                    <select class="form-select form-select-sm" @bind="bindData.DeviceStockId" style="border-radius: 8px; height: 120px;" size="5">
                        <option value="0">-- Оберіть телефон --</option>
                        @{
                            // Фільтруємо список на льоту за моделлю або IMEI
                            var filtered = availableDevices
                            .Where(d => string.IsNullOrWhiteSpace(deviceSearchQuery) ||
                            d.ModelName!.Contains(deviceSearchQuery, StringComparison.OrdinalIgnoreCase) ||
                            d.Identifier.Contains(deviceSearchQuery))
                            .ToList();

                            @foreach (var dev in filtered)
                            {
                                <option value="@dev.Id">
                                    @($"{dev.ModelName} {dev.Capacity} {dev.Color} | {dev.Identifier} | {dev.SellingPrice:N0} ₴")
                                </option>
                            }
                        }
                    </select>
                    <div class="text-muted mt-1" style="font-size: 10px;">Знайдено: @availableDevices.Count(d => d.ModelName!.Contains(deviceSearchQuery, StringComparison.OrdinalIgnoreCase) || d.Identifier.Contains(deviceSearchQuery)) пристроїв</div>
                </div>
                <div class="row">
                    <div class="col-6 mb-3">
                        <label style="font-size: 11px; font-weight: 600; color: #6e6e73;">Ціна продажу *</label>
                        <input type="number" class="form-control form-control-sm" @bind="bindData.AgreedPrice" style="border-radius: 8px;" />
                    </div>
                    <div class="col-6 mb-3">
                        <label style="font-size: 11px; font-weight: 600; color: #6e6e73;">Завдаток</label>
                        <input type="number" class="form-control form-control-sm" @bind="bindData.DepositAmount" style="border-radius: 8px;" />
                    </div>
                </div>
                <div class="mb-3">
                    <label style="font-size: 11px; font-weight: 600; color: #6e6e73;">Ім'я клієнта</label>
                    <input type="text" class="form-control form-control-sm" @bind="bindData.CustomerName" style="border-radius: 8px;" />
                </div>
                <div class="mb-2">
                    <label style="font-size: 11px; font-weight: 600; color: #6e6e73;">Телефон клієнта</label>
                    <div class="position-relative">
                        <input type="text" class="form-control form-control-sm"
                               value="@bindData.CustomerPhone"
                               @oninput="OnPhoneInput"
                               placeholder="0991234567"
                               style="border-radius: 8px; padding-right: 30px;" />

                        @if (customerExistsInDb)
                        {
                            <i class="bi bi-check-circle-fill text-success"
                               style="position: absolute; right: 10px; top: 6px; font-size: 16px;"
                               title="Клієнт вже є в базі"></i>
                        }
                    </div>
                </div>
            </div>
            <div class="ms-footer" style="padding: 12px 16px; border-top: 1px solid #e5e5ea; display: flex; justify-content: flex-end; gap: 8px; background: #fafafa;">
                @if (bookingToBind.DeviceStockId != null)
                {
                    <button class="btn btn-outline-danger btn-sm me-auto" style="border-radius: 8px; font-weight: 600;" @onclick="UnbindDevice">Відв'язати</button>
                }
                <button class="btn btn-light btn-sm" style="border-radius: 8px; font-weight: 600;" @onclick="CloseBindModal">Скасувати</button>
                <button class="btn btn-primary btn-sm" style="border-radius: 8px; font-weight: 600;" disabled="@(bindData.DeviceStockId == 0 || bindData.AgreedPrice <= 0 || isBinding)" @onclick="SaveBinding">
                    @if (isBinding)
                    {
                        <span class="spinner-border spinner-border-sm me-2"></span>
                    }
     Зберегти
                </button>
            </div>
        </div>
    </div>
}

<style>
