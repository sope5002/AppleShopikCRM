@page "/"
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Web
@using System.Security.Claims
@using Microsoft.AspNetCore.SignalR.Client
@using System.Net.Http.Json
@using AppleShopikCRM.Client.Models
@using System.Text.RegularExpressions

@* 👇 ЦЕЙ РЯДОК - КЛЮЧ ДО УСПІХУ *@
@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))

<PageTitle>Головна</PageTitle>

<PageTitle>Головна — Apple Shopik</PageTitle>

<AuthorizeView>
    <Authorized>
        <div class="text-center mt-5">
            <h1>👋 Привіт, @context.User.Identity?.Name!</h1>
            <p class="lead">Ви успішно увійшли в систему CRM.</p>

            <div class="d-flex justify-content-center gap-3 mt-4">
                <a href="sales" class="btn btn-primary btn-lg shadow">
                    <i class="bi bi-cart3 me-2"></i>Продажі
                </a>
                <a href="repairs" class="btn btn-warning btn-lg shadow">
                    <i class="bi bi-tools me-2"></i>Ремонти
                </a>
                </div>
            </div>

            <div class="row">
                @* КОЛОНКА 1: СЬОГОДНІ *@
                <div class="col-md-6 mb-4">
                    <div class="card shadow-sm border-0" style="border-radius: 14px; background: #fff;">
                        <div class="card-header bg-white border-0 pt-3 pb-2">
                            <h6 class="fw-bold mb-0 text-success"><i class="bi bi-brightness-high me-2"></i>На СЬОГОДНІ @if (TodayBookings.Any()) {
                            <span class="badge bg-success ms-2 rounded-pill">@TodayBookings.Count</span>
                                                        }
</h6>
                        </div>
                        <div class="card-body p-2" style="max-height: 550px; overflow-y: auto;">
                            @if (!TodayBookings.Any())
                            {
                                <div class="text-center text-muted py-4"><i class="bi bi-emoji-smile fs-3 mb-2 d-block opacity-50"></i><p class="mb-0" style="font-size: 13px;">Пусто</p></div>
                            }
                            else
                            {
                                @foreach (var b in TodayBookings)
                                {
                                    <div class="mb-2 p-2" style="background: rgba(52,199,89,0.05); border: 1px solid rgba(52,199,89,0.2); border-radius: 10px; animation: fadeIn 0.3s ease;">
                                        <div class="d-flex justify-content-between align-items-start mb-1">
                                            <div>
                                                <span class="badge bg-light text-dark border me-1"><i class="bi bi-person-fill text-secondary"></i> @b.SenderName</span>
                                                <span class="text-muted" style="font-size: 10px;">@b.DateReceived.ToString("HH:mm")</span>
                                            </div>
                                            <button class="btn btn-sm btn-link text-warning p-0" title="Перенести на пізніше" @onclick="() => ToggleLater(b.Id)"><i class="bi bi-arrow-right-circle-fill fs-6"></i></button>
                                        </div>
                                        <div>
                                            <div class='booking-text @(expandedMsgs.Contains(b.Id) ? "expanded" : "")'>@b.Text</div>
                                            <button class="btn btn-link btn-sm p-0 text-primary mt-1 mb-2" style="font-size: 11px; text-decoration: none; font-weight: 600;" @onclick="() => ToggleMsg(b.Id)"><i class="bi @(expandedMsgs.Contains(b.Id) ? "bi-eye-slash" : "bi-eye") me-1"></i>@(expandedMsgs.Contains(b.Id) ? "Сховати" : "Розгорнути")</button>
                                        </div>

                                        @if (b.DeviceStockId != null)
                                        {
                                            var boundDev = availableDevices.FirstOrDefault(d => d.Id == b.DeviceStockId);
                                            <div class="d-flex justify-content-between align-items-center p-1 px-2 mb-2 rounded" style="background: rgba(0,113,227,0.08); border: 1px solid rgba(0,113,227,0.15);">
                                                <span style="font-size: 11px; font-weight: 600; color: var(--apple-blue); white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                                                    <i class="bi bi-phone"></i> @(boundDev?.ModelName ?? "Пристрій") @if(boundDev != null){
                                                    <span class="text-muted ms-1" style="font-size:9px;">@boundDev.Identifier</span>
                                                }
                                            </span>
                                            @if (b.AgreedPrice > 0)
                                            {
                                                <span style="font-size: 11px; font-weight: 700; color: var(--apple-text);">@b.AgreedPrice?.ToString("N0") ₴</span>
                                            }
                                        </div>
                                    }

                                    <div class="d-flex gap-2 mt-1">
                                        <button class="btn btn-outline-danger btn-sm" style="border-radius: 6px; padding: 4px 8px;" title="Скасувати бронювання" @onclick="() => CancelBooking(b.Id)"><i class="bi bi-x-lg"></i></button>

                                        @if (b.DeviceStockId != null)
                                        {
                                            <button class="btn btn-outline-primary btn-sm" style="border-radius: 6px; padding: 4px 8px;" title="Редагувати" @onclick="() => OpenBindModal(b)"><i class="bi bi-pencil-square"></i></button>
                                            @* 🔥 КНОПКА ПРОДАТИ *@
                                            <button class="btn btn-success btn-sm w-100 fw-bold" style="border-radius: 6px; font-size: 12px; padding: 4px;" @onclick='() => Nav.NavigateTo($"/sales?deviceId={b.DeviceStockId}")'><i class="bi bi-cart-plus"></i> Продати</button>
                                        }
                                        else
                                        {
                                            <button class="btn btn-outline-primary btn-sm w-100 fw-bold" style="border-radius: 6px; font-size: 12px; padding: 4px;" @onclick="() => OpenBindModal(b)"><i class="bi bi-link-45deg"></i> Прив'язати</button>
                                        }
                                        <button class="btn btn-outline-secondary btn-sm" style="border-radius: 6px; font-size: 12px; padding: 4px 10px;" title="Просто закрити без продажу" @onclick="() => MarkAsDone(b.Id)"><i class="bi bi-check2-all"></i></button>
                                    </div>
                                </div>
                            }
                                                        }
                        </div>
                    </div>
                </div>

                @* КОЛОНКА 2: ПІЗНІШЕ *@
                <div class="col-md-6 mb-4">
                    <div class="card shadow-sm border-0" style="border-radius: 14px; background: #fff;">
                        <div class="card-header bg-white border-0 pt-3 pb-2">
                            <h6 class="fw-bold mb-0 text-warning"><i class="bi bi-calendar-week me-2"></i>На ПІЗНІШЕ @if (LaterBookings.Any()) {
                            <span class="badge bg-warning ms-2 rounded-pill">@LaterBookings.Count</span>
                                                        }
                    </h6>
                        </div>
                        <div class="card-body p-2" style="max-height: 550px; overflow-y: auto;">
                            @if (!LaterBookings.Any())
                            {
                                <div class="text-center text-muted py-4"><i class="bi bi-inbox fs-3 mb-2 d-block opacity-50"></i><p class="mb-0" style="font-size: 13px;">Пусто</p></div>
                            }
                            else
                            {
                                @foreach (var b in LaterBookings)
                                {
                                    <div class="mb-2 p-2" style="background: rgba(255,149,0,0.05); border: 1px solid rgba(255,149,0,0.2); border-radius: 10px; animation: fadeIn 0.3s ease;">
                                        <div class="d-flex justify-content-between align-items-start mb-1">
                                            <button class="btn btn-sm btn-link text-success p-0" title="Перенести на сьогодні" @onclick="() => ToggleLater(b.Id)"><i class="bi bi-arrow-left-circle-fill fs-6"></i></button>
                                            <div class="text-end">
                                                <span class="text-muted" style="font-size: 10px;">@(b.TargetDate?.ToString("dd.MM") ?? b.DateReceived.ToString("dd.MM HH:mm"))</span>
                                                <span class="badge bg-light text-dark border ms-1"><i class="bi bi-person-fill text-secondary"></i> @b.SenderName</span>
                                            </div>
                                        </div>
                                        <div>
                                            <div class='booking-text @(expandedMsgs.Contains(b.Id) ? "expanded" : "")'>@b.Text</div>
                                            <button class="btn btn-link btn-sm p-0 text-primary mt-1 mb-2" style="font-size: 11px; text-decoration: none; font-weight: 600;" @onclick="() => ToggleMsg(b.Id)"><i class="bi @(expandedMsgs.Contains(b.Id) ? "bi-eye-slash" : "bi-eye") me-1"></i>@(expandedMsgs.Contains(b.Id) ? "Сховати" : "Розгорнути")</button>
                                        </div>

                                        @if (b.DeviceStockId != null)
                                        {
                                            var boundDev = availableDevices.FirstOrDefault(d => d.Id == b.DeviceStockId);
                                            <div class="d-flex justify-content-between align-items-center p-1 px-2 mb-2 rounded" style="background: rgba(0,113,227,0.08); border: 1px solid rgba(0,113,227,0.15);">
                                                <span style="font-size: 11px; font-weight: 600; color: var(--apple-blue); white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                                                    <i class="bi bi-phone"></i> @(boundDev?.ModelName ?? "Пристрій") @if(boundDev != null){
                                                    <span class="text-muted ms-1" style="font-size:9px;">@boundDev.Identifier</span>
                                                }
                                            </span>
                                            @if (b.AgreedPrice > 0)
                                            {
                                                <span style="font-size: 11px; font-weight: 700; color: var(--apple-text);">@b.AgreedPrice?.ToString("N0") ₴</span>
                                            }
                                        </div>
                                    }

                                    <div class="d-flex gap-2 mt-1">
                                        <button class="btn btn-outline-danger btn-sm" style="border-radius: 6px; padding: 4px 8px;" title="Скасувати бронювання" @onclick="() => CancelBooking(b.Id)"><i class="bi bi-x-lg"></i></button>

                                        @if (b.DeviceStockId != null)
                                        {
                                            <button class="btn btn-outline-primary btn-sm" style="border-radius: 6px; padding: 4px 8px;" title="Редагувати" @onclick="() => OpenBindModal(b)"><i class="bi bi-pencil-square"></i></button>
                                            @* 🔥 КНОПКА ПРОДАТИ *@
                                            <button class="btn btn-success btn-sm w-100 fw-bold" style="border-radius: 6px; font-size: 12px; padding: 4px;" @onclick='() => Nav.NavigateTo($"/sales?deviceId={b.DeviceStockId}")'><i class="bi bi-cart-plus"></i> Продати</button>
                                        }
                                        else
                                        {
                                            <button class="btn btn-outline-primary btn-sm w-100 fw-bold" style="border-radius: 6px; font-size: 12px; padding: 4px;" @onclick="() => OpenBindModal(b)"><i class="bi bi-link-45deg"></i> Прив'язати</button>
                                        }
                                        <button class="btn btn-outline-secondary btn-sm" style="border-radius: 6px; font-size: 12px; padding: 4px 10px;" title="Просто закрити без продажу" @onclick="() => MarkAsDone(b.Id)"><i class="bi bi-check2-all"></i></button>
                                    </div>
                                </div>
                            }
