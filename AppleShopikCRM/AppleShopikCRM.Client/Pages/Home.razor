</style>

@code {
    private List<TelegramBooking> allBookings = new();
    private HubConnection? hubConnection;
    private string deviceSearchQuery = "";
    private int? activeThreadFilter = null;
    private bool customerExistsInDb = false;
    private Dictionary<int, string> threadNames = new()
    {
        { 2, "Косів" },
        { 3, "Івано-Франківськ" },
        { 10, "Відправки" }
    };
    private Dictionary<int, int> storeToThreadMap = new()
    {
        { 1, 2 }, // Магазин 1 (Косів) -> Гілка 1
        { 2, 3 }  // Магазин 2 (Франківськ) -> Гілка 3
    };

    private List<TelegramBooking> TodayBookings => allBookings.Where(b => !b.IsLater && (activeThreadFilter == null || b.ThreadId == activeThreadFilter)).ToList();
    private List<TelegramBooking> LaterBookings => allBookings.Where(b => b.IsLater && (activeThreadFilter == null || b.ThreadId == activeThreadFilter)).ToList();
    private HashSet<int> expandedMsgs = new();

    private bool showBindModal = false;
    private bool isBinding = false;
    private TelegramBooking? bookingToBind;
    private BindDeviceDto bindData = new();
    private List<DeviceView> availableDevices = new();
    private int currentStoreId = 0;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var storeClaim = authState.User.FindFirst("StoreId");
            if (storeClaim != null && int.TryParse(storeClaim.Value, out int sId)) 
            {
                currentStoreId = sId;
                
                // 🔥 АВТОМАТИЧНИЙ ВИБІР ВКЛАДКИ
                if (storeToThreadMap.ContainsKey(currentStoreId))
                {
                    activeThreadFilter = storeToThreadMap[currentStoreId];
                }
            }
            try
            {
                var devs = await Http.GetFromJsonAsync<List<DeviceView>>("api/inventory/devices") ?? new();
                availableDevices = devs.Where(d => d.StoreId == currentStoreId).ToList();
            }
            catch { }

            allBookings = await Http.GetFromJsonAsync<List<TelegramBooking>>("api/telegram/active") ?? new();

            hubConnection = new HubConnectionBuilder()
                .WithUrl(Nav.ToAbsoluteUri("/chathub"))
                .WithAutomaticReconnect()
                .Build();

            hubConnection.On<TelegramBooking>("NewTelegramBooking", (booking) =>
            {
                allBookings.Insert(0, booking);
                InvokeAsync(StateHasChanged);
            });

            hubConnection.On<int>("BookingCompleted", (id) =>
            {
                var item = allBookings.FirstOrDefault(b => b.Id == id);
                if (item != null)
                {
                    allBookings.Remove(item);
                    InvokeAsync(StateHasChanged);
                }
            });

            hubConnection.On<TelegramBooking>("BookingToggled", (updatedBooking) =>
            {
                var item = allBookings.FirstOrDefault(b => b.Id == updatedBooking.Id);
                if (item != null)
                {
                    item.IsLater = updatedBooking.IsLater;
                    item.TargetDate = updatedBooking.TargetDate;
                    item.DeviceStockId = updatedBooking.DeviceStockId;
                    item.AgreedPrice = updatedBooking.AgreedPrice;
                    item.DepositAmount = updatedBooking.DepositAmount;
                    item.CustomerName = updatedBooking.CustomerName;
                    item.CustomerPhone = updatedBooking.CustomerPhone;
                    InvokeAsync(StateHasChanged);
                }
            });

            await hubConnection.StartAsync();
        }
        catch (Exception ex) { Console.WriteLine($"Помилка: {ex.Message}"); }
    }

    private void ToggleMsg(int id)
    {
        if (expandedMsgs.Contains(id)) expandedMsgs.Remove(id);
        else expandedMsgs.Add(id);
    }

    private string GetClientName(string text)
    {
        var phoneRegex = new Regex(@"(?:\+?380|0)[\s\-]?\d{2}[\s\-]?\d{3}[\s\-]?\d{2}[\s\-]?\d{2}");
        var match = phoneRegex.Match(text);

        if (!match.Success) return "Клієнт";

        string phone = match.Value;
        var lines = text.Split(new[] { '\r', '\n' }, StringSplitOptions.RemoveEmptyEntries);

        for (int i = 0; i < lines.Length; i++)
        {
            if (lines[i].Contains(phone))
            {
                string lineWithoutPhone = lines[i].Replace(phone, "").Trim(' ', '-', ':', ',', '.');
                if (Regex.IsMatch(lineWithoutPhone, @"[a-zA-Zа-яА-ЯіїєґІЇЄҐ]"))
                {
                    return lineWithoutPhone.Length > 30 ? lineWithoutPhone.Substring(0, 30) + "..." : lineWithoutPhone;
                }

                if (i > 0)
                {
                    string prevLine = lines[i - 1].Trim(' ', '-', ':', ',', '.');
                    if (Regex.IsMatch(prevLine, @"[a-zA-Zа-яА-ЯіїєґІЇЄҐ]") && !prevLine.ToLower().Contains("бронь"))
                    {
                        return prevLine.Length > 30 ? prevLine.Substring(0, 30) + "..." : prevLine;
                    }
                }

                if (i < lines.Length - 1)
                {
                    string nextLine = lines[i + 1].Trim(' ', '-', ':', ',', '.');
                    if (Regex.IsMatch(nextLine, @"[a-zA-Zа-яА-ЯіїєґІЇЄҐ]"))
                    {
                        return nextLine.Length > 30 ? nextLine.Substring(0, 30) + "..." : nextLine;
                    }
                }
                break;
            }
        }
        return "Клієнт";
    }

    private string GetClientPhone(string text)
    {
        var phoneRegex = new Regex(@"(?:\+?380|0)[\s\-]?\d{2}[\s\-]?\d{3}[\s\-]?\d{2}[\s\-]?\d{2}");
        var match = phoneRegex.Match(text);
        if (match.Success) return match.Value.Replace(" ", "").Replace("-", "");
        return "";
    }

    private void OpenBindModal(TelegramBooking booking)
    {
        bookingToBind = booking;
        bindData = new BindDeviceDto();
        deviceSearchQuery = "";
        bindData.DeviceStockId = booking.DeviceStockId ?? 0;
        bindData.AgreedPrice = booking.AgreedPrice ?? 0;
        bindData.DepositAmount = booking.DepositAmount ?? 0;
        bindData.CustomerName = !string.IsNullOrEmpty(booking.CustomerName) ? booking.CustomerName : GetClientName(booking.Text);
        bindData.CustomerPhone = !string.IsNullOrEmpty(booking.CustomerPhone) ? booking.CustomerPhone : GetClientPhone(booking.Text);
        if (!string.IsNullOrEmpty(bindData.CustomerPhone))
        {
            // Викликаємо вручну для ініціалізації
            _ = OnPhoneInput(new ChangeEventArgs { Value = bindData.CustomerPhone });
        }
        showBindModal = true;
    }
    private async Task OnPhoneInput(ChangeEventArgs e)
    {
        bindData.CustomerPhone = e.Value?.ToString() ?? "";
        customerExistsInDb = false; // Скидаємо перед перевіркою

        // Очищаємо номер для пошуку (тільки цифри)
        var cleanPhone = new string(bindData.CustomerPhone.Where(char.IsDigit).ToArray());

        if (cleanPhone.Length >= 10)
        {
            try
            {
                // Використовуємо ваш існуючий метод пошуку
                var response = await Http.GetAsync($"api/customers/by-phone?phone={Uri.EscapeDataString(cleanPhone)}");
                customerExistsInDb = response.IsSuccessStatusCode;

                // Якщо клієнт знайдений, можна також автоматично підтягнути його ім'я, якщо воно порожнє
                if (customerExistsInDb && string.IsNullOrWhiteSpace(bindData.CustomerName))
                {
                    var found = await response.Content.ReadFromJsonAsync<CustomerDto>();
                    if (found != null) bindData.CustomerName = found.Name;
                }
            }
            catch { /* ігноруємо помилки мережі */ }
        }
    }

    private void CloseBindModal() { showBindModal = false; bookingToBind = null; }

    private async Task SaveBinding()
    {
        if (bookingToBind == null) return;
        isBinding = true;
        StateHasChanged();

        try
        {
            var res = await Http.PostAsJsonAsync($"api/telegram/bind-device/{bookingToBind.Id}", bindData);
            if (res.IsSuccessStatusCode) CloseBindModal();
        }
        finally { isBinding = false; StateHasChanged(); }
    }

    private async Task UnbindDevice()
    {
        bindData.DeviceStockId = 0;
        await SaveBinding();
    }

    private async Task CancelBooking(int id)
    {
        if (!await JS.InvokeAsync<bool>("confirm", "Ви впевнені, що хочете скасувати це замовлення? Бронь буде видалено, а телефон відв'язано автоматично.")) return;

        try
        {
            var res = await Http.PostAsync($"api/telegram/cancel/{id}", null);
            if (res.IsSuccessStatusCode)
            {
                var item = allBookings.FirstOrDefault(b => b.Id == id);
                if (item != null) allBookings.Remove(item);
            }
        }
        catch { }
    }

    private async Task MarkAsDone(int id)
    {
        try
        {
            var res = await Http.PostAsync($"api/telegram/complete/{id}", null);
            if (res.IsSuccessStatusCode)
            {
                var item = allBookings.FirstOrDefault(b => b.Id == id);
                if (item != null) allBookings.Remove(item);
            }
        }
        catch { }
    }

    private async Task ToggleLater(int id) { try { await Http.PostAsync($"api/telegram/toggle-later/{id}", null); } catch { } }

    public async ValueTask DisposeAsync() { if (hubConnection is not null) await hubConnection.DisposeAsync(); }

    class TelegramBooking
    {
        public int Id { get; set; }
        public int? ThreadId { get; set; }
        public string SenderName { get; set; } = "";
        public string Text { get; set; } = "";
        public DateTime DateReceived { get; set; }
        public DateTime? TargetDate { get; set; }
        public bool IsLater { get; set; }
        public int? DeviceStockId { get; set; }
        public decimal? AgreedPrice { get; set; }
        public decimal? DepositAmount { get; set; }
        public string? CustomerName { get; set; }
        public string? CustomerPhone { get; set; }
    }

    class BindDeviceDto
    {
        public int? DeviceStockId { get; set; }
        public decimal? AgreedPrice { get; set; }
        public decimal? DepositAmount { get; set; }
        public string CustomerPhone { get; set; } = "";
        public string CustomerName { get; set; } = "";
    }
